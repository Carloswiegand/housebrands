        <span class="bdg ${m==='MemoKoala'?'b-mk':'b-mt'}">${m==='MemoKoala'?'🐨':'🔪'} ${m}</span>
        <span style="font-family:var(--serif);font-size:20px;color:${bc[m]}">${pct(p)}</span>
      </div>
      <div style="height:5px;background:var(--cream-dark);border-radius:3px;overflow:hidden">
        <div style="height:100%;width:${Math.min(100,p*100).toFixed(1)}%;background:${bc[m]};border-radius:3px;transition:width .7s"></div>
      </div>
      <div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);margin-top:5px">${clp(v.vb)} bruto · ${clp(v.mb)} margen</div>
    </div>`;
  }).join('');
}

function renderProdBars(d) {
  const p={};
  d.forEach(r=>{if(!p[r.sku])p[r.sku]={nom:r.prod,vb:0,marca:r.marca};p[r.sku].vb+=r.vb;});
  const sorted=Object.entries(p).sort((a,b)=>b[1].vb-a[1].vb).slice(0,9);
