// ── KPIs ─────────────────────────────────────────────────
function rKPIs(d){
  const vb=sum(d,'vb'), mb=sum(d,'mb'), icn=sum(d,'icn');
  const comision=sum(d,'comision');
  const un=d.reduce((s,r)=>s+r.qty,0), cnt=d.length;
  const tk=un>0?vb/un:0, mrg=vb>0?mb/vb:0;
  const meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses, gap=avg/META_MES-1;
  const mrgCls=mrg>=.65?'pos':mrg>=.45?'warn':'neg';

  // Sparkline por mes (últimos 8 meses en los datos filtrados)
  const byM={};
  d.forEach(r=>{const k=r.anio+'-'+String(r.mes).padStart(2,'0');byM[k]=(byM[k]||0)+r.vb;});
  const spk=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0])).slice(-8).map(([,v])=>v);
  const spkMax=Math.max(...spk,1);
  const spark=(color)=>spk.map(v=>`<div class="ksbar" style="height:${Math.max(8,(v/spkMax)*100)}%;background:${color}"></div>`).join('');

  document.getElementById('kgrid').innerHTML=[
    {lbl:'VENTA BRUTA', num:clp(vb), sub:cnt+' órdenes · '+un+' uds',
     delta:gap>=0?{cls:'d-pos',txt:'↑ +'+Math.abs(gap*100).toFixed(1)+'% vs meta'}:{cls:'d-neg',txt:'↓ '+Math.abs(gap*100).toFixed(1)+'% vs meta'},
     spk:'var(--sh)'},
    {lbl:'INGRESO NETO COM.', num:clp(icn), sub:'venta − comisión pasarela',
     delta:{cls:'d-neu',txt:(vb>0?(comision/vb*100).toFixed(1):0)+'% de comisiones'},
     spk:'var(--txt3)'},
    {lbl:'MARGEN BRUTO', num:(mrg*100).toFixed(1)+'%', numCls:mrgCls, sub:clp(mb)+' · pvp − costo×1.19',
     delta:mrg>=.65?{cls:'d-pos',txt:'Saludable'}:mrg>=.45?{cls:'d-neu',txt:'OK'}:{cls:'d-neg',txt:'Revisar'},
     spk:'var(--pos)'},
    {lbl:'TICKET PROMEDIO', num:clp(tk), sub:'por unidad vendida',
     delta:{cls:'d-neu',txt:meses+' mes'+(meses>1?'es':'')},
     spk:'var(--txt3)'},
  ].map(k=>`
    <div class="kblock">
      <div class="klbl">${k.lbl}</div>
      <div class="knum${k.numCls?' '+k.numCls:''}">${k.num}</div>
      <div class="ksub">${k.sub}</div>
      <div class="kdelta ${k.delta.cls}">${k.delta.txt}</div>
      <div class="kspark">${spark(k.spk)}</div>
    </div>`).join('');
}

// ── BARRAS ───────────────────────────────────────────────
function rBars(d){
  const byM={};
  d.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k])byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;
  });
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('mbars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt,h=Math.max(3,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2,hmt=h-hmk;
    return `<div class="mbc"><div class="mbw">
      <div class="mbs" style="height:${hmt}px;background:var(--mt);opacity:0.6;border-radius:2px 2px 0 0" title="${v.lbl}: ${clp(tot)}"></div>
      <div class="mbs" style="height:${hmk}px;background:var(--mk)" title="${v.lbl}: ${clp(tot)}"></div>
    </div><div class="mbl">${v.lbl}</div></div>`;
  }).join('');
  document.getElementById('mleg').innerHTML=`
    <div class="legi"><div class="legd" style="background:var(--mk)"></div>MemoKoala</div>
    <div class="legi"><div class="legd" style="background:var(--mt);opacity:0.6"></div>Montana</div>`;
}

// ── CANAL ────────────────────────────────────────────────
function rCanal(d){
  const ch={};
  d.forEach(r=>{
    if(!ch[r.canal])ch[r.canal]={vb:0,mb:0,comision:0,envio:0,descto:0};
