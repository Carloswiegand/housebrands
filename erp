<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Housebrands · ERP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --cream:#f5f2ec;--cream-dark:#ede9e0;--ink:#1a1714;--ink-mid:#4a4540;
  --ink-light:#8a8478;--ink-dim:#c0b8ac;
  --mk:#3d7a62;--mk-light:#eaf4ef;--mk-mid:#a8d0bc;
  --mt:#b85a2a;--mt-light:#f7ede6;--mt-mid:#e0a882;
  --gold:#c9a227;--gold-light:#fdf6e3;
  --red:#c0392b;--red-light:#fdecea;
  --green:#27a05a;--green-light:#e8f8ee;
  --border:#ddd8cf;--shadow:0 1px 3px rgba(26,23,20,.06),0 4px 16px rgba(26,23,20,.04);
  --serif:'DM Serif Display',serif;--mono:'DM Mono',monospace;--sans:'Outfit',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--ink);font-family:var(--sans);font-size:14px;min-height:100vh}

/* LOGIN */
#login-screen{position:fixed;inset:0;z-index:1000;background:var(--ink);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:32px}
.login-logo{font-family:var(--serif);font-size:36px;color:#fff;letter-spacing:-.5px;text-align:center;line-height:1.1}
.login-logo span{color:var(--mk-mid)}
.login-sub{font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.35);letter-spacing:2px;text-transform:uppercase}
.login-box{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:32px;width:320px;display:flex;flex-direction:column;gap:14px}
.login-box label{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px}
.login-box input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:10px 14px;color:#fff;font-family:var(--mono);font-size:13px;outline:none;transition:border .2s;width:100%}
.login-box input:focus{border-color:rgba(255,255,255,.3)}
.login-btn{background:var(--mk);color:#fff;border:none;border-radius:8px;padding:11px;font-family:var(--mono);font-size:12px;font-weight:500;cursor:pointer;transition:opacity .15s;margin-top:4px}
.login-btn:hover{opacity:.85}
.login-err{font-family:var(--mono);font-size:11px;color:#ff6b6b;text-align:center;display:none}

/* APP */
#app{display:none}

/* HEADER */
.header{background:var(--ink);padding:0 32px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.header-logo{font-family:var(--serif);font-size:20px;color:#fff;letter-spacing:-.3px;display:flex;align-items:center;gap:10px}
.header-logo-dot{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--mk),var(--mt))}
.header-right{display:flex;align-items:center;gap:20px}
.header-updated{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.3)}
.header-btn{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.4);cursor:pointer;padding:4px 10px;border:1px solid rgba(255,255,255,.1);border-radius:4px;transition:all .15s;background:transparent}
.header-btn:hover{color:#fff;border-color:rgba(255,255,255,.3)}

/* TABS */
.tabs{background:var(--ink);border-bottom:1px solid rgba(255,255,255,.08);padding:0 32px;display:flex;gap:0}
.tab{font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.4);padding:10px 20px;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s;letter-spacing:.5px;text-transform:uppercase}
.tab:hover{color:rgba(255,255,255,.7)}
.tab.active{color:#fff;border-bottom-color:var(--mk)}

/* FILTERS */
.filters{background:#fff;border-bottom:1px solid var(--border);padding:12px 32px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.filter-sep{width:1px;height:18px;background:var(--border);margin:0 4px}
.pill{font-family:var(--mono);font-size:10px;padding:4px 12px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--ink-light);cursor:pointer;transition:all .15s;letter-spacing:.3px}
.pill:hover{border-color:var(--ink-dim);color:var(--ink)}
.pill.on{background:var(--ink);border-color:var(--ink);color:#fff}
.pill.mk{background:var(--mk-light);border-color:var(--mk-mid);color:var(--mk)}
.pill.mt{background:var(--mt-light);border-color:var(--mt-mid);color:var(--mt)}

/* MAIN */
.main{padding:24px 32px;max-width:1480px;margin:0 auto}

/* LOADING */
.loading{text-align:center;padding:80px 0;font-family:var(--mono);font-size:12px;color:var(--ink-light)}
.loading-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--mk);margin:0 3px;animation:pulse 1.2s ease-in-out infinite}
.loading-dot:nth-child(2){animation-delay:.2s}
.loading-dot:nth-child(3){animation-delay:.4s}
@keyframes pulse{0%,80%,100%{transform:scale(0);opacity:.3}40%{transform:scale(1);opacity:1}}

/* KPI GRID */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:20px}
.kpi{background:#fff;border:1px solid var(--border);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow);transition:transform .2s;position:relative;overflow:hidden}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent,var(--border))}
.kpi:hover{transform:translateY(-2px)}
.kpi-label{font-family:var(--mono);font-size:9px;color:var(--ink-light);text-transform:uppercase;letter-spacing:1.2px;margin-bottom:8px}
.kpi-val{font-family:var(--serif);font-size:24px;color:var(--ink);line-height:1;margin-bottom:4px}
.kpi-sub{font-family:var(--mono);font-size:10px;color:var(--ink-light)}
.kpi-tag{display:inline-block;font-family:var(--mono);font-size:9px;padding:2px 7px;border-radius:10px;margin-top:6px}
.tag-up{background:var(--green-light);color:var(--green)}
.tag-dn{background:var(--red-light);color:var(--red)}
.tag-n{background:var(--cream-dark);color:var(--ink-light)}

/* GRID */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.g3{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px;margin-bottom:16px}

/* CARD */
.card{background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:14px 18px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1.2px;color:var(--ink-light)}
.card-body{padding:16px 18px}

/* BARS */
.month-bars{display:flex;align-items:flex-end;gap:5px;height:110px}
.mbar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px}
.mbar-wrap{flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%}
.mbar{border-radius:3px 3px 0 0;width:100%;min-height:2px;cursor:pointer;position:relative;transition:opacity .15s}
.mbar:hover{opacity:.8}
.mbar:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 5px);left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:4px 8px;border-radius:5px;font-family:var(--mono);font-size:10px;white-space:nowrap;z-index:10;pointer-events:none}
.mbar-lbl{font-family:var(--mono);font-size:8px;color:var(--ink-dim)}

.hbar-chart{display:flex;flex-direction:column;gap:9px}
.hbar-row{display:flex;align-items:center;gap:10px}
.hbar-lbl{font-family:var(--mono);font-size:10px;color:var(--ink-light);width:120px;text-align:right;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hbar-track{flex:1;height:6px;background:var(--cream-dark);border-radius:3px;overflow:hidden}
.hbar-fill{height:100%;border-radius:3px;transition:width .7s cubic-bezier(.34,1.56,.64,1)}
.hbar-val{font-family:var(--mono);font-size:10px;color:var(--ink);width:80px;text-align:right;flex-shrink:0}

.split-bar{height:8px;border-radius:4px;overflow:hidden;display:flex;margin-bottom:12px}

/* TABLE */
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead th{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--ink-light);border-bottom:1px solid var(--border);white-space:nowrap}
thead th:first-child{text-align:left}
tbody tr{border-bottom:1px solid var(--cream-dark);transition:background .1s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:var(--cream)}
tbody td{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--ink)}
tbody td:first-child{text-align:left;color:var(--ink-mid)}
.bdg{display:inline-block;font-size:9px;padding:1px 6px;border-radius:8px;font-family:var(--mono)}
.b-mk{background:var(--mk-light);color:var(--mk)}
.b-mt{background:var(--mt-light);color:var(--mt)}
.b-sh{background:var(--green-light);color:var(--green)}
.b-ml{background:var(--gold-light);color:var(--gold)}
.mrg-bar{display:flex;align-items:center;gap:5px;justify-content:flex-end}
.mrg-mini{width:32px;height:3px;background:var(--cream-dark);border-radius:2px;overflow:hidden}
.mrg-fill{height:100%;border-radius:2px}

/* LEGEND */
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px}
.leg{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:9px;color:var(--ink-light)}
.leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}

/* PNL SPECIFIC */
.pnl-section{margin-bottom:20px}
.pnl-section-title{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:#fff;padding:8px 14px;border-radius:6px;margin-bottom:10px;display:inline-block}
.pnl-row{display:grid;gap:0}
.pnl-month-header{display:flex;overflow-x:auto;margin-bottom:2px}
.pnl-concept{font-family:var(--mono);font-size:10px;padding:6px 12px;color:var(--ink-mid);white-space:nowrap;min-width:220px;flex-shrink:0}
.pnl-cell{font-family:var(--mono);font-size:10px;padding:6px 8px;text-align:right;min-width:90px;flex-shrink:0;white-space:nowrap}
.pnl-total-cell{font-family:var(--mono);font-size:10px;padding:6px 8px;text-align:right;min-width:110px;flex-shrink:0;background:var(--cream-dark);font-weight:600;white-space:nowrap}
.pnl-header-row{display:flex;border-bottom:2px solid var(--border)}
.pnl-header-cell{font-family:var(--mono);font-size:9px;padding:6px 8px;text-align:right;min-width:90px;flex-shrink:0;color:var(--ink-light);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
.pnl-header-concept{font-family:var(--mono);font-size:9px;padding:6px 12px;color:var(--ink-light);text-transform:uppercase;letter-spacing:.5px;min-width:220px;flex-shrink:0}
.pnl-header-total{font-family:var(--mono);font-size:9px;padding:6px 8px;text-align:right;min-width:110px;flex-shrink:0;color:var(--ink-light);text-transform:uppercase;letter-spacing:.5px;background:var(--cream-dark);white-space:nowrap}
.pnl-data-row{display:flex;border-bottom:1px solid var(--cream-dark);transition:background .1s}
.pnl-data-row:hover{background:var(--cream)}
.pnl-data-row.bold .pnl-concept,.pnl-data-row.bold .pnl-cell,.pnl-data-row.bold .pnl-total-cell{font-weight:700;color:var(--ink)}
.pnl-subhdr{display:flex;background:var(--ink)}
.pnl-subhdr-txt{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.7);padding:6px 12px;min-width:220px;flex-shrink:0}

/* RESULTADO */
.resultado-pos{color:var(--green)!important;font-weight:700!important}
.resultado-neg{color:var(--red)!important;font-weight:700!important}

/* CANAL×MARCA TABLE */
.canal-marca-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.fade-up{animation:fadeUp .5s ease forwards;opacity:0}
.fade-up:nth-child(1){animation-delay:.05s}
.fade-up:nth-child(2){animation-delay:.1s}
.fade-up:nth-child(3){animation-delay:.15s}
.fade-up:nth-child(4){animation-delay:.2s}
.fade-up:nth-child(5){animation-delay:.25s}
.fade-up:nth-child(6){animation-delay:.3s}

/* RESPONSIVE */
@media(max-width:900px){
  .g2,.g3{grid-template-columns:1fr}
  .main,.filters,.header,.tabs{padding-left:16px;padding-right:16px}
  .kpi-grid{grid-template-columns:repeat(2,1fr)}
  .canal-marca-grid{grid-template-columns:1fr}
}
@media(max-width:480px){
  .kpi-grid{grid-template-columns:1fr 1fr}
  .kpi-val{font-size:19px}
}

/* CHECKLIST */
.cl-item{display:flex;gap:12px;align-items:flex-start;padding:9px 10px;border-radius:8px;cursor:pointer;transition:background .1s;margin-bottom:3px}
.cl-item:hover{background:var(--cream-dark)}
.cl-cb{width:18px;height:18px;border:1.5px solid var(--border);border-radius:4px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cl-item.done .cl-cb{background:var(--mk);border-color:var(--mk)}
.cl-item.done .cl-cb::after{content:'✓';color:#fff;font-size:10px;font-weight:700}
.cl-item.done .cl-label{text-decoration:line-through;color:var(--ink-light)}
.cl-label{font-size:13px;font-weight:500;color:var(--ink);margin-bottom:2px}
.cl-sub{font-size:11px;color:var(--ink-light);font-family:var(--mono);line-height:1.5}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div>
    <div class="login-logo">House<span>brands</span></div>
    <div class="login-sub" style="text-align:center;margin-top:6px">ERP · Inversiones Rupanco SpA</div>
  </div>
  <div class="login-box">
    <div>
      <label>Contraseña</label>
      <input type="password" id="pwd-input" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="login-btn" onclick="checkLogin()">Entrar →</button>
    <div class="login-err" id="login-err">Contraseña incorrecta</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <div class="header">
    <div class="header-logo">
      <div class="header-logo-dot"></div>
      Housebrands ERP
    </div>
    <div class="header-right">
      <div class="header-updated" id="updated-label">Cargando...</div>
      <button class="header-btn" onclick="showChecklist()" style="color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.2)">☑ Checklist</button>
      <button class="header-btn" onclick="logout()">Salir</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" id="tab-ventas" onclick="switchTab('ventas')">📊 Ventas</div>
    <div class="tab" id="tab-pnl" onclick="switchTab('pnl')">💰 P&amp;L</div>
  </div>

  <!-- TAB VENTAS -->
  <div id="view-ventas">
    <div class="filters">
      <button class="pill on" id="fa"   onclick="sf('m','Todas',this)">Todas</button>
      <button class="pill"    id="fmk"  onclick="sf('m','MemoKoala',this)">🐨 MemoKoala</button>
      <button class="pill"    id="fmt"  onclick="sf('m','Montana',this)">🔪 Montana</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fca"  onclick="sf('c','Todos',this)">Todos canales</button>
      <button class="pill"    id="fsh"  onclick="sf('c','Shopify',this)">Shopify</button>
      <button class="pill"    id="fml"  onclick="sf('c','ML',this)">MercadoLibre</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fya"  onclick="sf('y',0,this)">Todos los años</button>
      <button class="pill"    id="fy25" onclick="sf('y',2025,this)">2025</button>
      <button class="pill"    id="fy26" onclick="sf('y',2026,this)">2026</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fma"  onclick="sf('me',0,this)">Todo</button>
      <button class="pill" id="fm1"  onclick="sf('me',1,this)">Ene</button>
      <button class="pill" id="fm2"  onclick="sf('me',2,this)">Feb</button>
      <button class="pill" id="fm3"  onclick="sf('me',3,this)">Mar</button>
      <button class="pill" id="fm4"  onclick="sf('me',4,this)">Abr</button>
      <button class="pill" id="fm5"  onclick="sf('me',5,this)">May</button>
      <button class="pill" id="fm6"  onclick="sf('me',6,this)">Jun</button>
      <button class="pill" id="fm7"  onclick="sf('me',7,this)">Jul</button>
      <button class="pill" id="fm8"  onclick="sf('me',8,this)">Ago</button>
      <button class="pill" id="fm9"  onclick="sf('me',9,this)">Sep</button>
      <button class="pill" id="fm10" onclick="sf('me',10,this)">Oct</button>
      <button class="pill" id="fm11" onclick="sf('me',11,this)">Nov</button>
      <button class="pill" id="fm12" onclick="sf('me',12,this)">Dic</button>
    </div>

    <div class="main">
      <div id="loading-ventas" class="loading">
        <div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div>
        <div style="margin-top:16px">Cargando ventas...</div>
      </div>
      <div id="dash-ventas" style="display:none">
        <div class="kpi-grid" id="kpi-grid"></div>
        <div class="g3">
          <div class="card">
            <div class="card-head"><span class="card-title">Venta Bruta Mensual</span></div>
            <div class="card-body">
              <div class="month-bars" id="month-bars"></div>
              <div class="legend" id="month-legend"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Canal de Venta</span></div>
            <div class="card-body">
              <div class="split-bar" id="canal-split"></div>
              <div id="canal-detail" style="display:flex;flex-direction:column;gap:8px"></div>
              <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--cream-dark)" id="canal-margin"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Margen por Marca</span></div>
            <div class="card-body" id="marca-margen"></div>
          </div>
        </div>
        <div class="g2">
          <div class="card">
            <div class="card-head"><span class="card-title">Top Productos · Venta Bruta</span></div>
            <div class="card-body"><div class="hbar-chart" id="prod-bars"></div></div>
          </div>
          <div class="card">
            <div class="card-head">
              <span class="card-title">Últimas Ventas</span>
              <span style="font-family:var(--mono);font-size:9px;color:var(--ink-dim)" id="tx-count"></span>
            </div>
            <div class="tbl-wrap">
              <table><thead><tr>
                <th>Fecha</th><th>Marca</th><th>Canal</th><th>Producto</th><th>Bruto</th><th>Mrg%</th>
              </tr></thead>
              <tbody id="recent-tx"></tbody></table>
            </div>
          </div>
        </div>
        <div class="card" style="margin-bottom:16px">
          <div class="card-head"><span class="card-title">Resumen por SKU</span></div>
          <div class="tbl-wrap">
            <table><thead><tr>
              <th>SKU</th><th>Producto</th><th>Marca</th><th>Und.</th>
              <th>Venta Bruta</th><th>Costo Total</th><th>Margen $</th><th>Margen %</th>
            </tr></thead>
            <tbody id="sku-table"></tbody></table>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /view-ventas -->

  <!-- TAB P&L -->
  <div id="view-pnl" style="display:none">
    <div class="main">
      <div id="loading-pnl" class="loading">
        <div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div>
        <div style="margin-top:16px">Cargando P&L...</div>
      </div>
      <div id="dash-pnl" style="display:none">

        <!-- KPIs P&L -->
        <div class="kpi-grid" id="pnl-kpi-grid"></div>

        <!-- Gráfico resultado mensual + breakdown gastos -->
        <div class="g2" style="margin-bottom:16px">
          <div class="card">
            <div class="card-head"><span class="card-title">Resultado Neto Mensual</span></div>
            <div class="card-body">
              <div class="month-bars" id="pnl-result-bars" style="height:120px"></div>
              <div class="legend" style="margin-top:10px">
                <div class="leg"><div class="leg-dot" style="background:var(--green)"></div>Positivo</div>
                <div class="leg"><div class="leg-dot" style="background:var(--red)"></div>Negativo</div>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Breakdown de Gastos (Total)</span></div>
            <div class="card-body"><div class="hbar-chart" id="gasto-bars"></div></div>
          </div>
