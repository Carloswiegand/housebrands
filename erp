  }
}

function parsePnL(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<3) return{meses:[],rows:[]};
  let hi=-1;
  for(let i=0;i<Math.min(lines.length,6);i++){if(lines[i].toUpperCase().includes('CONCEPTO')){hi=i;break;}}
  if(hi===-1)hi=2;
  const hc=scsv(lines[hi]).slice(2).map(m=>m.trim()).filter(m=>m);
  const meses=hc.slice(0,-1);
  const rows=[];
  for(let i=hi+1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<3)continue;
    const concepto=fenc(c[0]?.trim()||'');
    const cat=fenc(c[1]?.trim()||'');
    if(!concepto)continue;
    const av=c.slice(2);
    const mv=av.slice(0,-1).map(v=>ppnl(v));
    const tv=ppnl(av[av.length-1]||'0');
    while(mv.length<meses.length)mv.push(0);
    rows.push({concepto,cat,mv,tv});
  }
  return{meses,rows};
}

function fenc(s){
  return s.replace(/â–¶/g,'▶').replace(/â€"/g,'—').replace(/Ã©/g,'é')
    .replace(/Ã³/g,'ó').replace(/Ã­/g,'í').replace(/Ã¡/g,'á')
    .replace(/Ã±/g,'ñ').replace(/Ã"/g,'Ó').replace(/Ã‰/g,'É');
}
function ppnl(v){
  if(v===null||v===undefined||v==='')return 0;
  const s=String(v).trim();
  if(s.endsWith('%'))return parseFloat(s.replace('%','').replace(',','.'))||0;
  let n=s.replace(/[$\s"]/g,'');
  if(!n)return 0;
  const dots=(n.match(/\./g)||[]).length,commas=(n.match(/,/g)||[]).length;
  if(commas>=1&&dots===0)n=n.replace(/,/g,'');
  else if(commas===1&&dots===1)n=n.replace(',','');
  else if(commas===0&&dots>1)n=n.replace(/\./g,'');
  return parseFloat(n)||0;
}

function getPeriodIdx(){
  const{meses}=PNL;if(!meses.length)return{idxs:[],labels:[]};
  const ord=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  if(pnlPeriod==='corrido'){
    const idx=meses.map((m,i)=>({m,i})).sort((a,b)=>{
      const ya=parseInt('20'+a.m.slice(-2)),yb=parseInt('20'+b.m.slice(-2));
      if(ya!==yb)return ya-yb;
      return ord.indexOf(a.m.slice(0,3).toLowerCase())-ord.indexOf(b.m.slice(0,3).toLowerCase());
    }).slice(-12);
    return{idxs:idx.map(x=>x.i),labels:idx.map(x=>x.m)};
  }
  const idxs=[],labels=[],ys=pnlPeriod.slice(2);
  meses.forEach((m,i)=>{if(m.slice(-2)===ys){idxs.push(i);labels.push(m);}});
  return{idxs,labels};
}

function buildPeriods(){
  const years=[...new Set(PNL.meses.map(m=>m.slice(-2)))].sort();
  const opts=[{id:'corrido',lbl:'Últimos 12 meses'},...years.map(y=>({id:'20'+y,lbl:'20'+y}))];
  document.getElementById('pnl-periods').innerHTML='<span class="flbl">Período</span>'+
    opts.map(p=>`<button class="ppill${p.id===pnlPeriod?' on':''}" onclick="setPer('${p.id}',this)">${p.lbl}</button>`).join('');
}

function setPer(id,el){
  pnlPeriod=id;
  document.querySelectorAll('.ppill').forEach(p=>p.classList.remove('on'));
  el.classList.add('on');renderPnL();
}

function renderPnL(){
  const{rows}=PNL;if(!rows.length)return;
  const{idxs,labels}=getPeriodIdx();
  const fr=term=>rows.find(r=>r.concepto.toUpperCase().includes(term.toUpperCase()));
  const ps=row=>{if(!row)return 0;return idxs.reduce((s,i)=>s+(row.mv[i]||0),0);};
  const pv=row=>{if(!row)return idxs.map(()=>0);return idxs.map(i=>row.mv[i]||0);};
  const vbT=fr('VENTA BRUTA TOTAL'),mbT=fr('MARGEN BRUTO TOTAL');
  const logN=fr('TOTAL LOG'),mktT=fr('TOTAL MARKETING');
  const techT=fr('TOTAL TECH'),admT=fr('TOTAL ADMINISTRACI');
  const res=fr('RESULTADO NETO');
  const vbS=ps(vbT),mbS=ps(mbT),resS=ps(res);
  const mrgP=vbS>0?mbS/vbS:0;
  const gastS=ps(logN)+ps(mktT)+ps(techT)+ps(admT);
  const mPos=res?pv(res).filter(v=>v>0).length:0;

  document.getElementById('pnl-kgrid').innerHTML=[
    {lbl:'VENTA BRUTA',num:clp(vbS),sub:labels.length+' meses',spk:'var(--sh)',delta:{cls:'d-neu',txt:labels.length+' meses'}},
    {lbl:'MARGEN BRUTO',num:(mrgP*100).toFixed(1)+'%',numCls:mrgP>=.65?'pos':mrgP>=.45?'warn':'neg',sub:clp(mbS),spk:'var(--pos)',delta:mrgP>=.65?{cls:'d-pos',txt:'Saludable'}:{cls:'d-neg',txt:'Revisar'}},
    {lbl:'RESULTADO NETO',num:clp(resS),numCls:resS>=0?'pos':'neg',sub:'período completo',spk:resS>=0?'var(--pos)':'var(--neg)',delta:resS>=0?{cls:'d-pos',txt:'Positivo'}:{cls:'d-neg',txt:'Negativo'}},
    {lbl:'MESES POSITIVOS',num:mPos+'/'+labels.length,sub:'con resultado >0',spk:'var(--txt3)',delta:{cls:'d-neu',txt:'vs meta período'}},
  ].map(k=>{
    const spkd=pv(res||vbT);
    const spkMax=Math.max(...spkd.map(v=>Math.abs(v)),1);
    const sc=spkd.map(v=>`<div class="ksbar" style="height:${Math.max(8,(Math.abs(v)/spkMax)*100)}%;background:${k.spk}"></div>`).join('');
    return `<div class="kblock">
      <div class="klbl">${k.lbl}</div>
      <div class="knum${k.numCls?' '+k.numCls:''}">${k.num}</div>
      <div class="ksub">${k.sub}</div>
      <div class="kdelta ${k.delta.cls}">${k.delta.txt}</div>
      <div class="kspark">${sc}</div>
    </div>`;
  }).join('');

  // Barras resultado neto
  if(res){
    const vals=pv(res),ma=Math.max(...vals.map(v=>Math.abs(v)),1);
    document.getElementById('pnl-bars').innerHTML=vals.map((v,i)=>{
      const h=Math.max(3,(Math.abs(v)/ma)*90);
      return `<div class="mbc"><div class="mbw">
        <div class="mbs" style="height:${h}px;background:${v>=0?'var(--pos)':'var(--neg)'};opacity:.8;border-radius:2px 2px 0 0" title="${labels[i]}: ${clp(v)}"></div>
      </div><div class="mbl">${(labels[i]||'').slice(0,6)}</div></div>`;
    }).join('');
  }

  // Breakdown gastos
  const gRows=[
    {lbl:'Logístico neto',row:logN,c:'var(--mt)'},
    {lbl:'Marketing',row:mktT,c:'var(--sh)'},
    {lbl:'Tech & Software',row:techT,c:'var(--txt2)'},
    {lbl:'Administración',row:admT,c:'var(--txt3)'},
  ];
  const maxG=Math.max(...gRows.map(g=>ps(g.row)),1);
  document.getElementById('gasto-bars').innerHTML=gRows.map(g=>`
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
      <div style="font-family:var(--mono);font-size:10px;color:var(--txt3);width:120px;text-align:right;flex-shrink:0">${g.lbl}</div>
      <div style="flex:1;height:4px;background:var(--bg3);border-radius:2px;overflow:hidden">
        <div style="height:100%;width:${(ps(g.row)/maxG*100).toFixed(1)}%;background:${g.c};border-radius:2px"></div>
      </div>
      <div style="font-family:var(--mono);font-size:10px;color:var(--txt);width:90px;text-align:right;flex-shrink:0">${clp(ps(g.row))}</div>
    </div>`).join('');

  // Canal por marca
  const rCM=(shT,mlT,cid)=>{
    const ff=t=>{const tl=t.toLowerCase().replace(/[×x]/g,'.');return rows.find(r=>r.concepto.toLowerCase().replace(/[×x]/g,'.').includes(tl));};
    const channels=[{lbl:'Shopify',row:ff(shT),c:'var(--sh)'},{lbl:'ML',row:ff(mlT),c:'var(--ml)'}];
    document.getElementById(cid).innerHTML=channels.map(ch=>{
      if(!ch.row)return'';
      const vals=pv(ch.row).filter(v=>v!==0);
      const avg=vals.length?vals.reduce((s,v)=>s+v,0)/vals.length:0;
      const mc=avg>=65?'var(--pos)':avg>=45?'var(--warn)':'var(--neg)';
      return `<div style="margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
          <span class="bdg ${ch.lbl==='Shopify'?'b-sh':'b-ml'}">${ch.lbl}</span>
          <span style="font-size:28px;font-weight:500;letter-spacing:-0.04em;color:${mc}">${avg.toFixed(1)}%</span>
        </div>
        <div style="height:3px;background:var(--bg3);border-radius:2px;overflow:hidden">
          <div style="height:100%;width:${Math.min(100,avg).toFixed(1)}%;background:${ch.c};border-radius:2px"></div>
        </div>
        <div style="font-family:var(--mono);font-size:9px;color:var(--txt3);margin-top:4px">prom. ${vals.length} mes${vals.length!==1?'es':''}</div>
      </div>`;
    }).join('');
  };
  rCM('% Margen MemoKoala × Shopify','% Margen MemoKoala × MercadoLibre','pnl-mk-canal');
  rCM('% Margen Montana × Shopify','% Margen Montana × MercadoLibre','pnl-mt-canal');

  // Mix canal
  const vbMK=fr('Venta MemoKoala × Shopify'),vbML=fr('Venta MemoKoala × MercadoLibre');
  const mtSH=fr('Venta Montana × Shopify'),mtML=fr('Venta Montana × MercadoLibre');
  const mixRows=[
    {lbl:'MK × Shopify',v:ps(vbMK),c:'var(--mk)'},
    {lbl:'MK × ML',v:ps(vbML),c:'var(--mk)',op:'0.5'},
    {lbl:'MT × Shopify',v:ps(mtSH),c:'var(--mt)'},
    {lbl:'MT × ML',v:ps(mtML),c:'var(--mt)',op:'0.5'},
  ];
  const mixTot=mixRows.reduce((s,r)=>s+r.v,0)||1;
  const mixMax=Math.max(...mixRows.map(r=>r.v),1);
  document.getElementById('pnl-mix').innerHTML=mixRows.map(r=>`
    <div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;margin-bottom:3px">
        <span style="font-family:var(--mono);font-size:9px;color:var(--txt3)">${r.lbl}</span>
        <span style="font-family:var(--mono);font-size:9px;color:var(--txt2)">${(r.v/mixTot*100).toFixed(0)}%</span>
      </div>
      <div style="height:4px;background:var(--bg3);border-radius:2px;overflow:hidden">
        <div style="height:100%;width:${(r.v/mixMax*100).toFixed(1)}%;background:${r.c};opacity:${r.op||'1'};border-radius:2px"></div>
      </div>
    </div>`).join('');

  renderPnLTable(idxs,labels);
}

function renderPnLTable(idxs,labels){
  const{rows}=PNL;
  const SC={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E','RESULTADO':'#111','METRICAS':'#37474F','MARCA':'#263238'};
  const getSC=c=>{const u=c.toUpperCase();for(const[k,v]of Object.entries(SC)){if(u.includes(k))return v;}return'#1e2330';};
  const isShdr=r=>r.concepto.includes('▶')||r.concepto.startsWith('â–¶');
  const isBold=r=>r.concepto.startsWith('TOTAL')||r.concepto.startsWith('VENTA BRUTA TOTAL')||r.concepto.startsWith('MARGEN BRUTO TOTAL')||r.concepto.startsWith('RESULTADO NETO');
  const isRes=r=>r.concepto.includes('RESULTADO NETO');
  const isPct=r=>r.concepto.startsWith('%');
  const fv=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const cc=(v,r)=>r?(v>=0?'color:var(--pos);font-weight:500':'color:var(--neg);font-weight:500'):'';
  const psum=mv=>idxs.reduce((s,i)=>s+(mv[i]||0),0);
  const pavg=mv=>{const nz=idxs.map(i=>mv[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const ths=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  let html=`<table class="pnl-table"><thead><tr><th>Concepto</th><th>Categoría</th>${ths}<th class="th-tot">Total/Prom</th></tr></thead><tbody>`;
  rows.forEach(row=>{
    if(isShdr(row)){
      const bg=getSC(row.concepto);
      html+=`<tr class="shdr"><td style="background:${bg}">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${labels.map(()=>`<td style="background:${bg}"></td>`).join('')}<td class="td-tot" style="background:${bg}"></td></tr>`;
      return;
    }
    const pRow=isPct(row),bRow=isBold(row),rRow=isRes(row);
    const tds=idxs.map(i=>{const v=row.mv[i]||0;return`<td style="${cc(v,rRow)}">${fv(v,pRow)}</td>`;}).join('');
    const totV=pRow?pavg(row.mv):psum(row.mv);
    html+=`<tr class="${bRow?'bold':''}"><td>${row.concepto}</td><td>${row.cat}</td>${tds}<td class="td-tot" style="${cc(totV,rRow)}">${fv(totV,pRow)}</td></tr>`;
  });
  html+='</tbody></table>';
  document.getElementById('pnl-table-wrap').innerHTML=html;
}

// ── HISTÓRICO ────────────────────────────────────────────
async function renderHist(){
  if(!pnlLoaded){await loadPnL();}
  const{meses}=PNL;if(!meses.length)return;
  const years=[...new Set(meses.map(m=>'20'+m.slice(-2)))].sort();
  document.getElementById('hist-btns').innerHTML=years.map((y,i)=>
    `<button class="hbtn${i===years.length-1?' on':''}" onclick="showHY('${y}',this)">${y}</button>`
  ).join('');
  showHY(years[years.length-1],document.querySelector('.hbtn.on'));
}

function showHY(year,el){
  document.querySelectorAll('.hbtn').forEach(b=>b.classList.remove('on'));
  if(el)el.classList.add('on');
  const{meses,rows}=PNL;
  const idxs=[],labels=[];
  meses.forEach((m,i)=>{if(m.slice(-2)===year.slice(2)){idxs.push(i);labels.push(m);}});
  const isPct=r=>r.concepto.startsWith('%');
  const isShdr=r=>r.concepto.includes('▶')||r.concepto.startsWith('â–¶');
  const isBold=r=>r.concepto.startsWith('TOTAL')||r.concepto.startsWith('VENTA BRUTA TOTAL')||r.concepto.startsWith('MARGEN BRUTO TOTAL')||r.concepto.startsWith('RESULTADO');
  const isRes=r=>r.concepto.includes('RESULTADO NETO');
  const fv=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const SC={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E','RESULTADO':'#111','METRICAS':'#37474F','MARCA':'#263238'};
  const getSC=c=>{const u=c.toUpperCase();for(const[k,v]of Object.entries(SC)){if(u.includes(k))return v;}return'#1e2330';};
  const psum=mv=>idxs.reduce((s,i)=>s+(mv[i]||0),0);
  const pavg=mv=>{const nz=idxs.map(i=>mv[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const ths=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  let html=`<div class="tpanel"><div class="thead-row"><span class="thtitle">Estado de resultados · ${year}</span></div><div class="tscroll"><table class="pnl-table"><thead><tr><th>Concepto</th><th>Categoría</th>${ths}<th class="th-tot">Total</th></tr></thead><tbody>`;
  rows.forEach(row=>{
    if(isShdr(row)){const bg=getSC(row.concepto);html+=`<tr class="shdr"><td style="background:${bg}">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${labels.map(()=>`<td style="background:${bg}"></td>`).join('')}<td class="td-tot" style="background:${bg}"></td></tr>`;return;}
    const pRow=isPct(row),bRow=isBold(row),rRow=isRes(row);
    const tds=idxs.map(i=>{const v=row.mv[i]||0;const s=rRow?(v>=0?'color:var(--pos);font-weight:500':'color:var(--neg);font-weight:500'):'';return`<td style="${s}">${fv(v,pRow)}</td>`;}).join('');
    const totV=pRow?pavg(row.mv):psum(row.mv);
    const ts=rRow?(totV>=0?'color:var(--pos);font-weight:500':'color:var(--neg);font-weight:500'):'';
    html+=`<tr class="${bRow?'bold':''}"><td>${row.concepto}</td><td>${row.cat}</td>${tds}<td class="td-tot" style="${ts}">${fv(totV,pRow)}</td></tr>`;
  });
  html+='</tbody></table></div></div>';
  document.getElementById('hist-content').innerHTML=html;
}

// ── CHECKLIST ────────────────────────────────────────────
function showCL(){document.getElementById('cl-modal').style.display='block';document.body.style.overflow='hidden';}
function hideCL(){document.getElementById('cl-modal').style.display='none';document.body.style.overflow='';}
function clTog(el){el.classList.toggle('done');clProg();}
function clProg(){const t=document.querySelectorAll('.cl-item').length,d=document.querySelectorAll('.cl-item.done').length;document.getElementById('cl-prog').style.width=(t>0?d/t*100:0)+'%';}
function clReset(){document.querySelectorAll('.cl-item').forEach(e=>e.classList.remove('done'));clProg();}
document.addEventListener('keydown',e=>{if(e.key==='Escape')hideCL();});

// ── UTILS ────────────────────────────────────────────────
const clp=n=>'$'+Math.round(n).toLocaleString('es-CL');
const sum=(arr,k)=>arr.reduce((s,r)=>s+(r[k]||0),0);
function pn(v){
  if(v===null||v===undefined||v==='')return 0;
  if(typeof v==='number')return v;
  let s=String(v).trim().replace(/[$\s%]/g,'');
  if(!s)return 0;
  const dots=(s.match(/\./g)||[]).length,commas=(s.match(/,/g)||[]).length;
  if(commas>=1&&dots===0)s=s.replace(/,/g,'');
  else if(commas===1&&dots===1)s=s.replace(',','');
  else if(commas===0&&dots>1)s=s.replace(/\./g,'');
  return parseFloat(s)||0;
}
function scsv(line){
  const res=[];let f='',inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){f+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){res.push(f.trim());f='';}
    else f+=c;
  }
  res.push(f.trim());return res;
}
