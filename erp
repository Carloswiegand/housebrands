    document.getElementById('v-dash').style.display='block';
    render();
  }catch(e){
    document.getElementById('v-loading').innerHTML='<div style="color:var(--neg);font-family:var(--mono);font-size:11px">Error cargando datos.<br><button onclick="loadVentas()" style="margin-top:10px;padding:6px 14px;background:var(--bg2);border:1px solid var(--line2);color:var(--txt);border-radius:4px;cursor:pointer;font-family:var(--mono);font-size:10px">Reintentar</button></div>';
  }
}

function parseVentas(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<2) return [];
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<20) continue;
    const marca=c[4]?.trim()||'';
    if(!marca) continue;
    const canal=c[5]?.trim()||'';
    const mes=parseInt(c[1])||0;
    const anio=parseInt(c[3])||0;
    const sku=c[7]?.trim()||'';
    const prod=c[8]?.trim()||'';
    const qty=parseInt(c[9])||1;
    const vb=pn(c[11]);
    const costoUnit=pn(c[17]);
    const costoTotal=pn(c[18]);
    const mb=pn(c[19]);
    const mrg=pn(c[20]);
    const envio=pn(c[12]);
    const cargoMP=pn(c[13]);
    const descto=pn(c[15]);
    if(vb<=0) continue;
    // ICN: venta bruta - comision pasarela
    const comision = canal==='Shopify' ? cargoMP : (canal==='ML'?cargoMP:0);
    const icn = vb - comision;
    let fecha=c[0]?.trim()||'';
    const dmy=fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy) fecha=dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    rows.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costoUnit,costoTotal,mb,mrg,envio,cargoMP,descto,comision,icn});
  }
  return rows;
}

