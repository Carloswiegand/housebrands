<script>
// ── CONFIG ────────────────────────────────────────────────
const PASSWORD  = '200487';
const CSV_VENTAS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSSW-hwbvafdfQkWXySGjtTr8MkjFecsAQG_tbEyfkWoud0wCqpFDE3PPf9CPU3s_yKr0Z4D5qGBhBH/pub?gid=573947071&single=true&output=csv';
const CSV_PNL    = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSSW-hwbvafdfQkWXySGjtTr8MkjFecsAQG_tbEyfkWoud0wCqpFDE3PPf9CPU3s_yKr0Z4D5qGBhBH/pub?gid=1129827764&single=true&output=csv';

// ── AUTH ──────────────────────────────────────────────────
function checkLogin() {
  const val = document.getElementById('pwd-input').value;
  if(val === PASSWORD) {
    sessionStorage.setItem('hb_auth','1');
    document.getElementById('login-screen').style.display='none';
    document.getElementById('app').style.display='block';
    loadVentas();
