      const v=vRow.mv[i]||0,m=mRow.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;
      return`<td>${v?clp(v):'—'}${v?`<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${p}%</span>`:''}
      </td>`;
    }).join('');
    const vtot=ps(vRow.mv),mtot=ps(mRow.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr><td><span class="bdg ${cls}">${tag}</span> ${nm}<br><span style="font-size:9px;color:var(--light)">Venta bruta · Margen %</span></td>
