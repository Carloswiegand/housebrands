      <td>${r.un}</td>
      <td>${clp(r.vb)}</td>
      <td class="neg-val">${r.comision>0?'−'+clp(r.comision):'—'}</td>
      <td>${clp(r.icn)}</td>
      <td style="color:var(--txt3)">${clp(r.costo)}</td>
      <td style="color:#fff;font-weight:500">${clp(r.mb)}</td>
      <td><div class="mrg-cell"><span style="color:${mc};font-weight:500">${mp.toFixed(1)}%</span>
        <div class="mbar"><div class="mfill" style="width:${Math.min(100,mp).toFixed(0)}%;background:${mc}"></div></div>
      </div></td>
    </tr>`;
  }).join('');
