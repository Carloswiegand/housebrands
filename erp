const SHEET_ID  = '1a9Hv9ceZ_1Wfg2Gp6gRuZ5mgk0eRHgYyBhklulQAbyU';
const SHEET_GID = '573947071'; // GID de Libro_Ventas
const CSV_URL   = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSSW-hwbvafdfQkWXySGjtTr8MkjFecsAQG_tbEyfkWoud0wCqpFDE3PPf9CPU3s_yKr0Z4D5qGBhBH/pub?gid=573947071&single=true&output=csv';

// ── AUTH ──────────────────────────────────────────────────────
function checkLogin() {
