      <div class="hbar-lbl" title="${v.nom}">${v.nom||sku}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${(v.vb/mx*100).toFixed(1)}%;background:${v.marca==='MemoKoala'?'var(--mk)':'var(--mt)'}"></div></div>
      <div class="hbar-val">${clp(v.vb)}</div>
    </div>`).join('');
}

function renderRecentTx(d){
  const sorted=[...d].sort((a,b)=>b.fecha.localeCompare(a.fecha)).slice(0,15);
