function parseVentasCSV(text){
  const lines=text.split('\n').filter(l=>l.trim());
  if(lines.length<2) return [];
  const records=[];
  for(let i=1;i<lines.length;i++){
    const cols=splitCSV(lines[i]);
    if(cols.length<20) continue;
    const marca=cols[4]?.trim()||'';
    if(!marca) continue;
    const canal=cols[5]?.trim()||'';
    const mes=parseInt(cols[1])||0;
    const anio=parseInt(cols[3])||0;
    const sku=cols[7]?.trim()||'';
    const prod=cols[8]?.trim()||'';
    const qty=parseInt(cols[9])||1;
    const vb=parseNum(cols[11]);
    const costo=parseNum(cols[18]);
    const mb=parseNum(cols[19]);
    const mrg=parseNum(cols[20]);
    if(vb<=0) continue;
    const mb_f=mb!==0?mb:(vb-costo);
    const mrg_f=mrg!==0?mrg:(vb>0?(mb_f/vb)*100:0);
    let fecha=cols[0]?.trim()||'';
    const dmy=fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy) fecha=dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    records.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costo,mb:mb_f,mrg:mrg_f});
  }
  return records;
}

// ── PNL ───────────────────────────────────────────────────
let PNL_RAW={meses:[],rows:[]};
let pnlPeriod='corrido'; // 'corrido' | '2026' | '2025'

async function loadPnL(){
  try{
