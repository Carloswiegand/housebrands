async function fetchTC(){
  try{
    const hoy=new Date(),d=hoy.getDate(),m=hoy.getMonth()+1,a=hoy.getFullYear();
    const ds=`${d}-${String(m).padStart(2,'0')}-${a}`;
    const [ru,rf]=await Promise.all([
      fetch('https://mindicador.cl/api/dolar/'+ds).then(r=>r.json()).catch(()=>null),
      fetch('https://mindicador.cl/api/uf/'+ds).then(r=>r.json()).catch(()=>null)
    ]);
    if(ru?.serie?.[0]?.valor) document.getElementById('tc-usd').textContent='USD $'+Math.round(ru.serie[0].valor).toLocaleString('es-CL');
    if(rf?.serie?.[0]?.valor) document.getElementById('tc-uf').textContent='UF $'+Math.round(rf.serie[0].valor).toLocaleString('es-CL');
  }catch(e){}
  document.getElementById('tc-act').textContent='act. '+new Date().toLocaleTimeString('es-CL',{hour:'2-digit',minute:'2-digit'});
}

async function loadVentas(){
  try{
    const r=await fetch(CSV_V);
    const csvData=parseVentas(await r.text());
    const manual=loadManuales();
    DATA=[...csvData,...manual];
    const years=[...new Set(DATA.map(r=>r.anio))].sort();
    const sel=document.getElementById('f-anio');
    years.forEach(y=>{const o=document.createElement('option');o.value=y;o.textContent=y;sel.appendChild(o);});
    document.getElementById('v-loading').style.display='none';
    document.getElementById('v-dash').style.display='block';
    buildCanalPills();
    render();
  }catch(e){
    document.getElementById('v-loading').innerHTML='<p style="color:var(--neg);font-family:var(--mono);font-size:11px">Error cargando datos.<br><button onclick="loadVentas()" style="margin-top:12px;padding:7px 16px;background:var(--night);border:none;color:#fff;border-radius:4px;cursor:pointer;font-family:var(--mono);font-size:10px">Reintentar</button></p>';
  }
}

function parseVentas(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<2)return[];
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<20)continue;
    const marca=c[4]?.trim()||'';
    if(!marca)continue;
    const canal=c[5]?.trim()||'';
    const mes=parseInt(c[1])||0, anio=parseInt(c[3])||0;
    const sku=c[7]?.trim()||'', prod=c[8]?.trim()||'';
    const qty=parseInt(c[9])||1;
    const vb=pn(c[11]),costoUnit=pn(c[17]),costoTotal=pn(c[18]);
    const mb=pn(c[19]),mrg=pn(c[20]);
    const envio=pn(c[12]), cargoMP=pn(c[13]), descto=pn(c[15]);
    if(vb<=0)continue;
    // Comisión: para ML y Shopify viene en cols[13]
    // % efectivo de comisión = cargoMP / vb
    const comision=cargoMP;
    const comPct=vb>0?(cargoMP/vb)*100:0;
    const icn=vb-comision;
    let fecha=c[0]?.trim()||'';
    const dmy=fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy)fecha=dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    // Para ML: envio=colecta (costo), descto=FLEX abono (recupero)
    // flexRecupero solo para ML
    const flexRecupero=canal==='ML'?descto:0;
    const costoEnvioML=canal==='ML'?envio:0;
    const envioCobradoSH=canal==='Shopify'?envio:0;
    rows.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costoUnit,costoTotal,mb,mrg,envio,cargoMP,descto,comision,comPct,icn,flexRecupero,costoEnvioML,envioCobradoSH,manual:false});
  }
  return rows;
}

