    }).join('');
    const vtot=ps(vbTOT.mv),mtot=ps(mbTOT.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr class="bold"><td>TOTAL CONSOLIDADO<br><span style="font-size:9px;color:var(--light);font-weight:400">Venta bruta · Margen %</span></td>
