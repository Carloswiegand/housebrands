<script>
// ── CONFIG ────────────────────────────────────────────────
const PASSWORD   = '200487';
const CSV_VENTAS = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSSW-hwbvafdfQkWXySGjtTr8MkjFecsAQG_tbEyfkWoud0wCqpFDE3PPf9CPU3s_yKr0Z4D5qGBhBH/pub?gid=573947071&single=true&output=csv';
const CSV_PNL    = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSSW-hwbvafdfQkWXySGjtTr8MkjFecsAQG_tbEyfkWoud0wCqpFDE3PPf9CPU3s_yKr0Z4D5qGBhBH/pub?gid=1843070423&single=true&output=csv';

// ── AUTH ──────────────────────────────────────────────────
function checkLogin(){
  if(document.getElementById('pwd-input').value===PASSWORD){
    sessionStorage.setItem('hb_auth','1');
    document.getElementById('login-screen').style.display='none';
    document.getElementById('app').style.display='block';
    loadVentas();
  } else {
    document.getElementById('login-err').style.display='block';
    document.getElementById('pwd-input').value='';
    document.getElementById('pwd-input').focus();
  }
}
function logout(){sessionStorage.removeItem('hb_auth');location.reload();}
document.getElementById('pwd-input').addEventListener('keydown',e=>{if(e.key==='Enter')checkLogin();});
if(sessionStorage.getItem('hb_auth')==='1'){
  document.getElementById('login-screen').style.display='none';
  document.getElementById('app').style.display='block';
  loadVentas();
}

// ── TABS ──────────────────────────────────────────────────
let pnlLoaded=false;
function switchTab(tab){
  ['ventas','pnl','historico'].forEach(t=>{
    document.getElementById('view-'+t).style.display=t===tab?'block':'none';
    document.getElementById('tab-'+t).className='tab'+(t===tab?' active':'');
  });
  if(tab==='pnl'&&!pnlLoaded) loadPnL();
  if(tab==='historico') renderHistorico();
}

// ── VENTAS ────────────────────────────────────────────────
let DATA=[];
let filters={m:'Todas',c:'Todos',y:0,me:0};

async function loadVentas(){
  try{
    const r=await fetch(CSV_VENTAS);
    if(!r.ok) throw new Error('HTTP '+r.status);
    DATA=parseVentasCSV(await r.text());
    document.getElementById('loading-ventas').style.display='none';
    document.getElementById('dash-ventas').style.display='block';
    document.getElementById('updated-label').textContent='Actualizado: '+new Date().toLocaleTimeString('es-CL');
    render();
  }catch(e){
    document.getElementById('loading-ventas').innerHTML='<div style="color:#c0392b;font-family:var(--mono);font-size:12px">Error cargando datos.<br><button onclick="loadVentas()" style="background:var(--slate-dark);color:var(--cream);border:none;padding:8px 16px;border-radius:2px;cursor:pointer;font-family:var(--mono);margin-top:12px">Reintentar</button></div>';
  }
}

function parseVentasCSV(text){
  const lines=text.split('\n').filter(l=>l.trim());
  if(lines.length<2) return [];
  const records=[];
  for(let i=1;i<lines.length;i++){
    const cols=splitCSV(lines[i]);
    if(cols.length<20) continue;
    const marca=cols[4]?.trim()||'';
    if(!marca) continue;
    const canal=cols[5]?.trim()||'';
    const mes=parseInt(cols[1])||0;
    const anio=parseInt(cols[3])||0;
    const sku=cols[7]?.trim()||'';
    const prod=cols[8]?.trim()||'';
    const qty=parseInt(cols[9])||1;
    const vb=parseNum(cols[11]);
    const costo=parseNum(cols[18]);
    const mb=parseNum(cols[19]);
    const mrg=parseNum(cols[20]);
    if(vb<=0) continue;
    const mb_f=mb!==0?mb:(vb-costo);
    const mrg_f=mrg!==0?mrg:(vb>0?(mb_f/vb)*100:0);
    let fecha=cols[0]?.trim()||'';
    const dmy=fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy) fecha=dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    records.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costo,mb:mb_f,mrg:mrg_f});
  }
  return records;
}

// ── PNL ───────────────────────────────────────────────────
let PNL_RAW={meses:[],rows:[]};
let pnlPeriod='corrido';

async function loadPnL(){
  try{
    const r=await fetch(CSV_PNL);
    if(!r.ok) throw new Error('HTTP '+r.status);
    PNL_RAW=parsePnLCSV(await r.text());
    pnlLoaded=true;
    document.getElementById('loading-pnl').style.display='none';
    document.getElementById('dash-pnl').style.display='block';
    buildPeriodPills();
    renderPnL();
  }catch(e){
    document.getElementById('loading-pnl').innerHTML='<div style="color:#c0392b;font-family:var(--mono);font-size:12px">Error cargando P&L.<br><button onclick="loadPnL()" style="background:var(--slate-dark);color:var(--cream);border:none;padding:8px 16px;border-radius:2px;cursor:pointer;font-family:var(--mono);margin-top:12px">Reintentar</button></div>';
  }
}

function parsePnLCSV(text){
  const lines=text.split('\n').filter(l=>l.trim());
  if(lines.length<3) return {meses:[],rows:[]};
  let hdrIdx=-1;
  for(let i=0;i<Math.min(lines.length,6);i++){
    if(lines[i].toUpperCase().includes('CONCEPTO')){hdrIdx=i;break;}
  }
  if(hdrIdx===-1) hdrIdx=2;
  const hdrCols=splitCSV(lines[hdrIdx]);
  const allCols=hdrCols.slice(2).map(m=>m.trim()).filter(m=>m);
  const meses=allCols.slice(0,-1);
  const rows=[];
  for(let i=hdrIdx+1;i<lines.length;i++){
    const cols=splitCSV(lines[i]);
    if(cols.length<3) continue;
    const concepto=fixEncoding(cols[0]?.trim()||'');
    const categoria=fixEncoding(cols[1]?.trim()||'');
    if(!concepto) continue;
    const allVals=cols.slice(2);
    const mesVals=allVals.slice(0,-1).map(v=>parsePnLNum(v));
    const totalVal=parsePnLNum(allVals[allVals.length-1]||'0');
    while(mesVals.length<meses.length) mesVals.push(0);
    rows.push({concepto,categoria,mesVals,totalVal});
  }
  return{meses,rows};
}

function fixEncoding(s){
  return s.replace(/â–¶/g,'▶').replace(/â€"/g,'—').replace(/Ã©/g,'é')
    .replace(/Ã³/g,'ó').replace(/Ã­/g,'í').replace(/Ã¡/g,'á')
    .replace(/Ã±/g,'ñ').replace(/Ã—/g,'×').replace(/Ã"/g,'Ó')
    .replace(/Ã‰/g,'É').replace(/â€œ/g,'"').replace(/â€/g,'"')
    .replace(/Ã"/g,'Ú').replace(/Ã¼/g,'ü');
}

function parsePnLNum(v){
  if(v===null||v===undefined||v==='') return 0;
  const s=String(v).trim();
  if(s.endsWith('%')) return parseFloat(s.replace('%','').replace(',','.'))||0;
  let n=s.replace(/[$\s"]/g,'');
  if(n==='') return 0;
  const dots=(n.match(/\./g)||[]).length,commas=(n.match(/,/g)||[]).length;
  if(commas>=1&&dots===0) n=n.replace(/,/g,'');
  else if(commas===1&&dots===1) n=n.replace(',','');
  else if(commas===0&&dots>1) n=n.replace(/\./g,'');
  return parseFloat(n)||0;
}

function getPeriodMeses(){
  const {meses}=PNL_RAW;
  if(!meses.length) return{idxs:[],labels:[]};
  if(pnlPeriod==='corrido'){
    const ord=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
    const indexed=meses.map((m,i)=>({m,i})).sort((a,b)=>{
      const ya=parseInt('20'+a.m.slice(-2)),yb=parseInt('20'+b.m.slice(-2));
      if(ya!==yb) return ya-yb;
      return ord.indexOf(a.m.slice(0,3).toLowerCase())-ord.indexOf(b.m.slice(0,3).toLowerCase());
    });
    const last12=indexed.slice(-12);
    return{idxs:last12.map(x=>x.i),labels:last12.map(x=>x.m)};
  }
  const idxs=[],labels=[],yrSuffix=pnlPeriod.slice(2);
  meses.forEach((m,i)=>{if(m.slice(-2)===yrSuffix){idxs.push(i);labels.push(m);}});
  return{idxs,labels};
}

function buildPeriodPills(){
  const {meses}=PNL_RAW;
  const years=[...new Set(meses.map(m=>m.slice(-2)))].sort();
  const pills=[{id:'corrido',label:'Año corrido (12m)'},...years.map(y=>({id:'20'+y,label:'20'+y}))];
  document.getElementById('period-pills').innerHTML=pills.map(p=>
    `<button class="period-pill${p.id===pnlPeriod?' on':''}" onclick="setPeriod('${p.id}',this)">${p.label}</button>`
  ).join('');
}

function setPeriod(id,el){
  pnlPeriod=id;
  document.querySelectorAll('.period-pill').forEach(p=>p.classList.remove('on'));
  el.classList.add('on');renderPnL();
}

function renderPnL(){
  const {rows}=PNL_RAW;
  if(!rows.length) return;
  const {idxs,labels}=getPeriodMeses();
  const findRow=term=>rows.find(r=>r.concepto.toUpperCase().includes(term.toUpperCase()));
  const periodSum=row=>{if(!row) return 0;return idxs.reduce((s,i)=>s+(row.mesVals[i]||0),0);};
  const periodVals=row=>{if(!row) return idxs.map(()=>0);return idxs.map(i=>row.mesVals[i]||0);};
  const vbTot=findRow('VENTA BRUTA TOTAL'),mbTot=findRow('MARGEN BRUTO TOTAL');
  const logNeto=findRow('TOTAL LOG'),mktTot=findRow('TOTAL MARKETING');
  const techTot=findRow('TOTAL TECH'),admTot=findRow('TOTAL ADMINISTRACI');
  const resultado=findRow('RESULTADO NETO');
  const vbS=periodSum(vbTot),mbS=periodSum(mbTot),resS=periodSum(resultado);
  const mrgP=vbS>0?mbS/vbS:0;
  const gastosS=periodSum(logNeto)+periodSum(mktTot)+periodSum(techTot)+periodSum(admTot);
  const mesesPos=resultado?periodVals(resultado).filter(v=>v>0).length:0;
  document.getElementById('pnl-kpi-grid').innerHTML=[
    {lbl:'Venta Bruta',val:clp(vbS),sub:labels.length+' meses',accent:'var(--slate-mid)',tag:'',cls:''},
    {lbl:'Margen Bruto',val:clp(mbS),sub:(mrgP*100).toFixed(1)+'% sobre venta',accent:'var(--gold)',tag:mrgP>=.65?'Saludable':'Revisar',cls:mrgP>=.65?'tag-up':'tag-dn'},
    {lbl:'Resultado Neto',val:clp(resS),sub:'período',accent:resS>=0?'var(--green)':'var(--red)',tag:resS>=0?'Positivo':'Negativo',cls:resS>=0?'tag-up':'tag-dn'},
    {lbl:'Meses Positivos',val:mesesPos+'/'+labels.length,sub:'con resultado >0',accent:'var(--slate-dark)',tag:'',cls:''},
    {lbl:'Total Gastos Op.',val:clp(gastosS),sub:'log+mkt+tech+admin',accent:'var(--mt)',tag:'',cls:''},
    {lbl:'% Gasto / Venta',val:vbS>0?(gastosS/vbS*100).toFixed(1)+'%':'0%',sub:'sobre venta bruta',accent:'var(--slate-light)',tag:'',cls:''},
  ].map(k=>`<div class="kpi fade-up" style="--accent:${k.accent}">
    <div class="kpi-label">${k.lbl}</div><div class="kpi-val">${k.val}</div>
    ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
    <div class="kpi-sub">${k.sub}</div></div>`).join('');
  if(resultado){
    const vals=periodVals(resultado),maxAbs=Math.max(...vals.map(v=>Math.abs(v)),1);
    document.getElementById('pnl-result-bars').innerHTML=vals.map((v,i)=>{
      const h=Math.max(3,(Math.abs(v)/maxAbs)*110);
      return `<div class="mbar-col"><div class="mbar-wrap">
        <div class="mbar" style="height:${h}px;background:${v>=0?'var(--green)':'var(--red)'};opacity:.85" data-tip="${labels[i]}: ${clp(v)}"></div>
      </div><div class="mbar-lbl">${(labels[i]||'').slice(0,6)}</div></div>`;
    }).join('');
  }
  const gastoRows=[
    {label:'Logístico Neto',row:logNeto,color:'var(--mt)'},
    {label:'Marketing',row:mktTot,color:'var(--slate-mid)'},
    {label:'Tech & Software',row:techTot,color:'var(--slate-dark)'},
    {label:'Administración',row:admTot,color:'var(--slate-night)'},
  ];
  const maxG=Math.max(...gastoRows.map(g=>periodSum(g.row)),1);
  document.getElementById('gasto-bars').innerHTML=gastoRows.map(g=>`
    <div class="hbar-row">
      <div class="hbar-lbl">${g.label}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${(periodSum(g.row)/maxG*100).toFixed(1)}%;background:${g.color}"></div></div>
      <div class="hbar-val">${clp(periodSum(g.row))}</div>
    </div>`).join('');
  const renderCanalMrg=(shConcepto,mlConcepto,containerId)=>{
    const findFlex=term=>{const t=term.toLowerCase().replace(/[×x]/g,'.');return rows.find(r=>r.concepto.toLowerCase().replace(/[×x]/g,'.').includes(t));};
    const shRow=findFlex(shConcepto),mlRow=findFlex(mlConcepto);
    const channels=[{label:'Shopify',row:shRow,color:'var(--green)',cls:'b-sh'},{label:'MercadoLibre',row:mlRow,color:'var(--gold)',cls:'b-ml'}];
    document.getElementById(containerId).innerHTML=channels.map(ch=>{
      if(!ch.row) return '';
      const vals=periodVals(ch.row).filter(v=>v!==0);
      const avg=vals.length?vals.reduce((s,v)=>s+v,0)/vals.length:0;
      const mc=mColor(avg);
      return `<div style="margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;margin-bottom:6px">
          <span class="bdg ${ch.cls}">${ch.label}</span>
          <span style="font-family:var(--fd);font-size:20px;font-weight:700;letter-spacing:-0.03em;color:${mc}">${avg.toFixed(1)}%</span>
        </div>
        <div style="height:5px;background:var(--off);border-radius:2px;overflow:hidden">
          <div style="height:100%;width:${Math.min(100,avg).toFixed(1)}%;background:${ch.color};border-radius:2px"></div>
        </div>
        <div style="font-family:var(--mono);font-size:9px;color:var(--gray);margin-top:5px">promedio de ${vals.length} mes${vals.length!==1?'es':''} con venta</div>
      </div>`;
    }).join('');
  };
  renderCanalMrg('% Margen MemoKoala × Shopify','% Margen MemoKoala × MercadoLibre','pnl-mk-canal');
  renderCanalMrg('% Margen Montana × Shopify','% Margen Montana × MercadoLibre','pnl-mt-canal');
  renderPnLTable(idxs,labels);
}

function renderPnLTable(idxs,labels){
  const {rows}=PNL_RAW;
  const SECTION_COLORS={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E','RESULTADO':'#1C2B3A','METRICAS':'#37474F','MARCA':'#263238'};
  const getSectionColor=concepto=>{const u=concepto.toUpperCase();for(const[k,v] of Object.entries(SECTION_COLORS)){if(u.includes(k))return v;}return '#2C3E4C';};
  const isSubhdr=row=>row.concepto.includes('▶')||row.concepto.startsWith('â–¶');
  const isBold=row=>row.concepto.startsWith('TOTAL')||row.concepto.startsWith('VENTA BRUTA TOTAL')||row.concepto.startsWith('MARGEN BRUTO TOTAL')||row.concepto.startsWith('RESULTADO NETO');
  const isResultado=row=>row.concepto.includes('RESULTADO NETO');
  const isPct=row=>row.concepto.startsWith('%');
  const fmtVal=(v,isPctRow)=>isPctRow?v.toFixed(1)+'%':clp(v);
  const cellColor=(v,isRes)=>isRes?(v>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700'):'';
  const periodSum=vals=>idxs.reduce((s,i)=>s+(vals[i]||0),0);
  const avgForPct=vals=>{const nz=idxs.map(i=>vals[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const thCells=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  let html=`<table class="pnl-table"><thead><tr><th>Concepto</th><th>Categoría</th>${thCells}<th class="th-total">Total / Prom.</th></tr></thead><tbody>`;
  rows.forEach(row=>{
    if(isSubhdr(row)){
      const bg=getSectionColor(row.concepto);
      html+=`<tr class="subhdr"><td style="background:${bg};color:#fff">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${labels.map(()=>`<td style="background:${bg}"></td>`).join('')}<td class="td-total" style="background:${bg}"></td></tr>`;
      return;
    }
    const pctRow=isPct(row),boldRow=isBold(row),resRow=isResultado(row);
    const tdCells=idxs.map(i=>{const v=row.mesVals[i]||0;return `<td style="${cellColor(v,resRow)}">${fmtVal(v,pctRow)}</td>`;}).join('');
    const totalV=pctRow?avgForPct(row.mesVals):periodSum(row.mesVals);
    html+=`<tr class="${boldRow?'bold':''}"><td>${row.concepto}</td><td>${row.categoria}</td>${tdCells}<td class="td-total" style="${cellColor(totalV,resRow)}">${fmtVal(totalV,pctRow)}</td></tr>`;
  });
  html+='</tbody></table>';
  document.getElementById('pnl-table-wrap').innerHTML=html;
}

// ── HISTÓRICO ─────────────────────────────────────────────
async function renderHistorico(){
  if(!pnlLoaded){
    document.getElementById('hist-content').innerHTML='<div class="loading"><div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div></div>';
    await loadPnL();
  }
  const {meses}=PNL_RAW;
  if(!meses.length) return;
  const years=[...new Set(meses.map(m=>'20'+m.slice(-2)))].sort();
  document.getElementById('hist-period-btns').innerHTML=years.map((y,i)=>
    `<button onclick="showHistYear('${y}')" style="font-family:var(--mono);font-size:11px;padding:8px 20px;border-radius:2px;border:1px solid var(--border);background:${i===years.length-1?'var(--slate-dark)':'#fff'};color:${i===years.length-1?'var(--cream)':'var(--slate-mid)'};cursor:pointer">${y}</button>`
  ).join('');
  showHistYear(years[years.length-1]);
}

function showHistYear(year){
  const {meses,rows}=PNL_RAW;
  const idxs=[],labels=[];
  meses.forEach((m,i)=>{if(m.slice(-2)===''+year.slice(2)){idxs.push(i);labels.push(m);}});
  const isPct=row=>row.concepto.startsWith('%');
  const isSubhdr=row=>row.concepto.includes('▶')||row.concepto.startsWith('â–¶');
  const isBold=row=>row.concepto.startsWith('TOTAL')||row.concepto.startsWith('VENTA BRUTA TOTAL')||row.concepto.startsWith('MARGEN BRUTO TOTAL')||row.concepto.startsWith('RESULTADO');
  const isRes=row=>row.concepto.includes('RESULTADO NETO');
  const fmtV=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const SCOLORS={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E','RESULTADO':'#1C2B3A','METRICAS':'#37474F','MARCA':'#263238'};
  const getC=c=>{const u=c.toUpperCase();for(const[k,v] of Object.entries(SCOLORS)){if(u.includes(k))return v;}return '#2C3E4C';};
  const periodSum=vals=>idxs.reduce((s,i)=>s+(vals[i]||0),0);
  const avgPct=vals=>{const nz=idxs.map(i=>vals[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const thCells=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  let html=`<div class="card"><div class="card-head"><span class="card-title">Estado de Resultados · ${year}</span></div>
  <div class="pnl-wrap"><table class="pnl-table"><thead><tr><th>Concepto</th><th>Categoría</th>${thCells}<th class="th-total">Total</th></tr></thead><tbody>`;
  rows.forEach(row=>{
    if(isSubhdr(row)){const bg=getC(row.concepto);html+=`<tr class="subhdr"><td style="background:${bg};color:#fff">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${labels.map(()=>`<td style="background:${bg}"></td>`).join('')}<td class="td-total" style="background:${bg}"></td></tr>`;return;}
    const pRow=isPct(row),bRow=isBold(row),rRow=isRes(row);
    const tds=idxs.map(i=>{const v=row.mesVals[i]||0;const s=rRow?(v>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700'):'';return`<td style="${s}">${fmtV(v,pRow)}</td>`;}).join('');
    const tot=pRow?avgPct(row.mesVals):periodSum(row.mesVals);
    const ts=rRow?(tot>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700'):'';
    html+=`<tr class="${bRow?'bold':''}"><td>${row.concepto}</td><td>${row.categoria}</td>${tds}<td class="td-total" style="${ts}">${fmtV(tot,pRow)}</td></tr>`;
  });
  html+='</tbody></table></div></div>';
  document.getElementById('hist-content').innerHTML=html;
}

// ── VENTAS RENDER ─────────────────────────────────────────
const clp=n=>'$'+Math.round(n).toLocaleString('es-CL');
const pct=n=>(n*100).toFixed(1)+'%';
const mColor=p=>p>=65?'var(--green)':p>=45?'var(--gold)':'var(--red)';

function sf(type,val,el){
  filters[type]=val;
  const groups={m:['fa','fmk','fmt'],c:['fca','fsh','fml'],y:['fya','fy25','fy26'],me:['fma','fm1','fm2','fm3','fm4','fm5','fm6','fm7','fm8','fm9','fm10','fm11','fm12']};
  groups[type].forEach(id=>{const e=document.getElementById(id);if(e)e.className='pill';});
  el.className=val==='MemoKoala'?'pill mk':val==='Montana'?'pill mt':'pill on';render();
}
function filtered(){return DATA.filter(r=>{
  if(filters.m!=='Todas'&&r.marca!==filters.m) return false;
  if(filters.c!=='Todos'&&r.canal!==filters.c) return false;
  if(filters.y!==0&&r.anio!==filters.y) return false;
  if(filters.me!==0&&r.mes!==filters.me) return false;
  return true;
});}
function render(){const d=filtered();renderKPIs(d);renderMonthBars(d);renderCanal(d);renderMarca(d);renderProdBars(d);renderRecentTx(d);renderSkuTable(d);}

function renderKPIs(d){
  const vb=d.reduce((s,r)=>s+r.vb,0),mb=d.reduce((s,r)=>s+r.mb,0);
  const un=d.reduce((s,r)=>s+r.qty,0),cnt=d.length;
  const tk=un>0?vb/un:0,mrg=vb>0?mb/vb:0;
  const META=14969250,meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses,gap=avg/META-1;
  const kpis=[
    {lbl:'Venta Bruta',val:clp(vb),sub:cnt+' trans · '+un+' uds',tag:gap>=0?'↑ +'+Math.abs(gap*100).toFixed(1)+'% meta':'↓ '+Math.abs(gap*100).toFixed(1)+'% meta',cls:gap>=0?'tag-up':'tag-dn',accent:'var(--slate-mid)'},
    {lbl:'Margen Bruto $',val:clp(mb),sub:pct(mrg)+' sobre venta',tag:mrg>=.65?'Saludable':mrg>=.45?'OK':'Revisar',cls:mrg>=.65?'tag-up':mrg>=.45?'tag-n':'tag-dn',accent:'var(--gold)'},
    {lbl:'Ticket Promedio',val:clp(tk),sub:'por unidad',tag:'',cls:'',accent:'var(--slate-dark)'},
    {lbl:'Unidades',val:un.toLocaleString('es-CL'),sub:meses+' mes'+(meses>1?'es':''),tag:'',cls:'',accent:'var(--mt)'},
    {lbl:'Prom. Mensual',val:clp(avg),sub:'meta: '+clp(META),tag:gap>=0?'↑ Sobre meta':'↓ Bajo meta',cls:gap>=0?'tag-up':'tag-dn',accent:'var(--slate-night)'},
    {lbl:'Costo Total',val:clp(d.reduce((s,r)=>s+r.costo,0)),sub:'importación',tag:'',cls:'',accent:'var(--slate-light)'},
  ];
  document.getElementById('kpi-grid').innerHTML=kpis.map(k=>`
    <div class="kpi fade-up" style="--accent:${k.accent}">
      <div class="kpi-label">${k.lbl}</div><div class="kpi-val">${k.val}</div>
      ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
      <div class="kpi-sub">${k.sub}</div></div>`).join('');
}

function renderMonthBars(d){
  const byM={};
  d.forEach(r=>{const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k])byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;});
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('month-bars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt,h=Math.max(3,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2,hmt=h-hmk;
    return `<div class="mbar-col"><div class="mbar-wrap">
      <div class="mbar" style="height:${hmt}px;background:var(--mt-mid);opacity:.8" data-tip="${v.lbl}: ${clp(tot)}"></div>
      <div class="mbar" style="height:${hmk}px;background:var(--mk)" data-tip="${v.lbl}: ${clp(tot)}"></div>
    </div><div class="mbar-lbl">${v.lbl}</div></div>`;
  }).join('');
  document.getElementById('month-legend').innerHTML=`
    <div class="leg"><div class="leg-dot" style="background:var(--mk)"></div>MemoKoala</div>
    <div class="leg"><div class="leg-dot" style="background:var(--mt-mid)"></div>Montana</div>`;
}

function renderCanal(d){
