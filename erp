    const avg=pavg(row.mv);
    html+=`<tr class="compact"><td>${row.concepto}</td>${tds}<td class="td-tot">${avg.toFixed(1)}%</td></tr>`;
  });

  // Métricas por marca×canal — UNA fila con ambos datos
  html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:#263238">▶ MARCA × CANAL</td></tr>`;
