function parsePnL(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<3)return{meses:[],rows:[]};
  let hi=-1;
  for(let i=0;i<Math.min(lines.length,6);i++){if(lines[i].toUpperCase().includes('CONCEPTO')){hi=i;break;}}
  if(hi===-1)hi=2;
  const hc=scsv(lines[hi]).slice(2).map(m=>m.trim()).filter(m=>m);
  const meses=hc.slice(0,-1);
  const rows=[];
  for(let i=hi+1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<3)continue;
    const concepto=fenc(c[0]?.trim()||''),cat=fenc(c[1]?.trim()||'');
    if(!concepto)continue;
    const av=c.slice(2);
    const mv=av.slice(0,-1).map(v=>ppnl(v));
    while(mv.length<meses.length)mv.push(0);
    rows.push({concepto,cat,mv});
  }
  return{meses,rows};
}

function fenc(s){
  return s.replace(/â–¶/g,'▶').replace(/â€"/g,'—').replace(/Ã©/g,'é')
    .replace(/Ã³/g,'ó').replace(/Ã­/g,'í').replace(/Ã¡/g,'á')
    .replace(/Ã±/g,'ñ').replace(/Ã"/g,'Ó').replace(/Ã‰/g,'É');
}
function ppnl(v){
  if(!v&&v!==0)return 0;
  const s=String(v).trim();
  if(s.endsWith('%'))return parseFloat(s.replace('%','').replace(',','.'))||0;
  let n=s.replace(/[$\s"]/g,'');
  if(!n)return 0;
  const dots=(n.match(/\./g)||[]).length,commas=(n.match(/,/g)||[]).length;
  if(commas>=1&&dots===0)n=n.replace(/,/g,'');
  else if(commas===1&&dots===1)n=n.replace(',','');
  else if(commas===0&&dots>1)n=n.replace(/\./g,'');
  return parseFloat(n)||0;
}

function getIdx(){
  const{meses}=PNL;if(!meses.length)return{idxs:[],labels:[]};
  const ord=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  if(pnlPer==='corrido'){
    const idx=meses.map((m,i)=>({m,i})).sort((a,b)=>{
      const ya=parseInt('20'+a.m.slice(-2)),yb=parseInt('20'+b.m.slice(-2));
      if(ya!==yb)return ya-yb;
      return ord.indexOf(a.m.slice(0,3).toLowerCase())-ord.indexOf(b.m.slice(0,3).toLowerCase());
    }).slice(-12);
    return{idxs:idx.map(x=>x.i),labels:idx.map(x=>x.m)};
  }
  const idxs=[],labels=[],ys=pnlPer.slice(2);
  meses.forEach((m,i)=>{if(m.slice(-2)===ys){idxs.push(i);labels.push(m);}});
  return{idxs,labels};
}

function buildPers(){
  const years=[...new Set(PNL.meses.map(m=>m.slice(-2)))].sort();
  const opts=[{id:'corrido',lbl:'Últimos 12m'},...years.map(y=>({id:'20'+y,lbl:'20'+y}))];
  document.getElementById('pnl-periods').innerHTML='<span class="flbl" style="margin-right:4px">Período</span>'+
    opts.map(p=>`<button class="ppill${p.id===pnlPer?' on':''}" onclick="setPer('${p.id}',this)">${p.lbl}</button>`).join('');
}
function setPer(id,el){
  pnlPer=id;
  document.querySelectorAll('.ppill').forEach(p=>p.classList.remove('on'));
  el.classList.add('on');renderPnL();
}

