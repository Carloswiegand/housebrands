    Object.entries(ch).map(([k,v])=>{const p=v.vb>0?v.mb/v.vb:0;return`<div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;margin-bottom:4px"><span style="color:var(--gray)">${k}</span><span style="color:${mColor(p*100)};font-weight:500">${pct(p)}</span></div>`;}).join('');
}

function renderMarca(d){
