// ── KPIs PRINCIPALES ──────────────────────────────────
function rKPIs(d){
  const vb=sum(d,'vb'),mb=sum(d,'mb'),icn=sum(d,'icn'),comision=sum(d,'comision');
  const un=d.reduce((s,r)=>s+r.qty,0),cnt=d.length;
  const tk=un>0?vb/un:0,mrg=vb>0?mb/vb:0;
  const meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses,gap=avg/META-1;
  const mc=mrg>=.65?'pos':mrg>=.45?'warn':'neg';

  const byM={};
  d.forEach(r=>{const k=r.anio+'-'+String(r.mes).padStart(2,'0');byM[k]=(byM[k]||0)+r.vb;});
  const spk=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0])).slice(-8).map(([,v])=>v);
  const sm=Math.max(...spk,1);
  const mkS=(c)=>spk.map(v=>`<div class="ksbar" style="height:${Math.max(10,(v/sm)*100)}%;background:${c}"></div>`).join('');

  document.getElementById('kgrid').innerHTML=[
    {lbl:'VENTA BRUTA',num:clp(vb),sub:cnt+' órdenes · '+un+' uds',
     delta:gap>=0?{c:'d-pos',t:'↑ +'+Math.abs(gap*100).toFixed(1)+'% vs meta'}:{c:'d-neg',t:'↓ '+Math.abs(gap*100).toFixed(1)+'% vs meta'},
     acc:'#8AA4B4',spk:'#D6E4EC'},
    {lbl:'INGRESO NETO COM.',num:clp(icn),sub:'venta − comisiones pasarela',
     delta:{c:'d-neu',t:(vb>0?(comision/vb*100).toFixed(1):0)+'% en comisiones'},
     acc:'#4A6274',spk:'#8AA4B4'},
    {lbl:'MARGEN BRUTO',num:(mrg*100).toFixed(1)+'%',numcls:mc,sub:clp(mb)+' · pvp − costo×1.19',
     delta:mrg>=.65?{c:'d-pos',t:'Saludable'}:mrg>=.45?{c:'d-warn',t:'OK'}:{c:'d-neg',t:'Revisar'},
     acc:'#3d7a62',spk:'#3d7a62'},
    {lbl:'TICKET PROMEDIO',num:clp(tk),sub:'por unidad vendida',
     delta:{c:'d-neu',t:meses+' mes'+(meses>1?'es':'')},
     acc:'#b85a2a',spk:'#b85a2a'},
  ].map(k=>`<div class="kcard">
    <div class="kcard-accent" style="background:${k.acc}"></div>
    <div class="kcard-label">${k.lbl}</div>
    <div class="kcard-num${k.numcls?' '+k.numcls:''}">${k.num}</div>
    <div class="kcard-sub">${k.sub}</div>
    <div class="kdelta ${k.delta.c}">${k.delta.t}</div>
    <div class="kspark">${mkS(k.spk)}</div>
  </div>`).join('');
}

// ── KPIs ANÁLISIS ─────────────────────────────────────
function rKPIs2(d){
  if(!d.length){document.getElementById('kgrid2').innerHTML='';return;}
  const mes=parseInt(document.getElementById('f-mes').value)||0;

  // Mejor día del período
  const byDay={};
  d.forEach(r=>{
    if(!r.fecha)return;
    const dayKey=r.fecha.slice(0,10);
    if(!byDay[dayKey])byDay[dayKey]={vb:0,skus:{}};
    byDay[dayKey].vb+=r.vb;
    byDay[dayKey].skus[r.sku||r.prod]=(byDay[dayKey].skus[r.sku||r.prod]||0)+r.vb;
  });
  const bestDay=Object.entries(byDay).sort((a,b)=>b[1].vb-a[1].vb)[0];
  const bestDayTxt=bestDay?bestDay[0].slice(8)+'/'+bestDay[0].slice(5,7):'-';
  const bestDayVb=bestDay?bestDay[1].vb:0;
  const bestDaySku=bestDay?Object.entries(bestDay[1].skus).sort((a,b)=>b[1]-a[1])[0]?.[0]||'-':'-';

  // Velocidad de venta (uds/día)
  const dias=Object.keys(byDay).length||1;
  const totalUn=d.reduce((s,r)=>s+r.qty,0);
  const velDia=(totalUn/dias).toFixed(1);

  // Concentración top 3 SKUs
  const bySku={};
  d.forEach(r=>{bySku[r.sku||r.prod]=(bySku[r.sku||r.prod]||0)+r.vb;});
  const sortedSku=Object.values(bySku).sort((a,b)=>b-a);
  const top3=sortedSku.slice(0,3).reduce((s,v)=>s+v,0);
  const vbTot=sum(d,'vb')||1;
  const concPct=(top3/vbTot*100).toFixed(0);

  // Días sin venta (solo si hay mes seleccionado)
  let sinVentaTxt='—', sinVentaSub='selecciona un mes';
  if(mes>0){
    const anio=parseInt(document.getElementById('f-anio').value)||new Date().getFullYear();
    const diasMes=new Date(anio,mes,0).getDate();
    const diasConVenta=new Set(d.map(r=>r.fecha?.slice(8,10)).filter(Boolean)).size;
    const sinVenta=diasMes-diasConVenta;
    sinVentaTxt=sinVenta.toString();
    sinVentaSub='de '+diasMes+' días del mes';
  }

  // Tasa de comisión efectiva
  const tasaSH=d.filter(r=>r.canal==='Shopify');
  const tasaML=d.filter(r=>r.canal==='ML');
  const pctSH=sum(tasaSH,'vb')>0?(sum(tasaSH,'comision')/sum(tasaSH,'vb')*100).toFixed(1)+'%':'—';
  const pctML=sum(tasaML,'vb')>0?(sum(tasaML,'comision')/sum(tasaML,'vb')*100).toFixed(1)+'%':'—';

  document.getElementById('kgrid2').innerHTML=[
    {lbl:'MEJOR DÍA',num:bestDayTxt,sub:clp(bestDayVb)+' · top SKU: '+(bestDaySku||'—').slice(0,8),delta:{c:'d-neu',t:'en el período'},acc:'#2563a8'},
    {lbl:'VELOCIDAD VENTA',num:velDia+' uds/día',sub:totalUn+' uds en '+dias+' días con venta',delta:{c:'d-neu',t:'promedio período'},acc:'#4A6274'},
    {lbl:'CONCENTRACIÓN TOP 3',num:concPct+'%',sub:'de venta en 3 SKUs principales',delta:parseInt(concPct)>70?{c:'d-warn',t:'⚠ Alta dependencia'}:{c:'d-pos',t:'Bien diversificado'},acc:'#b07d10'},
    {lbl:'DÍAS SIN VENTA',num:sinVentaTxt,sub:sinVentaSub,delta:{c:'d-neu',t:'selecciona mes para dato'},acc:'#8AA4B4'},
    {lbl:'COMISIÓN EFECTIVA',num:pctSH,sub:'Shopify · ML: '+pctML,delta:{c:'d-neu',t:'% comisión / venta bruta'},acc:'#9a6f00'},
  ].map(k=>`<div class="kcard">
    <div class="kcard-accent" style="background:${k.acc}"></div>
    <div class="kcard-label">${k.lbl}</div>
    <div class="kcard-num">${k.num}</div>
    <div class="kcard-sub">${k.sub}</div>
    <div class="kdelta ${k.delta.c}">${k.delta.t}</div>
  </div>`).join('');
}

