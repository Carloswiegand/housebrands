<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HouseBrands · ERP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0d0f14;
  --bg1:#13161e;
  --bg2:#181c26;
  --bg3:#1e2330;
  --line:#ffffff0f;
  --line2:#ffffff18;
  --txt:#e8eaf0;
  --txt2:#8892a4;
  --txt3:#4a5568;
  --mk:#3ecf8e;
  --mk-dim:#1a3d2e;
  --mt:#f4a261;
  --mt-dim:#3d2410;
  --sh:#4a9eff;
  --sh-dim:#0f2a4a;
  --ml:#f5c842;
  --ml-dim:#3a2e08;
  --pos:#3ecf8e;
  --pos-dim:#0d2a1e;
  --neg:#f87171;
  --neg-dim:#2a0f0f;
  --warn:#f5c842;
  --warn-dim:#2a2408;
  --f:'Inter',sans-serif;
  --mono:'JetBrains Mono',monospace;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--txt);font-family:var(--f);font-size:13px;min-height:100vh;-webkit-font-smoothing:antialiased}

/* ── LOGIN ── */
#login{position:fixed;inset:0;z-index:999;background:var(--bg);display:flex;align-items:center;justify-content:center}
.lbox{width:320px;display:flex;flex-direction:column;gap:24px}
.llogo{display:flex;align-items:center;gap:10px}
.lmark{font-size:15px;font-weight:600;letter-spacing:-0.02em;color:#fff}
.lmark b{color:var(--txt3);font-weight:400}
.ltag{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.1em}
.linput{width:100%;background:var(--bg2);border:1px solid var(--line2);border-radius:6px;padding:10px 14px;color:var(--txt);font-family:var(--mono);font-size:13px;outline:none;transition:border .2s}
.linput:focus{border-color:var(--sh)}
.lbtn{width:100%;background:var(--bg3);border:1px solid var(--line2);border-radius:6px;padding:11px;color:var(--txt);font-family:var(--f);font-size:13px;font-weight:500;cursor:pointer;transition:background .2s}
.lbtn:hover{background:var(--bg2);border-color:var(--line2)}
.lerr{font-family:var(--mono);font-size:11px;color:var(--neg);text-align:center;display:none}

/* ── APP ── */
#app{display:none}

/* ── TOPBAR ── */
.topbar{
  background:var(--bg1);
  border-bottom:1px solid var(--line);
  height:48px;padding:0 20px;
  display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:100;
}
.tmark{font-size:13px;font-weight:600;letter-spacing:-0.02em;color:#fff}
.tmark b{color:var(--txt3);font-weight:400}
.tright{display:flex;align-items:center;gap:8px}
.tchip{font-family:var(--mono);font-size:10px;color:var(--txt3);background:var(--bg2);border:1px solid var(--line);border-radius:4px;padding:3px 8px}
.tbtn{font-family:var(--mono);font-size:10px;color:var(--txt3);background:transparent;border:1px solid var(--line);border-radius:4px;padding:3px 10px;cursor:pointer;transition:all .15s}
.tbtn:hover{color:var(--txt);border-color:var(--line2)}

/* ── TABS ── */
.tabbar{background:var(--bg1);border-bottom:1px solid var(--line);padding:0 20px;display:flex}
.tab{font-family:var(--mono);font-size:10px;color:var(--txt3);padding:10px 16px;cursor:pointer;border-bottom:2px solid transparent;letter-spacing:0.04em;transition:all .15s}
.tab:hover{color:var(--txt2)}
.tab.on{color:#fff;border-bottom-color:var(--sh)}

/* ── FILTROS ── */
.fbar{background:var(--bg1);border-bottom:1px solid var(--line);padding:8px 20px;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.flbl{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.08em;margin-right:2px}
.fsel{background:var(--bg2);border:1px solid var(--line2);border-radius:5px;color:var(--txt2);font-family:var(--mono);font-size:10px;padding:4px 8px;height:26px;outline:none;cursor:pointer}
.fpill{font-family:var(--mono);font-size:10px;padding:3px 10px;border-radius:20px;border:1px solid var(--line);background:transparent;color:var(--txt3);cursor:pointer;transition:all .15s;white-space:nowrap}
.fpill:hover{border-color:var(--line2);color:var(--txt2)}
.fpill.on{background:var(--bg3);border-color:var(--line2);color:#fff}
.fpill.mk{background:var(--mk-dim);border-color:#2a6e50;color:var(--mk)}
.fpill.mt{background:var(--mt-dim);border-color:#6e4020;color:var(--mt)}
.fsep{width:1px;height:14px;background:var(--line);margin:0 2px;flex-shrink:0}

/* ── GRID KPI ── */
.kgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}
.kblock{background:var(--bg1);padding:20px 22px;position:relative;overflow:hidden}
.klbl{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.08em;margin-bottom:10px}
.knum{font-size:32px;font-weight:500;letter-spacing:-0.04em;line-height:1;color:#fff;margin-bottom:6px}
.knum.pos{color:var(--pos)}
.knum.warn{color:var(--warn)}
.knum.neg{color:var(--neg)}
.ksub{font-family:var(--mono);font-size:10px;color:var(--txt3);margin-bottom:8px}
.kdelta{display:inline-flex;align-items:center;gap:3px;font-family:var(--mono);font-size:10px;padding:2px 8px;border-radius:4px;font-weight:500}
.d-pos{background:var(--pos-dim);color:var(--pos)}
.d-neg{background:var(--neg-dim);color:var(--neg)}
.d-neu{background:var(--bg3);color:var(--txt3)}
.kspark{display:flex;align-items:flex-end;gap:2px;height:22px;margin-top:10px}
.ksbar{flex:1;border-radius:1px 1px 0 0;min-height:2px;opacity:0.5;transition:opacity .15s}
.kblock:hover .ksbar{opacity:0.8}

/* ── BODY GRID ── */
.body{padding:0}
.row2{display:grid;grid-template-columns:1.6fr 1fr;gap:1px;background:var(--line);border-top:1px solid var(--line)}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--line);border-top:1px solid var(--line)}
.panel{background:var(--bg1);padding:18px 20px}
.ptitle{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.08em;margin-bottom:14px}

/* ── BARRAS MENSUALES ── */
.mbars{display:flex;align-items:flex-end;gap:3px;height:100px}
.mbc{flex:1;display:flex;flex-direction:column;align-items:center;gap:0}
.mbw{flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%}
.mbs{width:100%;min-height:2px;cursor:pointer;position:relative}
.mbs:first-child{border-radius:2px 2px 0 0}
.mbl{font-family:var(--mono);font-size:7px;color:var(--txt3);margin-top:4px;text-align:center}
.leg{display:flex;gap:10px;margin-top:10px}
.legi{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:9px;color:var(--txt3)}
.legd{width:8px;height:8px;border-radius:1px}

/* ── CANAL ── */
.canal-row{margin-bottom:16px}
.canal-row:last-of-type{margin-bottom:0}
.canal-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px}
.canal-name{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.06em}
.canal-num{font-size:28px;font-weight:500;letter-spacing:-0.04em;color:#fff}
.canal-track{height:3px;background:var(--bg3);border-radius:2px;overflow:hidden;margin-bottom:3px}
.canal-fill{height:100%;border-radius:2px}
.canal-sub{font-family:var(--mono);font-size:9px;color:var(--txt3)}

/* ── KPI ENVÍO ── */
.envio-num{font-size:40px;font-weight:500;letter-spacing:-0.05em;color:var(--warn);line-height:1;margin-bottom:6px}
.envio-sub{font-family:var(--mono);font-size:9px;color:var(--txt3);line-height:1.6}

/* ── TABLA SKU ── */
.tpanel{background:var(--bg1);border-top:1px solid var(--line)}
.thead-row{padding:10px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.thtitle{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.08em}
.thmeta{font-family:var(--mono);font-size:9px;color:var(--txt3)}
.tscroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:11px}
th{padding:7px 14px;text-align:right;font-family:var(--mono);font-size:8px;color:var(--txt3);font-weight:400;letter-spacing:0.06em;border-bottom:1px solid var(--line);white-space:nowrap;background:var(--bg1)}
th:first-child,th:nth-child(2){text-align:left}
td{padding:9px 14px;text-align:right;color:var(--txt2);border-bottom:1px solid var(--line)}
td:first-child{text-align:left;color:#fff;font-weight:500}
td:nth-child(2){text-align:left;color:var(--txt2)}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--bg2)}
.bdg{display:inline-block;font-family:var(--mono);font-size:9px;padding:1px 7px;border-radius:3px}
.b-mk{background:var(--mk-dim);color:var(--mk)}
.b-mt{background:var(--mt-dim);color:var(--mt)}
.b-sh{background:var(--sh-dim);color:var(--sh)}
.b-ml{background:var(--ml-dim);color:var(--ml)}
.mrg-cell{display:flex;align-items:center;gap:6px;justify-content:flex-end}
.mbar{width:36px;height:2px;background:var(--bg3);border-radius:2px;overflow:hidden}
.mfill{height:100%;border-radius:2px}
.neg-val{color:var(--neg)}
.pos-val{color:var(--pos);font-weight:500}

/* ── P&L ── */
.pnl-period{background:var(--bg1);border-bottom:1px solid var(--line);padding:8px 20px;display:flex;gap:6px;align-items:center}
.ppill{font-family:var(--mono);font-size:10px;padding:3px 12px;border-radius:20px;border:1px solid var(--line);background:transparent;color:var(--txt3);cursor:pointer;transition:all .15s}
.ppill:hover{border-color:var(--line2);color:var(--txt2)}
.ppill.on{background:var(--bg3);border-color:var(--line2);color:#fff}
.pnl-table{border-collapse:collapse;width:100%;min-width:900px;font-size:10px}
.pnl-table th{font-family:var(--mono);font-size:8px;color:var(--txt3);padding:6px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap;background:var(--bg1);font-weight:400;letter-spacing:0.06em;position:sticky;top:0}
.pnl-table th:first-child{text-align:left;min-width:180px;position:sticky;left:0;z-index:2}
.pnl-table th:nth-child(2){text-align:left;min-width:80px}
.pnl-table th.th-tot{background:var(--bg2);color:#fff;font-weight:500}
.pnl-table td{font-family:var(--mono);font-size:10px;padding:5px 10px;text-align:right;border-bottom:1px solid var(--line);color:var(--txt2)}
.pnl-table td:first-child{text-align:left;position:sticky;left:0;background:var(--bg1);z-index:1;color:var(--txt)}
.pnl-table td:nth-child(2){text-align:left;color:var(--txt3);font-size:9px}
.pnl-table td.td-tot{background:var(--bg2);color:#fff;font-weight:500}
.pnl-table tr:hover td{background:var(--bg2)}
.pnl-table tr:hover td:first-child{background:var(--bg2)}
.pnl-table tr.bold td{color:#fff;font-weight:500}
.pnl-table tr.shdr td{font-family:var(--mono);font-size:8px;font-weight:500;letter-spacing:0.1em;padding:4px 10px;border:none;color:rgba(255,255,255,0.7)}
.pnl-table tr.shdr td:first-child{position:sticky;left:0;z-index:1}

/* ── HISTÓRICO ── */
.hbtn{font-family:var(--mono);font-size:11px;padding:7px 18px;border-radius:4px;border:1px solid var(--line);background:transparent;color:var(--txt3);cursor:pointer;transition:all .15s}
.hbtn:hover{border-color:var(--line2);color:var(--txt2)}
.hbtn.on{background:var(--bg3);border-color:var(--line2);color:#fff}

/* ── CHECKLIST MODAL ── */
#cl-modal{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.7);overflow-y:auto;padding:40px 20px}
.cl-box{max-width:580px;margin:0 auto;background:var(--bg1);border:1px solid var(--line2);border-radius:8px;overflow:hidden}
.cl-head{background:var(--bg2);padding:16px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}
.cl-htitle{font-size:13px;font-weight:500;color:#fff}
.cl-close{background:transparent;border:1px solid var(--line);color:var(--txt3);border-radius:4px;padding:4px 12px;cursor:pointer;font-family:var(--mono);font-size:11px}
.cl-prog-wrap{height:2px;background:var(--bg3);margin:0}
.cl-prog{height:100%;background:var(--sh);transition:width .3s}
.cl-body{padding:20px}
.cl-section{margin-bottom:20px}
.cl-stitle{font-family:var(--mono);font-size:9px;color:var(--txt3);letter-spacing:0.1em;margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid var(--line)}
.cl-item{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:4px;cursor:pointer;transition:background .1s;margin-bottom:2px}
.cl-item:hover{background:var(--bg2)}
.cl-cb{width:16px;height:16px;border:1.5px solid var(--line2);border-radius:3px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cl-item.done .cl-cb{background:var(--sh);border-color:var(--sh)}
.cl-item.done .cl-cb::after{content:'✓';color:#fff;font-size:10px;font-weight:700}
.cl-item.done .cl-lbl{text-decoration:line-through;color:var(--txt3)}
.cl-lbl{font-size:12px;font-weight:500;color:var(--txt);margin-bottom:2px}
.cl-sub{font-family:var(--mono);font-size:10px;color:var(--txt3);line-height:1.5}
.cl-warn{font-family:var(--mono);font-size:10px;color:var(--warn);margin-top:3px}
.cl-reset{font-family:var(--mono);font-size:10px;background:var(--bg2);border:1px solid var(--line);border-radius:4px;padding:6px 14px;cursor:pointer;color:var(--txt3)}

/* ── LOADING ── */
.spin{text-align:center;padding:60px 0;font-family:var(--mono);font-size:11px;color:var(--txt3)}
.dots{display:inline-flex;gap:5px;margin-bottom:12px}
.dot{width:5px;height:5px;border-radius:50%;background:var(--txt3);animation:blink 1.2s ease-in-out infinite}
.dot:nth-child(2){animation-delay:.2s}
.dot:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:.2;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .kgrid{grid-template-columns:1fr 1fr}
  .row2,.row3{grid-template-columns:1fr}
  .topbar,.fbar,.tabbar{padding-left:12px;padding-right:12px}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login">
  <div class="lbox">
    <div>
      <div class="llogo">
        <svg width="24" height="24" viewBox="0 0 36 36" fill="none">
          <polygon points="0,0 17,0 17,17" fill="#fff"/>
          <polygon points="17,0 36,0 36,17 17,17" fill="#4a5568"/>
          <polygon points="0,19 17,19 17,36 0,36" fill="#4a5568"/>
          <polygon points="17,19 36,36 17,36" fill="#2d3748"/>
        </svg>
        <span class="lmark">House<b>Brands</b></span>
      </div>
      <div class="ltag" style="margin-top:8px">ERP — Acceso interno</div>
    </div>
    <div>
      <div style="font-family:var(--mono);font-size:9px;color:var(--txt3);margin-bottom:6px;letter-spacing:0.08em">Contraseña</div>
      <input type="password" id="pwd" class="linput" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="lbtn" onclick="doLogin()">Entrar</button>
    <div class="lerr" id="lerr">Contraseña incorrecta</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <div class="topbar">
    <div class="tmark">House<b>Brands</b> <span style="color:var(--txt3);font-size:10px;margin-left:8px;font-weight:300">ERP</span></div>
    <div class="tright">
      <span class="tchip" id="tc-usd">USD —</span>
      <span class="tchip" id="tc-uf">UF —</span>
      <span class="tchip" id="tc-act" style="color:var(--txt3)">—</span>
      <button class="tbtn" onclick="showCL()">☑ Checklist</button>
      <button class="tbtn" onclick="doLogout()">Salir</button>
    </div>
  </div>

  <div class="tabbar">
    <div class="tab on" id="tab-ventas" onclick="goTab('ventas')">Ventas</div>
    <div class="tab" id="tab-pnl" onclick="goTab('pnl')">P&amp;L</div>
    <div class="tab" id="tab-hist" onclick="goTab('hist')">Histórico</div>
  </div>

  <!-- ── TAB VENTAS ── -->
  <div id="view-ventas">
    <div class="fbar">
      <span class="flbl">Período</span>
      <select class="fsel" id="f-anio" onchange="render()"><option value="0">Todo</option></select>
      <select class="fsel" id="f-mes" onchange="render()">
        <option value="0">Todos los meses</option>
        <option value="1">Ene</option><option value="2">Feb</option><option value="3">Mar</option>
        <option value="4">Abr</option><option value="5">May</option><option value="6">Jun</option>
        <option value="7">Jul</option><option value="8">Ago</option><option value="9">Sep</option>
        <option value="10">Oct</option><option value="11">Nov</option><option value="12">Dic</option>
      </select>
      <div class="fsep"></div>
      <span class="flbl">Marca</span>
      <button class="fpill on" id="fm-t" onclick="sfm('Todas',this)">Todas</button>
      <button class="fpill" id="fm-mk" onclick="sfm('MemoKoala',this)">MemoKoala</button>
      <button class="fpill" id="fm-mt" onclick="sfm('Montana',this)">Montana</button>
      <div class="fsep"></div>
      <span class="flbl">Canal</span>
      <button class="fpill on" id="fc-t" onclick="sfc('Todos',this)">Todos</button>
      <button class="fpill" id="fc-sh" onclick="sfc('Shopify',this)">Shopify</button>
      <button class="fpill" id="fc-ml" onclick="sfc('ML',this)">MercadoLibre</button>
    </div>

    <div id="v-loading" class="spin"><div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div><div>Cargando ventas...</div></div>
    <div id="v-dash" style="display:none">
      <!-- KPIs -->
      <div class="kgrid" id="kgrid"></div>

      <!-- Charts row -->
      <div class="row2">
        <div class="panel">
          <div class="ptitle">Venta bruta mensual</div>
          <div class="mbars" id="mbars"></div>
          <div class="leg" id="mleg"></div>
        </div>
        <div class="panel">
          <div class="ptitle">Canal y margen</div>
          <div id="canal-content"></div>
          <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line)">
            <div class="ptitle" style="margin-bottom:10px">Subsidio despacho RM</div>
            <div class="envio-num" id="envio-pct">—</div>
            <div class="envio-sub">% costo envío neto / venta bruta<br><span id="envio-detalle" style="color:var(--txt3)"></span></div>
          </div>
        </div>
      </div>

      <!-- Tabla SKU -->
      <div class="tpanel">
        <div class="thead-row">
          <span class="thtitle">Rentabilidad por SKU</span>
          <span class="thmeta" id="sku-meta"></span>
        </div>
        <div class="tscroll">
          <table>
            <thead><tr>
              <th>SKU</th><th>Producto</th><th>Marca</th><th>Canal</th>
              <th>Uds</th><th>Venta bruta</th><th>Comisión</th>
              <th>Ingreso neto</th><th>COGS</th><th>Margen $</th><th>Margen %</th>
            </tr></thead>
            <tbody id="sku-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ── TAB P&L ── -->
  <div id="view-pnl" style="display:none">
    <div class="pnl-period" id="pnl-periods"></div>
    <div id="pnl-loading" class="spin"><div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div><div>Cargando P&L...</div></div>
    <div id="pnl-dash" style="display:none">
      <div class="kgrid" id="pnl-kgrid"></div>
      <div class="row2">
        <div class="panel">
          <div class="ptitle">Resultado neto mensual</div>
          <div class="mbars" id="pnl-bars" style="height:100px"></div>
          <div class="leg"><div class="legi"><div class="legd" style="background:var(--pos)"></div>Positivo</div><div class="legi"><div class="legd" style="background:var(--neg)"></div>Negativo</div></div>
        </div>
        <div class="panel">
          <div class="ptitle">Breakdown gastos</div>
          <div id="gasto-bars"></div>
        </div>
      </div>
      <div class="row3">
