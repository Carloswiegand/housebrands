      </div>`;
    }).join('');
  };
  renderCanalMrg('MemoKoala × Shopify','MemoKoala × MercadoLibre','pnl-mk-canal');
  renderCanalMrg('Montana × Shopify','Montana × MercadoLibre','pnl-mt-canal');

  // Tabla completa
  renderPnLTable(idxs,labels,false);
}

function renderPnLTable(idxs,labels,compact){
  const {rows}=PNL_RAW;

  const SECTION_COLORS={
    'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100',
    'MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E',
    'RESULTADO':'#111111','METRICAS':'#37474F','MARCA':'#263238'
  };

  const getSectionColor=concepto=>{
    const u=concepto.toUpperCase();
    for(const[k,v] of Object.entries(SECTION_COLORS)){
      if(u.includes(k)) return v;
    }
    return '#333';
  };

  const isSubhdr=row=>row.concepto.includes('▶')||row.concepto.startsWith('â–¶');
  const isBold=row=>row.concepto.startsWith('TOTAL')||row.concepto.startsWith('VENTA BRUTA TOTAL')||
    row.concepto.startsWith('MARGEN BRUTO TOTAL')||row.concepto.startsWith('RESULTADO NETO')||
    row.concepto.startsWith('VENTA BRUTA TOTAL');
  const isResultado=row=>row.concepto.includes('RESULTADO NETO');
  const isPct=row=>row.concepto.startsWith('%');

  // Format cell value
  const fmtVal=(v,isPctRow)=>{
    if(isPctRow) return v.toFixed(1)+'%';
    return clp(v);
  };
  const cellColor=(v,isRes,isPctRow)=>{
    if(isRes) return v>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700';
    return '';
  };

  // Period sum for total column
  const periodSum=vals=>idxs.reduce((s,i)=>s+(vals[i]||0),0);
  const avgForPct=vals=>{
    const nonZero=idxs.map(i=>vals[i]||0).filter(v=>v!==0);
    return nonZero.length?nonZero.reduce((s,v)=>s+v,0)/nonZero.length:0;
  };

  const thCells=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  let html=`<table class="pnl-table">
    <thead><tr>
      <th>Concepto</th><th>Categoría</th>${thCells}<th class="th-total">Total / Prom.</th>
    </tr></thead><tbody>`;

  rows.forEach(row=>{
    if(isSubhdr(row)){
      const bg=getSectionColor(row.concepto);
      const tdCells=labels.map(()=>`<td style="background:${bg}"></td>`).join('');
      html+=`<tr class="subhdr"><td style="background:${bg};color:#fff">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${tdCells}<td class="td-total" style="background:${bg}"></td></tr>`;
      return;
    }

    const pctRow=isPct(row);
    const resRow=isResultado(row);
    const boldRow=isBold(row);

    const tdCells=idxs.map(i=>{
      const v=row.mesVals[i]||0;
      const style=cellColor(v,resRow,pctRow);
      return `<td style="${style}">${fmtVal(v,pctRow)}</td>`;
    }).join('');

    const totalV=pctRow?avgForPct(row.mesVals):periodSum(row.mesVals);
    const totalStyle=cellColor(totalV,resRow,pctRow);

    html+=`<tr class="${boldRow?'bold':''}">
      <td>${row.concepto}</td>
      <td>${row.categoria}</td>
      ${tdCells}
      <td class="td-total" style="${totalStyle}">${fmtVal(totalV,pctRow)}</td>
    </tr>`;
  });

  html+='</tbody></table>';
  document.getElementById('pnl-table-wrap').innerHTML=html;
}

// ── HISTÓRICO ─────────────────────────────────────────────
async function renderHistorico(){
  if(!pnlLoaded){
    document.getElementById('hist-content').innerHTML='<div class="loading"><div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div><div style="margin-top:12px;font-family:var(--mono);font-size:11px">Cargando P&L...</div></div>';
    await loadPnL();
  }
  const {meses,rows}=PNL_RAW;
  if(!meses.length){
    document.getElementById('hist-content').innerHTML='<div style="font-family:var(--mono);font-size:11px;color:var(--ink-light)">No hay datos de P&L disponibles.</div>';
    return;
  }
  const years=[...new Set(meses.map(m=>'20'+m.slice(-2)))].sort();
  document.getElementById('hist-period-btns').innerHTML=years.map((y,i)=>
    `<button onclick="showHistYear('${y}')" style="font-family:var(--mono);font-size:11px;padding:8px 20px;border-radius:8px;border:1px solid var(--border);background:${i===years.length-1?'var(--ink)':'#fff'};color:${i===years.length-1?'#fff':'var(--ink-mid)'};cursor:pointer">${y}</button>`
  ).join('');
  showHistYear(years[years.length-1]);
}

function showHistYear(year){
  const {meses,rows}=PNL_RAW;
  const idxs=[],labels=[];
  meses.forEach((m,i)=>{if(m.slice(-2)===''+year.slice(2)){idxs.push(i);labels.push(m);}});

  // Render static table
  const thCells=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');
  const isPct=row=>row.concepto.startsWith('%');
  const isSubhdr=row=>row.concepto.includes('▶')||row.concepto.startsWith('â–¶');
  const isBold=row=>row.concepto.startsWith('TOTAL')||row.concepto.startsWith('VENTA BRUTA TOTAL')||row.concepto.startsWith('MARGEN BRUTO TOTAL')||row.concepto.startsWith('RESULTADO');
  const isRes=row=>row.concepto.includes('RESULTADO NETO');
  const fmtV=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const SCOLORS={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#E65100','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#4E342E','RESULTADO':'#111111','METRICAS':'#37474F','MARCA':'#263238'};
  const getC=c=>{const u=c.toUpperCase();for(const[k,v] of Object.entries(SCOLORS)){if(u.includes(k))return v;}return '#333';};
  const periodSum=vals=>idxs.reduce((s,i)=>s+(vals[i]||0),0);
  const avgPct=vals=>{const nz=idxs.map(i=>vals[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};

  let html=`<div class="card"><div class="card-head"><span class="card-title">Estado de Resultados · ${year}</span></div>
  <div class="pnl-wrap"><table class="pnl-table">
  <thead><tr><th>Concepto</th><th>Categoría</th>${thCells}<th class="th-total">Total</th></tr></thead><tbody>`;

  rows.forEach(row=>{
    if(isSubhdr(row)){
      const bg=getC(row.concepto);
      html+=`<tr class="subhdr"><td style="background:${bg};color:#fff">${row.concepto.replace('â–¶','▶')}</td><td style="background:${bg}"></td>${labels.map(()=>`<td style="background:${bg}"></td>`).join('')}<td class="td-total" style="background:${bg}"></td></tr>`;
      return;
    }
    const pRow=isPct(row),bRow=isBold(row),rRow=isRes(row);
    const tds=idxs.map(i=>{const v=row.mesVals[i]||0;const s=rRow?(v>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700'):'';return`<td style="${s}">${fmtV(v,pRow)}</td>`;}).join('');
    const tot=pRow?avgPct(row.mesVals):periodSum(row.mesVals);
    const ts=rRow?(tot>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700'):'';
    html+=`<tr class="${bRow?'bold':''}"><td>${row.concepto}</td><td>${row.categoria}</td>${tds}<td class="td-total" style="${ts}">${fmtV(tot,pRow)}</td></tr>`;
  });

  html+='</tbody></table></div></div>';
  document.getElementById('hist-content').innerHTML=html;
}

// ── VENTAS RENDER ─────────────────────────────────────────
const clp=n=>'$'+Math.round(n).toLocaleString('es-CL');
const pct=n=>(n*100).toFixed(1)+'%';
const mColor=p=>p>=65?'var(--green)':p>=45?'var(--gold)':'var(--red)';

function sf(type,val,el){
  filters[type]=val;
  const groups={m:['fa','fmk','fmt'],c:['fca','fsh','fml'],y:['fya','fy25','fy26'],me:['fma','fm1','fm2','fm3','fm4','fm5','fm6','fm7','fm8','fm9','fm10','fm11','fm12']};
  groups[type].forEach(id=>{const e=document.getElementById(id);if(e)e.className='pill';});
  el.className=val==='MemoKoala'?'pill mk':val==='Montana'?'pill mt':'pill on';
  render();
}
function filtered(){
  return DATA.filter(r=>{
    if(filters.m!=='Todas'&&r.marca!==filters.m) return false;
    if(filters.c!=='Todos'&&r.canal!==filters.c) return false;
    if(filters.y!==0&&r.anio!==filters.y) return false;
    if(filters.me!==0&&r.mes!==filters.me) return false;
    return true;
  });
}
function render(){
  const d=filtered();
  renderKPIs(d);renderMonthBars(d);renderCanal(d);renderMarca(d);renderProdBars(d);renderRecentTx(d);renderSkuTable(d);
}

function renderKPIs(d){
  const vb=d.reduce((s,r)=>s+r.vb,0),mb=d.reduce((s,r)=>s+r.mb,0);
  const un=d.reduce((s,r)=>s+r.qty,0),cnt=d.length;
  const tk=un>0?vb/un:0,mrg=vb>0?mb/vb:0;
  const META=14969250,meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses,gap=avg/META-1;
  const kpis=[
    {lbl:'Venta Bruta',val:clp(vb),sub:cnt+' trans · '+un+' uds',tag:gap>=0?'↑ +'+Math.abs(gap*100).toFixed(1)+'% meta':'↓ '+Math.abs(gap*100).toFixed(1)+'% meta',cls:gap>=0?'tag-up':'tag-dn',accent:'#3d7a62'},
    {lbl:'Margen Bruto $',val:clp(mb),sub:pct(mrg)+' sobre venta',tag:mrg>=.65?'Saludable':mrg>=.45?'OK':'Revisar',cls:mrg>=.65?'tag-up':mrg>=.45?'tag-n':'tag-dn',accent:'#c9a227'},
    {lbl:'Ticket Promedio',val:clp(tk),sub:'por unidad',tag:'',cls:'',accent:'#1a3a5c'},
    {lbl:'Unidades',val:un.toLocaleString('es-CL'),sub:meses+' mes'+(meses>1?'es':''),tag:'',cls:'',accent:'#b85a2a'},
    {lbl:'Prom. Mensual',val:clp(avg),sub:'meta: '+clp(META),tag:gap>=0?'↑ Sobre meta':'↓ Bajo meta',cls:gap>=0?'tag-up':'tag-dn',accent:'#5a2a8a'},
    {lbl:'Costo Total',val:clp(d.reduce((s,r)=>s+r.costo,0)),sub:'importación',tag:'',cls:'',accent:'#4a4540'},
  ];
  document.getElementById('kpi-grid').innerHTML=kpis.map(k=>`
    <div class="kpi fade-up" style="--accent:${k.accent}">
      <div class="kpi-label">${k.lbl}</div>
      <div class="kpi-val">${k.val}</div>
      ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');
}

function renderMonthBars(d){
  const byM={};
  d.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k]) byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;
  });
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('month-bars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt,h=Math.max(3,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2,hmt=h-hmk;
    return `<div class="mbar-col">
      <div class="mbar-wrap">
        <div class="mbar" style="height:${hmt}px;background:var(--mt-mid);opacity:.8" data-tip="${v.lbl}: ${clp(tot)}"></div>
        <div class="mbar" style="height:${hmk}px;background:var(--mk)" data-tip="${v.lbl}: ${clp(tot)}"></div>
      </div>
      <div class="mbar-lbl">${v.lbl}</div>
    </div>`;
  }).join('');
  document.getElementById('month-legend').innerHTML=`
    <div class="leg"><div class="leg-dot" style="background:var(--mk)"></div>MemoKoala</div>
    <div class="leg"><div class="leg-dot" style="background:var(--mt-mid)"></div>Montana</div>`;
}

function renderCanal(d){
  const ch={};
  d.forEach(r=>{ch[r.canal]=(ch[r.canal]||{vb:0,mb:0,cnt:0});ch[r.canal].vb+=r.vb;ch[r.canal].mb+=r.mb;ch[r.canal].cnt++;});
  const tot=Object.values(ch).reduce((s,v)=>s+v.vb,0)||1;
  const cc={Shopify:'var(--green)',ML:'var(--gold)'};
  document.getElementById('canal-split').innerHTML=Object.entries(ch).map(([k,v])=>`<div style="flex:${v.vb};background:${cc[k]||'#ccc'}"></div>`).join('');
  document.getElementById('canal-detail').innerHTML=Object.entries(ch).map(([k,v])=>`
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div class="leg"><div class="leg-dot" style="background:${cc[k]||'#ccc'}"></div>
      <span class="bdg ${k==='Shopify'?'b-sh':'b-ml'}">${k}</span></div>
      <span style="font-family:var(--mono);font-size:11px">${clp(v.vb)} <span style="color:var(--ink-dim)">${pct(v.vb/tot)}</span></span>
    </div>`).join('');
  document.getElementById('canal-margin').innerHTML='<div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Margen por canal</div>'+
    Object.entries(ch).map(([k,v])=>{const p=v.vb>0?v.mb/v.vb:0;return`<div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;margin-bottom:4px"><span style="color:var(--ink-light)">${k}</span><span style="color:${mColor(p*100)};font-weight:500">${pct(p)}</span></div>`;}).join('');
}

function renderMarca(d){
  const bm={};
  d.forEach(r=>{bm[r.marca]=(bm[r.marca]||{vb:0,mb:0});bm[r.marca].vb+=r.vb;bm[r.marca].mb+=r.mb;});
  const bc={MemoKoala:'var(--mk)',Montana:'var(--mt)'};
  document.getElementById('marca-margen').innerHTML=Object.entries(bm).map(([m,v])=>{
    const p=v.vb>0?v.mb/v.vb:0;
    return `<div style="margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;margin-bottom:6px">
        <span class="bdg ${m==='MemoKoala'?'b-mk':'b-mt'}">${m==='MemoKoala'?'🐨':'🔪'} ${m}</span>
        <span style="font-family:var(--serif);font-size:20px;color:${bc[m]}">${pct(p)}</span>
