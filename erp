function getInvAdjuste(sku){
  try{const adj=JSON.parse(localStorage.getItem('hb_inv_ajustes')||'{}');return adj[sku]||0;}catch(e){return 0;}
}
function saveInvAdjuste(sku,val){
  try{const adj=JSON.parse(localStorage.getItem('hb_inv_ajustes')||'{}');adj[sku]=parseInt(val)||0;localStorage.setItem('hb_inv_ajustes',JSON.stringify(adj));}catch(e){}
}

function calcInvData(){
  const hoy=new Date(),hace90=new Date(hoy);hace90.setDate(hoy.getDate()-90);
  const vendSep={},vend90={};
  DATA.forEach(r=>{
    if(!r.sku||!r.fecha)return;
    const f=new Date(r.fecha);if(isNaN(f.getTime()))return;
    if(f>FECHA_CIERRE)vendSep[r.sku]=(vendSep[r.sku]||0)+r.qty;
    if(f>=hace90)vend90[r.sku]=(vend90[r.sku]||0)+r.qty;
  });
  return Object.keys(STOCK_BASE).map(sku=>{
    const marca=sku.startsWith('MK')||sku==='TO04-4'?'MemoKoala':'Montana';
    const base=STOCK_BASE[sku]||0,vendido=vendSep[sku]||0;
    const ajuste=getInvAdjuste(sku);
    const actual=Math.max(0,base-vendido+ajuste);
    const v90=vend90[sku]||0,vDia=Math.round((v90/90)*100)/100;
    const dias=vDia>0?Math.round(actual/vDia):9999;
    const umbral=60,costo=COSTOS[sku]||0;
    const val=actual*costo*IVA;
    let stato='ok',statoTxt='✅ OK';
    if(dias===9999){stato='none';statoTxt='Sin ventas';}
    else if(dias<umbral/2){stato='crit';statoTxt='🔴 Crítico';}
    else if(dias<umbral){stato='alert';statoTxt='🟠 Alerta';}
    else if(dias<umbral*2){stato='warn';statoTxt='🟡 Revisar';}
    return{sku,marca,actual,base,vendido,ajuste,v90,vDia,dias,umbral,costo,val,stato,statoTxt};
  });
}

