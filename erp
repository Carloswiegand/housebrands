      <div class="canal-track"><div class="canal-fill" style="width:${Math.min(100,mrg*100).toFixed(1)}%;background:${cc[k]||'var(--txt3)'}"></div></div>
      <div class="canal-sub">${clp(v.vb)} bruto · ${(v.vb/tot*100).toFixed(0)}% del total</div>
    </div>`;
  }).join('');

  // Envío cobrado vs costo (solo Shopify)
  const envCobrado=sum(d.filter(r=>r.canal==='Shopify'),'envio');
  // No tenemos ABEE en tiempo real — mostramos recupero como % de venta
  const vbTotal=sum(d,'vb');
