<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HouseBrands · ERP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  /* ── HouseBrands Brand System ── */
  --slate-night:#1C2B3A;
  --slate-dark:#2C3E4C;
  --slate-mid:#4A6274;
  --slate-light:#8AA4B4;
  --slate-pale:#D6E4EC;
  --cream:#F7F6F3;
  --off:#EEECE8;
  --gray:#7A8F9E;
  --line:rgba(28,43,58,0.1);
  --fd:'Instrument Sans',sans-serif;
  --fb:'DM Sans',sans-serif;
  --mono:'DM Mono',monospace;
  /* ── functional ── */
  --mk:#3d7a62;--mk-light:#eaf4ef;--mk-mid:#a8d0bc;
  --mt:#b85a2a;--mt-light:#f7ede6;--mt-mid:#e0a882;
  --gold:#c9a227;--gold-light:#fdf6e3;
  --red:#c0392b;--red-light:#fdecea;
  --green:#27a05a;--green-light:#e8f8ee;
  --border:rgba(28,43,58,0.12);
  --shadow:0 1px 3px rgba(28,43,58,0.06),0 4px 16px rgba(28,43,58,0.04);
}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--slate-night);font-family:var(--fb);font-size:14px;min-height:100vh}

/* ── LOGIN ── */
#login-screen{
  position:fixed;inset:0;z-index:1000;
  background:var(--slate-night);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:0;
}
.login-card{
  background:var(--cream);
  border-radius:4px;
  padding:2.5rem 2rem;
  width:320px;
  display:flex;flex-direction:column;gap:1.5rem;
}
.login-logo{
  display:flex;align-items:center;gap:10px;
  margin-bottom:0.25rem;
}
.login-wordmark{
  font-family:var(--fd);font-size:16px;font-weight:600;
  letter-spacing:-0.025em;color:var(--slate-night);
}
.login-wordmark span{color:var(--slate-mid);}
.login-label{
  font-family:var(--mono);font-size:9px;
  letter-spacing:0.18em;text-transform:uppercase;
  color:var(--gray);
  margin-bottom:0.5rem;
}
.login-field{display:flex;flex-direction:column;gap:6px;}
.login-input{
  background:#fff;
  border:1px solid var(--border);
  border-radius:2px;
  padding:10px 14px;
  color:var(--slate-night);
  font-family:var(--mono);font-size:13px;
  outline:none;width:100%;
  transition:border-color .2s;
}
.login-input:focus{border-color:var(--slate-mid);}
.login-btn{
  background:var(--slate-dark);
  color:var(--cream);
  border:none;border-radius:2px;
  padding:11px;
  font-family:var(--fd);font-size:13px;font-weight:600;
  letter-spacing:-0.01em;
  cursor:pointer;
  transition:background .2s;
}
.login-btn:hover{background:var(--slate-night);}
.login-err{
  font-family:var(--mono);font-size:11px;
  color:var(--red);text-align:center;display:none;
}

/* ── APP ── */
#app{display:none}
.header{
  background:var(--slate-night);
  padding:0 2rem;height:56px;
  display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:100;
  border-bottom:1px solid rgba(255,255,255,0.06);
}
.header-logo{
  display:flex;align-items:center;gap:10px;
  font-family:var(--fd);font-size:15px;font-weight:600;
  letter-spacing:-0.02em;color:var(--cream);
}
.header-logo span{color:var(--slate-light);}
.header-right{display:flex;align-items:center;gap:12px;}
.header-updated{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,0.3);}
.header-btn{
  font-family:var(--mono);font-size:10px;
  color:rgba(255,255,255,0.4);cursor:pointer;
  padding:4px 10px;border:1px solid rgba(255,255,255,0.1);
  border-radius:2px;background:transparent;
  transition:color .2s,border-color .2s;
}
.header-btn:hover{color:var(--cream);border-color:rgba(255,255,255,0.3);}

/* ── TABS ── */
.tabs{
  background:var(--slate-night);
  border-bottom:1px solid rgba(255,255,255,0.08);
  padding:0 2rem;display:flex;gap:0;
}
.tab{
  font-family:var(--mono);font-size:11px;
  color:rgba(255,255,255,0.4);
  padding:10px 20px;cursor:pointer;
  border-bottom:2px solid transparent;
  transition:all .2s;letter-spacing:.5px;text-transform:uppercase;
}
.tab:hover{color:rgba(255,255,255,0.7);}
.tab.active{color:var(--cream);border-bottom-color:var(--slate-light);}

/* ── FILTERS ── */
.filters{
  background:#fff;border-bottom:1px solid var(--border);
  padding:12px 2rem;display:flex;gap:8px;flex-wrap:wrap;align-items:center;
}
.filter-sep{width:1px;height:18px;background:var(--border);margin:0 4px;}
.pill{
  font-family:var(--mono);font-size:10px;
  padding:4px 12px;border-radius:20px;
  border:1px solid var(--border);background:transparent;
  color:var(--gray);cursor:pointer;transition:all .15s;
}
.pill:hover{border-color:var(--slate-light);color:var(--slate-night);}
.pill.on{background:var(--slate-dark);border-color:var(--slate-dark);color:var(--cream);}
.pill.mk{background:var(--mk-light);border-color:var(--mk-mid);color:var(--mk);}
.pill.mt{background:var(--mt-light);border-color:var(--mt-mid);color:var(--mt);}

/* ── MAIN ── */
.main{padding:24px 2rem;max-width:1480px;margin:0 auto;}

/* ── LOADING ── */
.loading{text-align:center;padding:80px 0;font-family:var(--mono);font-size:12px;color:var(--gray);}
.loading-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--slate-mid);margin:0 3px;animation:pulse 1.2s ease-in-out infinite;}
.loading-dot:nth-child(2){animation-delay:.2s;}
.loading-dot:nth-child(3){animation-delay:.4s;}
@keyframes pulse{0%,80%,100%{transform:scale(0);opacity:.3}40%{transform:scale(1);opacity:1}}

/* ── KPI ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:20px;}
.kpi{
  background:#fff;border:1px solid var(--border);
  border-radius:3px;padding:16px 18px;
  box-shadow:var(--shadow);transition:transform .2s;
  position:relative;overflow:hidden;
}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent,var(--border));}
.kpi:hover{transform:translateY(-2px);}
.kpi-label{font-family:var(--mono);font-size:9px;color:var(--gray);text-transform:uppercase;letter-spacing:1.2px;margin-bottom:8px;}
.kpi-val{font-family:var(--fd);font-size:22px;font-weight:700;letter-spacing:-0.03em;color:var(--slate-night);line-height:1;margin-bottom:4px;}
.kpi-sub{font-family:var(--mono);font-size:10px;color:var(--gray);}
.kpi-tag{display:inline-block;font-family:var(--mono);font-size:9px;padding:2px 7px;border-radius:10px;margin-top:6px;}
.tag-up{background:var(--green-light);color:var(--green);}
.tag-dn{background:var(--red-light);color:var(--red);}
.tag-n{background:var(--off);color:var(--gray);}

/* ── GRIDS ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.g3{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px;margin-bottom:16px;}
.g4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;margin-bottom:16px;}

/* ── CARD ── */
.card{background:#fff;border:1px solid var(--border);border-radius:3px;box-shadow:var(--shadow);overflow:hidden;}
.card-head{padding:14px 18px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.card-title{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1.2px;color:var(--gray);}
.card-body{padding:16px 18px;}

/* ── BARS ── */
.month-bars{display:flex;align-items:flex-end;gap:4px;height:110px;}
.mbar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;}
.mbar-wrap{flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%;}
.mbar{border-radius:3px 3px 0 0;width:100%;min-height:2px;cursor:pointer;position:relative;transition:opacity .15s;}
.mbar:hover{opacity:.8;}
.mbar:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 5px);left:50%;transform:translateX(-50%);background:var(--slate-night);color:var(--cream);padding:4px 8px;border-radius:3px;font-family:var(--mono);font-size:10px;white-space:nowrap;z-index:10;pointer-events:none;}
.mbar-lbl{font-family:var(--mono);font-size:7px;color:var(--slate-pale);text-align:center;}
.hbar-chart{display:flex;flex-direction:column;gap:9px;}
.hbar-row{display:flex;align-items:center;gap:10px;}
.hbar-lbl{font-family:var(--mono);font-size:10px;color:var(--gray);width:130px;text-align:right;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hbar-track{flex:1;height:6px;background:var(--off);border-radius:3px;overflow:hidden;}
.hbar-fill{height:100%;border-radius:3px;transition:width .7s cubic-bezier(.34,1.56,.64,1);}
.hbar-val{font-family:var(--mono);font-size:10px;color:var(--slate-night);width:90px;text-align:right;flex-shrink:0;}
.split-bar{height:8px;border-radius:4px;overflow:hidden;display:flex;margin-bottom:12px;}

/* ── TABLE ── */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
thead th{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--gray);border-bottom:1px solid var(--border);white-space:nowrap;}
thead th:first-child{text-align:left;}
tbody tr{border-bottom:1px solid var(--off);transition:background .1s;}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:var(--cream);}
tbody td{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--slate-night);}
tbody td:first-child{text-align:left;color:var(--slate-mid);}
.bdg{display:inline-block;font-size:9px;padding:1px 6px;border-radius:8px;font-family:var(--mono);}
.b-mk{background:var(--mk-light);color:var(--mk);}
.b-mt{background:var(--mt-light);color:var(--mt);}
.b-sh{background:var(--green-light);color:var(--green);}
.b-ml{background:var(--gold-light);color:var(--gold);}
.mrg-bar{display:flex;align-items:center;gap:5px;justify-content:flex-end;}
.mrg-mini{width:32px;height:3px;background:var(--off);border-radius:2px;overflow:hidden;}
.mrg-fill{height:100%;border-radius:2px;}

/* ── LEGEND ── */
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;}
.leg{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:9px;color:var(--gray);}
.leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}

/* ── PNL TABLE ── */
.pnl-wrap{overflow-x:auto;width:100%;}
.pnl-table{border-collapse:collapse;width:100%;min-width:900px;}
.pnl-table th{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:.6px;color:var(--gray);padding:7px 10px;text-align:right;border-bottom:2px solid var(--border);white-space:nowrap;background:#fff;position:sticky;top:0;}
.pnl-table th:first-child{text-align:left;min-width:170px;position:sticky;left:0;z-index:2;background:#fff;}
.pnl-table th:nth-child(2){text-align:left;min-width:65px;background:#fff;}
.pnl-table th.th-total{background:var(--off);font-weight:700;color:var(--slate-night);}
.pnl-table td{font-family:var(--mono);font-size:10px;padding:6px 10px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--off);}
.pnl-table td:first-child{text-align:left;position:sticky;left:0;background:#fff;z-index:1;min-width:200px;}
.pnl-table td:nth-child(2){text-align:left;color:var(--gray);font-size:9px;min-width:65px;}
.pnl-table td.td-total{background:var(--off);font-weight:700;}
.pnl-table tr:hover td{background:var(--cream);}
.pnl-table tr:hover td:first-child{background:var(--cream);}
.pnl-table tr.bold td{font-weight:700;color:var(--slate-night);}
.pnl-table tr.subhdr td{color:#fff;font-weight:700;font-size:9px;letter-spacing:.8px;text-transform:uppercase;padding:5px 10px;border:none;}
.pnl-table tr.subhdr td:first-child{position:sticky;left:0;z-index:1;}
.pos{color:var(--green)!important;font-weight:700!important;}
.neg{color:var(--red)!important;font-weight:700!important;}

/* ── CANAL MARCA ── */
.canal-marca-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}

/* ── PERIOD ── */
.period-bar{background:#fff;border-bottom:1px solid var(--border);padding:10px 2rem;display:flex;gap:8px;align-items:center;}
.period-label{font-family:var(--mono);font-size:9px;color:var(--gray);text-transform:uppercase;letter-spacing:1px;margin-right:4px;}
.period-pill{font-family:var(--mono);font-size:10px;padding:4px 14px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--gray);cursor:pointer;transition:all .15s;}
.period-pill.on{background:var(--slate-dark);border-color:var(--slate-dark);color:var(--cream);}
.period-pill:hover{border-color:var(--slate-light);color:var(--slate-night);}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.fade-up{animation:fadeUp .5s ease forwards;opacity:0;}
.fade-up:nth-child(1){animation-delay:.05s}.fade-up:nth-child(2){animation-delay:.1s}
.fade-up:nth-child(3){animation-delay:.15s}.fade-up:nth-child(4){animation-delay:.2s}
.fade-up:nth-child(5){animation-delay:.25s}.fade-up:nth-child(6){animation-delay:.3s}

/* ── CHECKLIST MODAL ── */
.cl-item{display:flex;gap:12px;align-items:flex-start;padding:9px 10px;border-radius:3px;cursor:pointer;transition:background .1s;margin-bottom:3px;}
.cl-item:hover{background:var(--off);}
.cl-cb{width:18px;height:18px;border:1.5px solid var(--border);border-radius:3px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;}
.cl-item.done .cl-cb{background:var(--slate-dark);border-color:var(--slate-dark);}
.cl-item.done .cl-cb::after{content:'✓';color:var(--cream);font-size:10px;font-weight:700;}
.cl-item.done .cl-label{text-decoration:line-through;color:var(--gray);}
.cl-label{font-size:13px;font-weight:500;color:var(--slate-night);margin-bottom:2px;}
.cl-sub{font-size:11px;color:var(--gray);font-family:var(--mono);line-height:1.5;}

@media(max-width:900px){
  .g2,.g3,.g4,.canal-marca-grid{grid-template-columns:1fr;}
  .main,.filters,.header,.tabs,.period-bar{padding-left:1rem;padding-right:1rem;}
  .kpi-grid{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div style="background:var(--cream);border-radius:4px;padding:2.5rem 2rem;width:320px;display:flex;flex-direction:column;gap:1.5rem;">
    <!-- Logo -->
    <div style="display:flex;align-items:center;gap:10px;">
      <svg width="28" height="28" viewBox="0 0 36 36" fill="none">
        <polygon points="0,0 17,0 17,17" fill="#2C3E4C"/>
        <polygon points="17,0 36,0 36,17 17,17" fill="#4A6274"/>
        <polygon points="0,19 17,19 17,36 0,36" fill="#8AA4B4"/>
        <polygon points="17,19 36,36 17,36" fill="#2C3E4C"/>
      </svg>
      <span style="font-family:'Instrument Sans',sans-serif;font-size:16px;font-weight:600;letter-spacing:-0.025em;color:#1C2B3A;">House<span style="color:#4A6274;">Brands</span></span>
    </div>
    <!-- Label -->
    <div style="font-family:'DM Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:#7A8F9E;">ERP — Acceso interno</div>
    <!-- Field -->
    <div style="display:flex;flex-direction:column;gap:6px;">
      <label style="font-family:'DM Mono',monospace;font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:#7A8F9E;">Contraseña</label>
      <input type="password" id="pwd-input" placeholder="••••••••" autocomplete="current-password"
        style="background:#fff;border:1px solid rgba(28,43,58,0.12);border-radius:2px;padding:10px 14px;color:#1C2B3A;font-family:'DM Mono',monospace;font-size:13px;outline:none;width:100%;transition:border-color .2s;"
        onfocus="this.style.borderColor='#4A6274'" onblur="this.style.borderColor='rgba(28,43,58,0.12)'">
    </div>
    <button onclick="checkLogin()"
      style="background:#2C3E4C;color:#F7F6F3;border:none;border-radius:2px;padding:11px;font-family:'Instrument Sans',sans-serif;font-size:13px;font-weight:600;letter-spacing:-0.01em;cursor:pointer;transition:background .2s;"
      onmouseover="this.style.background='#1C2B3A'" onmouseout="this.style.background='#2C3E4C'">
      ENTRAR
    </button>
    <div style="font-family:'DM Mono',monospace;font-size:11px;color:#c0392b;text-align:center;display:none;" id="login-err">Contraseña incorrecta</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <div class="header">
    <div class="header-logo">
      <svg width="22" height="22" viewBox="0 0 36 36" fill="none">
        <polygon points="0,0 17,0 17,17" fill="#F7F6F3"/>
        <polygon points="17,0 36,0 36,17 17,17" fill="#8AA4B4"/>
        <polygon points="0,19 17,19 17,36 0,36" fill="#8AA4B4"/>
        <polygon points="17,19 36,36 17,36" fill="#4A6274"/>
      </svg>
      House<span>Brands</span>&nbsp;<span style="font-size:11px;font-weight:400;color:rgba(255,255,255,0.3);letter-spacing:0.1em;">ERP</span>
    </div>
    <div class="header-right">
      <div class="header-updated" id="updated-label">Cargando...</div>
      <button class="header-btn" onclick="showChecklist()">☑ Checklist</button>
      <button class="header-btn" onclick="logout()">Salir</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" id="tab-ventas" onclick="switchTab('ventas')">📊 Ventas</div>
    <div class="tab" id="tab-pnl" onclick="switchTab('pnl')">💰 P&amp;L</div>
    <div class="tab" id="tab-historico" onclick="switchTab('historico')">📁 Histórico</div>
  </div>

  <!-- TAB VENTAS -->
  <div id="view-ventas">
    <div class="filters">
      <button class="pill on" id="fa"   onclick="sf('m','Todas',this)">Todas</button>
      <button class="pill"    id="fmk"  onclick="sf('m','MemoKoala',this)">🐨 MemoKoala</button>
      <button class="pill"    id="fmt"  onclick="sf('m','Montana',this)">🔪 Montana</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fca"  onclick="sf('c','Todos',this)">Todos canales</button>
      <button class="pill"    id="fsh"  onclick="sf('c','Shopify',this)">Shopify</button>
      <button class="pill"    id="fml"  onclick="sf('c','ML',this)">MercadoLibre</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fya"  onclick="sf('y',0,this)">Todos</button>
      <button class="pill"    id="fy25" onclick="sf('y',2025,this)">2025</button>
      <button class="pill"    id="fy26" onclick="sf('y',2026,this)">2026</button>
      <div class="filter-sep"></div>
      <button class="pill on" id="fma"  onclick="sf('me',0,this)">Todo</button>
      <button class="pill" id="fm1"  onclick="sf('me',1,this)">Ene</button>
      <button class="pill" id="fm2"  onclick="sf('me',2,this)">Feb</button>
      <button class="pill" id="fm3"  onclick="sf('me',3,this)">Mar</button>
      <button class="pill" id="fm4"  onclick="sf('me',4,this)">Abr</button>
      <button class="pill" id="fm5"  onclick="sf('me',5,this)">May</button>
      <button class="pill" id="fm6"  onclick="sf('me',6,this)">Jun</button>
      <button class="pill" id="fm7"  onclick="sf('me',7,this)">Jul</button>
      <button class="pill" id="fm8"  onclick="sf('me',8,this)">Ago</button>
      <button class="pill" id="fm9"  onclick="sf('me',9,this)">Sep</button>
      <button class="pill" id="fm10" onclick="sf('me',10,this)">Oct</button>
      <button class="pill" id="fm11" onclick="sf('me',11,this)">Nov</button>
      <button class="pill" id="fm12" onclick="sf('me',12,this)">Dic</button>
    </div>
    <div class="main">
