}
function logout() {
  sessionStorage.removeItem('hb_auth');
  document.getElementById('login-screen').style.display='flex';
  document.getElementById('app').style.display='none';
}
document.getElementById('pwd-input').addEventListener('keydown', e=>{ if(e.key==='Enter') checkLogin(); });
if(sessionStorage.getItem('hb_auth')==='1') {
  document.getElementById('login-screen').style.display='none';
  document.getElementById('app').style.display='block';
  loadVentas();
}

// ── TABS ──────────────────────────────────────────────────
let pnlLoaded = false;
function switchTab(tab) {
  document.getElementById('view-ventas').style.display = tab==='ventas'?'block':'none';
  document.getElementById('view-pnl').style.display    = tab==='pnl'?'block':'none';
  document.getElementById('tab-ventas').className = 'tab'+(tab==='ventas'?' active':'');
  document.getElementById('tab-pnl').className    = 'tab'+(tab==='pnl'?' active':'');
  if(tab==='pnl' && !pnlLoaded) loadPnL();
}

// ── VENTAS DATA ───────────────────────────────────────────
let DATA = [];
let filters = {m:'Todas', c:'Todos', y:0, me:0};

async function loadVentas() {
  try {
    const resp = await fetch(CSV_VENTAS);
    if(!resp.ok) throw new Error('HTTP '+resp.status);
    const text = await resp.text();
    DATA = parseVentasCSV(text);
    document.getElementById('loading-ventas').style.display='none';
    document.getElementById('dash-ventas').style.display='block';
    document.getElementById('updated-label').textContent = 'Actualizado: '+new Date().toLocaleTimeString('es-CL');
    render();
  } catch(e) {
    document.getElementById('loading-ventas').innerHTML =
      '<div style="color:#c0392b;font-family:var(--mono);font-size:12px">Error cargando datos.<br>'+
      '<button onclick="loadVentas()" style="background:var(--mk);color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-family:var(--mono);margin-top:12px">Reintentar</button></div>';
  }
}

function parseVentasCSV(text) {
  const lines = text.split('\n').filter(l=>l.trim());
  if(lines.length < 2) return [];
  const records = [];
  for(let i=1; i<lines.length; i++) {
    const cols = splitCSV(lines[i]);
    if(cols.length < 20) continue;
    const marca = cols[4]?.trim()||'';
    const canal = cols[5]?.trim()||'';
    if(!marca) continue;
    const mes  = parseInt(cols[1])||0;
    const anio = parseInt(cols[3])||0;
    const sku  = cols[7]?.trim()||'';
    const prod = cols[8]?.trim()||'';
    const qty  = parseInt(cols[9])||1;
    const vb   = parseNum(cols[11]);
    const costo= parseNum(cols[18]);
    const mb   = parseNum(cols[19]);
    const mrg  = parseNum(cols[20]);
    if(vb<=0) continue;
    const mb_f = mb!==0?mb:(vb-costo);
    const mrg_f= mrg!==0?mrg:(vb>0?(mb_f/vb)*100:0);
    let fecha = cols[0]?.trim()||'';
    const dmy = fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy) fecha = dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    records.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costo,mb:mb_f,mrg:mrg_f});
  }
  return records;
}

// ── PNL DATA ──────────────────────────────────────────────
let PNL_DATA = {meses:[], rows:[]};

async function loadPnL() {
  try {
    const resp = await fetch(CSV_PNL);
    if(!resp.ok) throw new Error('HTTP '+resp.status);
    const text = await resp.text();
    PNL_DATA = parsePnLCSV(text);
    pnlLoaded = true;
    document.getElementById('loading-pnl').style.display='none';
    document.getElementById('dash-pnl').style.display='block';
    renderPnL();
  } catch(e) {
    document.getElementById('loading-pnl').innerHTML =
      '<div style="color:#c0392b;font-family:var(--mono);font-size:12px">Error cargando P&L.<br>'+
      '<button onclick="loadPnL()" style="background:var(--mk);color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-family:var(--mono);margin-top:12px">Reintentar</button></div>';
    console.error('PnL error:', e);
  }
}

function parsePnLCSV(text) {
  const lines = text.split('\n').filter(l=>l.trim());
  if(lines.length < 3) return {meses:[],rows:[]};

  // Row 1: title, Row 2: subtitle, Row 3: headers (CONCEPTO, CATEGORÍA, MAY-25, ...)
  // Find header row — contains "CONCEPTO"
  let hdrIdx = -1;
  for(let i=0; i<Math.min(lines.length,5); i++) {
    if(lines[i].toUpperCase().includes('CONCEPTO')) { hdrIdx=i; break; }
  }
  if(hdrIdx===-1) hdrIdx=2;

  const hdrCols = splitCSV(lines[hdrIdx]);
  // Meses start from col index 2 (after CONCEPTO and CATEGORÍA)
  const meses = hdrCols.slice(2).map(m=>m.trim()).filter(m=>m);

  const rows = [];
  for(let i=hdrIdx+1; i<lines.length; i++) {
    const cols = splitCSV(lines[i]);
    if(cols.length < 3) continue;
    const concepto  = cols[0]?.trim()||'';
    const categoria = cols[1]?.trim()||'';
    if(!concepto) continue;

    const valores = cols.slice(2).map(v=>parseNum(v));
    // Pad to meses length
    while(valores.length < meses.length) valores.push(0);

    rows.push({concepto, categoria, valores});
  }

  return {meses, rows};
}

// ── HELPERS ───────────────────────────────────────────────
function splitCSV(line) {
  const res=[]; let f='', inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){f+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){res.push(f.trim());f='';}
    else f+=c;
  }
  res.push(f.trim());
  return res;
}

function parseNum(v) {
  if(v===null||v===undefined||v==='') return 0;
  if(typeof v==='number') return v;
  let s=String(v).trim().replace(/[$\s%]/g,'');
  if(s==='') return 0;
  const dots=(s.match(/\./g)||[]).length;
  const commas=(s.match(/,/g)||[]).length;
  if(commas>=1&&dots===0) s=s.replace(/,/g,'');
  else if(commas===1&&dots===1) s=s.replace(',','');
  else if(commas===0&&dots===1){const a=s.split('.')[1];if(a&&a.length===3)s=s.replace('.','')}
  else if(commas===0&&dots>1) s=s.replace(/\./g,'');
  return parseFloat(s)||0;
}

const clp  = n => '$'+Math.round(n).toLocaleString('es-CL');
const pct  = n => (n*100).toFixed(1)+'%';
const mColor = p => p>=65?'var(--green)':p>=45?'var(--gold)':'var(--red)';

// ── FILTROS VENTAS ────────────────────────────────────────
function sf(type, val, el) {
  filters[type] = val;
  const groups={m:['fa','fmk','fmt'],c:['fca','fsh','fml','fvd'],y:['fya','fy25','fy26'],me:['fma','fm1','fm2','fm3','fm4','fm5','fm6','fm7','fm8','fm9','fm10','fm11','fm12']};
  groups[type].forEach(id=>{const e=document.getElementById(id);if(e)e.className='pill';});
  el.className=val==='MemoKoala'?'pill mk':val==='Montana'?'pill mt':'pill on';
  render();
}

function filtered() {
  return DATA.filter(r=>{
    if(filters.m!=='Todas'&&r.marca!==filters.m) return false;
    if(filters.c!=='Todos'&&r.canal!==filters.c) return false;
    if(filters.y!==0&&r.anio!==filters.y) return false;
    if(filters.me!==0&&r.mes!==filters.me) return false;
    return true;
  });
}

// ── RENDER VENTAS ─────────────────────────────────────────
function render() {
  const d=filtered();
  renderKPIs(d); renderMonthBars(d); renderCanal(d);
  renderMarca(d); renderProdBars(d); renderRecentTx(d); renderSkuTable(d);
}

function renderKPIs(d) {
  const vb=d.reduce((s,r)=>s+r.vb,0),mb=d.reduce((s,r)=>s+r.mb,0);
  const un=d.reduce((s,r)=>s+r.qty,0),cnt=d.length;
  const tk=un>0?vb/un:0,mrg=vb>0?mb/vb:0;
  const META=14969250,meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses,gap=avg/META-1;
  const kpis=[
    {lbl:'Venta Bruta',val:clp(vb),sub:cnt+' trans · '+un+' uds',tag:gap>=0?'↑ +'+Math.abs(gap*100).toFixed(1)+'% meta':'↓ '+Math.abs(gap*100).toFixed(1)+'% meta',cls:gap>=0?'tag-up':'tag-dn',accent:'#3d7a62'},
    {lbl:'Margen Bruto $',val:clp(mb),sub:pct(mrg)+' sobre venta',tag:mrg>=.65?'Saludable':mrg>=.45?'OK':'Revisar',cls:mrg>=.65?'tag-up':mrg>=.45?'tag-n':'tag-dn',accent:'#c9a227'},
    {lbl:'Ticket Promedio',val:clp(tk),sub:'por unidad',tag:'',cls:'',accent:'#1a3a5c'},
    {lbl:'Unidades',val:un.toLocaleString('es-CL'),sub:meses+' mes'+(meses>1?'es':''),tag:'',cls:'',accent:'#b85a2a'},
    {lbl:'Prom. Mensual',val:clp(avg),sub:'meta: '+clp(META),tag:gap>=0?'↑ Sobre meta':'↓ Bajo meta',cls:gap>=0?'tag-up':'tag-dn',accent:'#5a2a8a'},
    {lbl:'Costo Total',val:clp(d.reduce((s,r)=>s+r.costo,0)),sub:'importación',tag:'',cls:'',accent:'#4a4540'},
  ];
  document.getElementById('kpi-grid').innerHTML=kpis.map(k=>`
    <div class="kpi fade-up" style="--accent:${k.accent}">
      <div class="kpi-label">${k.lbl}</div>
      <div class="kpi-val">${k.val}</div>
      ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');
}

function renderMonthBars(d) {
  const byM={};
  d.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k]) byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;
  });
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('month-bars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt,h=Math.max(3,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2,hmt=h-hmk;
    return `<div class="mbar-col">
      <div class="mbar-wrap">
        <div class="mbar" style="height:${hmt}px;background:var(--mt-mid);opacity:.8" data-tip="${v.lbl}: ${clp(tot)}"></div>
        <div class="mbar" style="height:${hmk}px;background:var(--mk)" data-tip="${v.lbl}: ${clp(tot)}"></div>
      </div>
      <div class="mbar-lbl">${v.lbl}</div>
    </div>`;
  }).join('');
  document.getElementById('month-legend').innerHTML=`
    <div class="leg"><div class="leg-dot" style="background:var(--mk)"></div>MemoKoala</div>
    <div class="leg"><div class="leg-dot" style="background:var(--mt-mid)"></div>Montana</div>`;
}

function renderCanal(d) {
  const ch={};
  d.forEach(r=>{ch[r.canal]=(ch[r.canal]||{vb:0,mb:0,cnt:0});ch[r.canal].vb+=r.vb;ch[r.canal].mb+=r.mb;ch[r.canal].cnt++;});
  const tot=Object.values(ch).reduce((s,v)=>s+v.vb,0)||1;
  const cc={Shopify:'var(--green)',ML:'var(--gold)'};
  document.getElementById('canal-split').innerHTML=Object.entries(ch).map(([k,v])=>`<div style="flex:${v.vb};background:${cc[k]||'#ccc'}"></div>`).join('');
  document.getElementById('canal-detail').innerHTML=Object.entries(ch).map(([k,v])=>`
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div class="leg"><div class="leg-dot" style="background:${cc[k]||'#ccc'}"></div>
      <span class="bdg ${k==='Shopify'?'b-sh':'b-ml'}">${k}</span></div>
      <span style="font-family:var(--mono);font-size:11px">${clp(v.vb)} <span style="color:var(--ink-dim)">${pct(v.vb/tot)}</span></span>
    </div>`).join('');
  document.getElementById('canal-margin').innerHTML='<div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Margen por canal</div>'+
    Object.entries(ch).map(([k,v])=>{
