    ch[r.canal].descto+=r.descto;
  });
  const tot=Object.values(ch).reduce((s,v)=>s+v.vb,0)||1;
  const cc={Shopify:'var(--sh)',ML:'var(--ml)'};
  const cc2={Shopify:'b-sh',ML:'b-ml'};
  document.getElementById('canal-content').innerHTML=Object.entries(ch).map(([k,v])=>{
    const mrg=v.vb>0?v.mb/v.vb:0;
    const mc=mrg>=.65?'var(--pos)':mrg>=.45?'var(--warn)':'var(--neg)';
    return `<div class="canal-row">
      <div class="canal-top">
        <span class="canal-name"><span class="bdg ${cc2[k]||''}">${k}</span></span>
