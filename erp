function renderSkuTable(d){
  const s={};
  d.forEach(r=>{
    if(!s[r.sku])s[r.sku]={nom:r.prod,marca:r.marca,un:0,vb:0,costo:0,mb:0};
    s[r.sku].un+=r.qty;s[r.sku].vb+=r.vb;s[r.sku].costo+=r.costo;s[r.sku].mb+=r.mb;
