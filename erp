    }).join('');
}

function renderMarca(d) {
  const bm={};
  d.forEach(r=>{bm[r.marca]=(bm[r.marca]||{vb:0,mb:0});bm[r.marca].vb+=r.vb;bm[r.marca].mb+=r.mb;});
  const bc={MemoKoala:'var(--mk)',Montana:'var(--mt)'};
  document.getElementById('marca-margen').innerHTML=Object.entries(bm).map(([m,v])=>{
