  if(vbTot&&mbTot){
    const vtds=idxs.map(i=>{const v=vbTot.mv[i]||0,m=mbTot.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;return`<td style="font-weight:600">${v?clp(v):'—'}${v?`<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${p}%</span>`:''}</td>`;}).join('');
    const vtot=ps(vbTot.mv),mtot=ps(mbTot.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr class="bold"><td>TOTAL CONSOLIDADO<br><span style="font-size:9px;color:var(--light);font-weight:400">Venta · Margen %</span></td>${vtds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${parseFloat(pp)>=65?'#4acf80':'#f87171'}">${pp}%</span></td></tr>`;
  }

  const sections=[
