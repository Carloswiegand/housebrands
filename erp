function renderPnLTable(idxs,labels,rows,vbTot){
  const SC={
    'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#BF360C',
    'MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#37474F',
    'RESULTADO':'#1C2B3A','METRICAS':'#37474F','MARCA':'#263238'
  };
  const getSC=c=>{const u=c.toUpperCase();for(const[k,v]of Object.entries(SC)){if(u.includes(k))return v;}return'#2C3E4C';};
  const isShdr=r=>r.concepto.includes('▶');
  const isRes=r=>r.concepto.includes('RESULTADO NETO');
  const isPct=r=>r.concepto.startsWith('%');

  const ps=mv=>idxs.reduce((s,i)=>s+(mv[i]||0),0);
  const pavg=mv=>{const nz=idxs.map(i=>mv[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const fv=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const cc=(v,r)=>r?(v>=0?'class="p-pos"':'class="p-neg"'):'';

  // Construir P&L condensado
  // Agrupamos venta+margen por marca en una sola fila
  const findRow=t=>rows.find(r=>r.concepto.toUpperCase().includes(t.toUpperCase()));

  const vbMK=findRow('Venta Bruta MemoKoala');
  const vbMT=findRow('Venta Bruta Montana');
  const mbMK=findRow('Margen Bruto MemoKoala');
  const mbMT=findRow('Margen Bruto Montana');
  const vbTOT=findRow('VENTA BRUTA TOTAL');
  const mbTOT=findRow('MARGEN BRUTO TOTAL');

  const ths=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');

  let html=`<table class="pnl-tbl"><thead><tr>
    <th>Concepto</th>${ths}<th class="th-tot">Total / Prom</th>
  </tr></thead><tbody>`;

  // INGRESOS + MARGEN condensado
  html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:#2E7D32">▶ INGRESOS Y MARGEN</td></tr>`;

  // Una fila por marca: venta | margen%
  if(vbMK&&mbMK){
    const vtds=idxs.map(i=>{
      const v=vbMK.mv[i]||0,m=mbMK.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;
      return`<td>${v?clp(v):'—'}<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${v?p+'%':''}</span></td>`;
    }).join('');
    const vtot=ps(vbMK.mv),mtot=ps(mbMK.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr><td><span class="bdg b-mk">MK</span> MemoKoala<br><span style="font-size:9px;color:var(--light)">Venta bruta · Margen %</span></td>
      ${vtds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${parseFloat(pp)>=65?'#4acf80':'#f87171'}">${pp}%</span></td></tr>`;
  }
  if(vbMT&&mbMT){
    const vtds=idxs.map(i=>{
      const v=vbMT.mv[i]||0,m=mbMT.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;
      return`<td>${v?clp(v):'—'}<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${v?p+'%':''}</span></td>`;
    }).join('');
    const vtot=ps(vbMT.mv),mtot=ps(mbMT.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr><td><span class="bdg b-mt">MT</span> Montana<br><span style="font-size:9px;color:var(--light)">Venta bruta · Margen %</span></td>
      ${vtds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${parseFloat(pp)>=65?'#4acf80':'#f87171'}">${pp}%</span></td></tr>`;
  }
  // Total
  if(vbTOT&&mbTOT){
    const vtds=idxs.map(i=>{
      const v=vbTOT.mv[i]||0,m=mbTOT.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;
