  const fv=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const fr=t=>rows.find(r=>r.concepto.toUpperCase().includes(t.toUpperCase()));
  const ths=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');

  let html=`<table class="pnl-tbl"><thead><tr><th>Concepto</th>${ths}<th class="th-tot">Total/Prom</th></tr></thead><tbody>`;

  html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:#2E7D32">▶ INGRESOS Y MARGEN</td></tr>`;
  [['MemoKoala','Venta Bruta MemoKoala','Margen Bruto MemoKoala','b-mk','MK'],
   ['Montana','Venta Bruta Montana','Margen Bruto Montana','b-mt','MT']].forEach(([nm,vR,mR,cls,tag])=>{
