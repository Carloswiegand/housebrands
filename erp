<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HouseBrands · ERP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --night:#1C2B3A;
  --dark:#2C3E4C;
  --mid:#4A6274;
  --light:#8AA4B4;
  --pale:#D6E4EC;
  --bg:#EEF3F7;
  --surface:#FFFFFF;
  --off:#F5F8FA;
  --border:#D6E4EC;
  --border2:#C2D4DF;
  --mk:#3d7a62;
  --mk-bg:#EAF4EF;
  --mk-border:#A8D0BC;
  --mt:#b85a2a;
  --mt-bg:#F7EDE6;
  --mt-border:#E0A882;
  --pos:#1a7a45;
  --pos-bg:#E8F8EE;
  --neg:#c0392b;
  --neg-bg:#FDECEA;
  --warn:#b07d10;
  --warn-bg:#FDF6E3;
  --sh:#2563a8;
  --sh-bg:#EBF2FA;
  --ml:#9a6f00;
  --ml-bg:#FDF6E3;
  --f:'Inter',sans-serif;
  --mono:'JetBrains Mono',monospace;
  --r:8px;
  --r2:5px;
  --shadow:0 1px 3px rgba(28,43,58,0.08),0 4px 12px rgba(28,43,58,0.05);
  --shadow2:0 2px 8px rgba(28,43,58,0.12);
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--night);font-family:var(--f);font-size:13px;min-height:100vh;-webkit-font-smoothing:antialiased}

/* ── LOGIN ── */
#login{position:fixed;inset:0;z-index:999;background:var(--night);display:flex;align-items:center;justify-content:center}
.lbox{width:340px;background:var(--surface);border-radius:12px;padding:36px 32px;box-shadow:0 20px 60px rgba(0,0,0,0.3);display:flex;flex-direction:column;gap:24px}
.llogo{display:flex;align-items:center;gap:10px}
.lmark{font-size:18px;font-weight:600;letter-spacing:-0.03em;color:var(--night)}
.lmark b{color:var(--mid);font-weight:400}
.ltag{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:0.12em;margin-top:4px}
.lfield label{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:0.1em;display:block;margin-bottom:6px}
.linput{width:100%;background:var(--off);border:1.5px solid var(--border);border-radius:var(--r2);padding:10px 14px;color:var(--night);font-family:var(--mono);font-size:13px;outline:none;transition:border .2s}
.linput:focus{border-color:var(--mid);background:#fff}
.lbtn{width:100%;background:var(--night);border:none;border-radius:var(--r2);padding:12px;color:#fff;font-family:var(--f);font-size:13px;font-weight:500;cursor:pointer;transition:background .2s}
.lbtn:hover{background:var(--dark)}
.lerr{font-family:var(--mono);font-size:11px;color:var(--neg);text-align:center;display:none}

/* ── APP ── */
#app{display:none;min-height:100vh}

/* ── TOPBAR ── */
.topbar{background:var(--night);height:52px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,0.06)}
.tmark{font-size:15px;font-weight:600;letter-spacing:-0.025em;color:#fff}
.tmark b{color:var(--light);font-weight:400}
.terp{font-family:var(--mono);font-size:9px;color:rgba(255,255,255,0.3);margin-left:10px;letter-spacing:0.1em}
.tright{display:flex;align-items:center;gap:8px}
.tchip{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:4px;padding:3px 9px}
.tbtn{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,0.45);background:transparent;border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:4px 12px;cursor:pointer;transition:all .15s}
.tbtn:hover{color:#fff;border-color:rgba(255,255,255,0.3)}

/* ── TABS ── */
.tabbar{background:var(--night);border-bottom:1px solid rgba(255,255,255,0.08);padding:0 24px;display:flex;gap:0}
.tab{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,0.4);padding:12px 18px;cursor:pointer;border-bottom:2px solid transparent;letter-spacing:0.05em;transition:all .15s}
.tab:hover{color:rgba(255,255,255,0.7)}
.tab.on{color:#fff;border-bottom-color:var(--pale)}

/* ── FILTROS ── */
.fbar{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;box-shadow:0 1px 3px rgba(28,43,58,0.04)}
.flbl{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:0.08em;flex-shrink:0}
.fsel{background:var(--off);border:1.5px solid var(--border);border-radius:var(--r2);color:var(--dark);font-family:var(--mono);font-size:10px;padding:5px 10px;height:28px;outline:none;cursor:pointer;transition:border .15s}
.fsel:focus{border-color:var(--mid)}
.fpill{font-family:var(--mono);font-size:10px;padding:4px 12px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--mid);cursor:pointer;transition:all .15s}
.fpill:hover{border-color:var(--light);color:var(--dark)}
.fpill.on{background:var(--night);border-color:var(--night);color:#fff}
.fpill.mk{background:var(--mk-bg);border-color:var(--mk-border);color:var(--mk)}
.fpill.mt{background:var(--mt-bg);border-color:var(--mt-border);color:var(--mt)}
.fsep{width:1px;height:16px;background:var(--border);margin:0 4px;flex-shrink:0}

/* ── PAGE ── */
.page{padding:20px 24px;max-width:1600px;margin:0 auto}

/* ── KPI GRID ── */
.krow{display:grid;gap:12px;margin-bottom:12px}
.krow-4{grid-template-columns:repeat(4,1fr)}
.krow-5{grid-template-columns:repeat(5,1fr)}

/* ── KPI CARD ── */
.kcard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden;transition:box-shadow .2s}
.kcard:hover{box-shadow:var(--shadow2)}
.kcard-accent{position:absolute;top:0;left:0;right:0;height:3px}
.kcard-label{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:0.1em;margin-bottom:8px}
.kcard-num{font-size:26px;font-weight:600;letter-spacing:-0.04em;line-height:1;color:var(--night);margin-bottom:4px}
.kcard-num.pos{color:var(--pos)}
.kcard-num.neg{color:var(--neg)}
.kcard-num.warn{color:var(--warn)}
.kcard-num.mid{color:var(--mid)}
.kcard-sub{font-size:11px;color:var(--light);margin-bottom:8px;line-height:1.3}
.kcard-delta{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:10px;padding:2px 8px;border-radius:4px;font-weight:500}
.d-pos{background:var(--pos-bg);color:var(--pos)}
.d-neg{background:var(--neg-bg);color:var(--neg)}
.d-neu{background:var(--off);color:var(--mid);border:1px solid var(--border)}
.d-warn{background:var(--warn-bg);color:var(--warn)}
.kcard-spark{display:flex;align-items:flex-end;gap:2px;height:24px;margin-top:10px}
.ksbar{flex:1;border-radius:2px 2px 0 0;min-height:2px}

/* ── KPI GASTO (pequeño) ── */
.gcard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px}
.gcard-icon{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.gcard-body{flex:1;min-width:0}
.gcard-label{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:0.08em;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gcard-num{font-size:20px;font-weight:600;letter-spacing:-0.03em;color:var(--night);line-height:1}
.gcard-sub{font-family:var(--mono);font-size:9px;color:var(--light);margin-top:2px}

/* ── GRID 2/3 ── */
.g2{display:grid;grid-template-columns:1.5fr 1fr;gap:12px;margin-bottom:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}
.g23{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:12px}

/* ── CARD ── */
.card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:0.1em}
.card-meta{font-family:var(--mono);font-size:9px;color:var(--light)}
.card-body{padding:16px}

/* ── CANAL WIDGET ── */
.canal-item{margin-bottom:14px}
.canal-item:last-child{margin-bottom:0}
.canal-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
.canal-lbl{display:flex;align-items:center;gap:6px}
.canal-num{font-size:22px;font-weight:600;letter-spacing:-0.04em;color:var(--night)}
.canal-track{height:5px;background:var(--bg);border-radius:3px;overflow:hidden;margin-bottom:3px}
.canal-fill{height:100%;border-radius:3px}
.canal-sub{font-family:var(--mono);font-size:9px;color:var(--light)}

/* ── TREND MINI ── */
.trend{display:flex;align-items:flex-end;gap:2px;height:32px}
.tbar{flex:1;border-radius:2px 2px 0 0;min-height:2px;transition:opacity .15s}
.tbar:hover{opacity:0.7}

/* ── TABLA ── */
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead th{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:8px;color:var(--light);font-weight:500;letter-spacing:0.08em;border-bottom:1.5px solid var(--border);white-space:nowrap;background:var(--off)}
thead th:first-child,thead th:nth-child(2){text-align:left}
tbody td{padding:9px 12px;text-align:right;font-family:var(--mono);font-size:10px;color:var(--dark);border-bottom:1px solid var(--off)}
tbody td:first-child{text-align:left;color:var(--night);font-weight:500}
tbody td:nth-child(2){text-align:left;color:var(--mid)}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--bg)}
.bdg{display:inline-flex;align-items:center;font-family:var(--mono);font-size:9px;padding:2px 8px;border-radius:4px;font-weight:500}
.b-mk{background:var(--mk-bg);color:var(--mk);border:1px solid var(--mk-border)}
.b-mt{background:var(--mt-bg);color:var(--mt);border:1px solid var(--mt-border)}
.b-sh{background:var(--sh-bg);color:var(--sh)}
.b-ml{background:var(--ml-bg);color:var(--ml)}
.mrg-cell{display:flex;align-items:center;gap:6px;justify-content:flex-end}
.mbar{width:40px;height:4px;background:var(--bg);border-radius:2px;overflow:hidden}
.mfill{height:100%;border-radius:2px}
.neg-val{color:var(--neg)}
.pos-val{color:var(--pos);font-weight:600}

/* ── P&L ── */
.pnl-periods{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 24px;display:flex;gap:6px;align-items:center}
.ppill{font-family:var(--mono);font-size:10px;padding:4px 14px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--mid);cursor:pointer;transition:all .15s}
.ppill:hover{border-color:var(--mid);color:var(--dark)}
.ppill.on{background:var(--night);border-color:var(--night);color:#fff}

/* ── P&L TABLE ── */
.pnl-wrap{overflow-x:auto}
.pnl-tbl{border-collapse:collapse;width:100%;min-width:800px;font-size:11px}
.pnl-tbl th{font-family:var(--mono);font-size:8px;color:var(--light);padding:7px 10px;text-align:right;border-bottom:1.5px solid var(--border);white-space:nowrap;background:var(--off);font-weight:500;letter-spacing:0.06em;position:sticky;top:0;z-index:2}
.pnl-tbl th:first-child{text-align:left;min-width:200px;position:sticky;left:0;z-index:3;background:var(--off)}
.pnl-tbl th.th-tot{background:var(--night);color:rgba(255,255,255,0.7);font-weight:600}
.pnl-tbl td{font-family:var(--mono);font-size:10px;padding:6px 10px;text-align:right;border-bottom:1px solid var(--off);color:var(--dark)}
.pnl-tbl td:first-child{text-align:left;position:sticky;left:0;background:var(--surface);z-index:1;color:var(--night);min-width:200px}
.pnl-tbl td.td-tot{background:var(--night);color:#fff;font-weight:600}
.pnl-tbl tr:hover td{background:var(--bg)}
.pnl-tbl tr:hover td:first-child{background:var(--bg)}
.pnl-tbl tr.bold td{font-weight:700;color:var(--night)}
.pnl-tbl tr.bold td:first-child{color:var(--night)}
.pnl-tbl tr.shdr td{font-family:var(--mono);font-size:8px;font-weight:600;letter-spacing:0.1em;padding:5px 10px;border:none;color:#fff}
.pnl-tbl tr.shdr td:first-child{position:sticky;left:0;z-index:1}
.pnl-tbl tr.compact td{padding:4px 10px;font-size:9px;color:var(--mid)}
.pnl-tbl tr.compact td:first-child{padding-left:20px;color:var(--mid)}
.p-pos{color:var(--pos)!important;font-weight:600!important}
.p-neg{color:var(--neg)!important;font-weight:600!important}

/* ── INVENTARIO ── */
.inv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px}
.inv-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;box-shadow:var(--shadow)}
.inv-sku{font-family:var(--mono);font-size:10px;color:var(--mid);margin-bottom:4px}
.inv-nom{font-size:12px;font-weight:500;color:var(--night);margin-bottom:10px;line-height:1.3}
.inv-num{font-size:28px;font-weight:600;letter-spacing:-0.04em;color:var(--night);line-height:1}
.inv-lbl{font-family:var(--mono);font-size:9px;color:var(--light);margin-top:2px;margin-bottom:10px}
.inv-row{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9px;color:var(--light);margin-bottom:3px}
.inv-row span:last-child{color:var(--dark);font-weight:500}
.inv-bar{height:4px;background:var(--bg);border-radius:2px;overflow:hidden;margin-top:10px}
.inv-fill{height:100%;border-radius:2px;transition:width .5s}
.stato{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:9px;padding:2px 8px;border-radius:4px;margin-top:8px;font-weight:500}
.s-ok{background:var(--pos-bg);color:var(--pos)}
.s-warn{background:var(--warn-bg);color:var(--warn)}
.s-alert{background:#FEF3E2;color:#D35400}
.s-crit{background:var(--neg-bg);color:var(--neg)}
.s-none{background:var(--off);color:var(--light)}

/* ── LOADING ── */
.spin{text-align:center;padding:60px 0}
.dots{display:inline-flex;gap:5px;margin-bottom:12px}
.dot{width:6px;height:6px;border-radius:50%;background:var(--pale);animation:blink 1.2s ease-in-out infinite}
.dot:nth-child(2){animation-delay:.2s}
.dot:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:.3;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}
.spin p{font-family:var(--mono);font-size:11px;color:var(--light)}

/* ── CHECKLIST ── */
#cl-modal{display:none;position:fixed;inset:0;z-index:200;background:rgba(28,43,58,0.6);backdrop-filter:blur(4px);overflow-y:auto;padding:40px 20px}
.cl-box{max-width:580px;margin:0 auto;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(28,43,58,0.2)}
.cl-head{background:var(--night);padding:18px 22px;display:flex;justify-content:space-between;align-items:center}
.cl-htitle{font-size:14px;font-weight:500;color:#fff;letter-spacing:-0.01em}
.cl-close{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.6);border-radius:4px;padding:5px 12px;cursor:pointer;font-family:var(--mono);font-size:10px;transition:all .15s}
.cl-close:hover{color:#fff}
.cl-prog-wrap{height:3px;background:var(--bg)}
.cl-prog{height:100%;background:var(--mk);transition:width .3s}
.cl-body{padding:22px}
.cl-section{margin-bottom:20px}
.cl-stitle{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;margin-bottom:10px;padding-bottom:7px;border-bottom:1.5px solid var(--border)}
.cl-item{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:6px;cursor:pointer;transition:background .1s;margin-bottom:2px}
.cl-item:hover{background:var(--bg)}
.cl-cb{width:18px;height:18px;border:1.5px solid var(--border);border-radius:4px;flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cl-item.done .cl-cb{background:var(--mk);border-color:var(--mk)}
.cl-item.done .cl-cb::after{content:'✓';color:#fff;font-size:11px;font-weight:700}
.cl-item.done .cl-lbl{text-decoration:line-through;color:var(--light)}
.cl-lbl{font-size:12px;font-weight:500;color:var(--night);margin-bottom:2px}
.cl-sub{font-family:var(--mono);font-size:10px;color:var(--light);line-height:1.5}
.cl-warn{font-family:var(--mono);font-size:10px;color:var(--warn);margin-top:3px;font-weight:500}
.cl-reset{font-family:var(--mono);font-size:10px;background:var(--off);border:1.5px solid var(--border);border-radius:4px;padding:7px 16px;cursor:pointer;color:var(--mid);transition:all .15s}
.cl-reset:hover{border-color:var(--mid)}
@media(max-width:900px){.krow-4,.krow-5{grid-template-columns:1fr 1fr}.g2,.g3,.g23,.inv-grid{grid-template-columns:1fr}.page,.fbar,.topbar,.tabbar,.pnl-periods{padding-left:14px;padding-right:14px}}
</style>
</head>
<body>

<div id="login">
  <div class="lbox">
    <div>
      <div class="llogo">
        <svg width="28" height="28" viewBox="0 0 36 36" fill="none">
          <polygon points="0,0 17,0 17,17" fill="#1C2B3A"/>
          <polygon points="17,0 36,0 36,17 17,17" fill="#4A6274"/>
          <polygon points="0,19 17,19 17,36 0,36" fill="#8AA4B4"/>
          <polygon points="17,19 36,36 17,36" fill="#2C3E4C"/>
        </svg>
        <div>
          <div class="lmark">House<b>Brands</b></div>
          <div class="ltag">ERP — Acceso interno</div>
        </div>
      </div>
    </div>
    <div class="lfield">
      <label>Contraseña</label>
      <input type="password" id="pwd" class="linput" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="lbtn" onclick="doLogin()">Entrar</button>
    <div class="lerr" id="lerr">Contraseña incorrecta</div>
  </div>
</div>

<div id="app">
  <div class="topbar">
    <div style="display:flex;align-items:center">
      <svg width="20" height="20" viewBox="0 0 36 36" fill="none" style="margin-right:10px">
        <polygon points="0,0 17,0 17,17" fill="#fff"/>
        <polygon points="17,0 36,0 36,17 17,17" fill="#8AA4B4"/>
        <polygon points="0,19 17,19 17,36 0,36" fill="#8AA4B4"/>
        <polygon points="17,19 36,36 17,36" fill="#4A6274"/>
      </svg>
      <span class="tmark">House<b>Brands</b></span>
      <span class="terp">ERP</span>
    </div>
    <div class="tright">
      <span class="tchip" id="tc-usd">USD —</span>
      <span class="tchip" id="tc-uf">UF —</span>
      <span class="tchip" id="tc-act" style="color:rgba(255,255,255,0.25)">—</span>
      <button class="tbtn" onclick="showCL()">☑ Checklist</button>
      <button class="tbtn" onclick="doLogout()">Salir</button>
    </div>
  </div>

  <div class="tabbar">
    <div class="tab on" id="tab-ventas" onclick="goTab('ventas')">Ventas</div>
    <div class="tab" id="tab-pnl" onclick="goTab('pnl')">P&amp;L</div>
    <div class="tab" id="tab-inv" onclick="goTab('inv')">Inventario</div>
  </div>

  <!-- ── TAB VENTAS ── -->
  <div id="view-ventas">
    <div class="fbar">
      <span class="flbl">Período</span>
      <select class="fsel" id="f-anio" onchange="render()"><option value="0">Todo</option></select>
      <select class="fsel" id="f-mes" onchange="render()">
