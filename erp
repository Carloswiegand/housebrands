// ── CONVERSIÓN ───────────────────────────────────────
let CONV_DATA=[];

async function loadConv(){
  try{
    const r=await fetch(CSV_CONV);
    CONV_DATA=parseConv(await r.text());
    convLoaded=true;
    document.getElementById('conv-loading').style.display='none';
    document.getElementById('conv-dash').style.display='block';
    renderConv();
  }catch(e){
    document.getElementById('conv-loading').innerHTML='<p style="color:var(--neg);font-family:var(--mono);font-size:11px">Error cargando conversión.<br><button onclick="loadConv()" style="margin-top:12px;padding:7px 16px;background:var(--night);border:none;color:#fff;border-radius:4px;cursor:pointer;font-family:var(--mono);font-size:10px">Reintentar</button></p>';
  }
}

function parseConv(txt){
  const lines=txt.split('
').filter(l=>l.trim());
  if(lines.length<2)return[];
  const MESES_ES={enero:1,febrero:2,marzo:3,abril:4,mayo:5,junio:6,julio:7,agosto:8,septiembre:9,octubre:10,noviembre:11,diciembre:12};
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<7)continue;
    const mesNom=c[0]?.trim().toLowerCase()||'';
    const anio=parseInt(c[1])||0;
    const canal=c[2]?.trim()||'';
    const sesiones=pn(c[3]),carro=pn(c[4]),pasarela=pn(c[5]),compras=pn(c[6]);
    if(!canal||!anio||sesiones<=0)continue;
    const mesN=MESES_ES[mesNom]||0;
    const mesKey=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][mesN]||mesNom;
    rows.push({
      mes:mesN,mesNom:mesKey,anio,canal,sesiones,carro,pasarela,compras,
      pctCarro:sesiones>0?(carro/sesiones*100):0,
      pctPasarela:carro>0?(pasarela/carro*100):0,
      pctConv:sesiones>0?(compras/sesiones*100):0,
      abandono:carro>0?((carro-compras)/carro*100):0,
    });
  }
  return rows.sort((a,b)=>a.anio!==b.anio?a.anio-b.anio:a.mes-b.mes);
}

function renderConv(){
  if(!CONV_DATA.length){
    document.getElementById('conv-kgrid').innerHTML='<div style="grid-column:span 4;font-family:var(--mono);font-size:11px;color:var(--light);padding:20px 0">Sin datos — ingresa datos en la hoja Conversion del Sheets.</div>';
    return;
  }

  // Último período disponible para KPIs
  const lastAnio=Math.max(...CONV_DATA.map(r=>r.anio));
  const lastMes=Math.max(...CONV_DATA.filter(r=>r.anio===lastAnio).map(r=>r.mes));
  const lastPeriod=CONV_DATA.filter(r=>r.anio===lastAnio&&r.mes===lastMes);

  const shRows=lastPeriod.filter(r=>r.canal.includes('Shopify'));
  const mlRows=lastPeriod.filter(r=>r.canal==='ML');

  const totSesiones=CONV_DATA.reduce((s,r)=>s+r.sesiones,0);
  const totCompras=CONV_DATA.reduce((s,r)=>s+r.compras,0);
  const convGlobal=totSesiones>0?(totCompras/totSesiones*100):0;

  const shSes=shRows.reduce((s,r)=>s+r.sesiones,0);
  const shComp=shRows.reduce((s,r)=>s+r.compras,0);
  const shCarro=shRows.reduce((s,r)=>s+r.carro,0);
  const convSH=shSes>0?(shComp/shSes*100):0;
  const abandSH=shCarro>0?((shCarro-shComp)/shCarro*100):0;

  const mlSes=mlRows.reduce((s,r)=>s+r.sesiones,0);
  const mlComp=mlRows.reduce((s,r)=>s+r.compras,0);
  const convML=mlSes>0?(mlComp/mlSes*100):0;

  const periodoLbl=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][lastMes]+' '+lastAnio;
  document.getElementById('conv-sh-periodo').textContent=periodoLbl;
  document.getElementById('conv-ml-periodo').textContent=periodoLbl;

  // KPIs
  document.getElementById('conv-kgrid').innerHTML=[
    {lbl:'CONVERSIÓN SHOPIFY',num:convSH.toFixed(2)+'%',sub:'último período: '+periodoLbl,acc:'var(--sh)',
     delta:convSH>=2?{c:'d-pos',t:'Buena'}:convSH>=1?{c:'d-warn',t:'OK'}:{c:'d-neg',t:'Baja'}},
    {lbl:'CONVERSIÓN ML',num:convML.toFixed(2)+'%',sub:'visitas → compra',acc:'var(--ml)',
     delta:convML>=2?{c:'d-pos',t:'Buena'}:convML>=1?{c:'d-warn',t:'OK'}:{c:'d-neg',t:'Baja'}},
    {lbl:'ABANDONO CARRITO SH',num:abandSH.toFixed(1)+'%',sub:shCarro>0?(shCarro-shComp)+' carritos no completados':'sin datos',acc:'var(--warn)',
     delta:abandSH<70?{c:'d-pos',t:'Normal'}:{c:'d-warn',t:'Alto'}},
    {lbl:'SESIONES TOTALES',num:shSes>0?(shSes+mlSes).toLocaleString('es-CL'):'—',sub:'SH: '+shSes.toLocaleString('es-CL')+' · ML: '+mlSes.toLocaleString('es-CL'),acc:'var(--mid)',
     delta:{c:'d-neu',t:periodoLbl}},
  ].map(k=>`<div class="kcard">
    <div class="kcard-accent" style="background:${k.acc}"></div>
    <div class="kcard-label">${k.lbl}</div>
    <div class="kcard-num">${k.num}</div>
    <div class="kcard-sub">${k.sub}</div>
    <div class="kdelta ${k.delta.c}">${k.delta.t}</div>
  </div>`).join('');

  // Funnels
  renderFunnel('conv-funnel-sh', shRows, true);
  renderFunnel('conv-funnel-ml', mlRows, false);

  // Tendencia
  renderConvTrend();

  // Tabla
  renderConvTable();
}

function renderFunnel(containerId, rows, isShopify){
  const el=document.getElementById(containerId);
  if(!el)return;
  if(!rows.length){el.innerHTML='<div style="font-family:var(--mono);font-size:10px;color:var(--light);padding:20px 0">Sin datos para este período</div>';return;}
  const ses=rows.reduce((s,r)=>s+r.sesiones,0);
  const car=rows.reduce((s,r)=>s+r.carro,0);
  const pas=rows.reduce((s,r)=>s+r.pasarela,0);
  const com=rows.reduce((s,r)=>s+r.compras,0);

  const steps=isShopify
    ?[{lbl:'Sesiones',val:ses,pct:100},{lbl:'Al carrito',val:car,pct:ses>0?(car/ses*100):0},{lbl:'Pasarela',val:pas,pct:ses>0?(pas/ses*100):0},{lbl:'Compra',val:com,pct:ses>0?(com/ses*100):0}]
    :[{lbl:'Visitas',val:ses,pct:100},{lbl:'Intención',val:car,pct:ses>0?(car/ses*100):0},{lbl:'Compra',val:com,pct:ses>0?(com/ses*100):0}];

  const maxVal=steps[0].val||1;
  const color=isShopify?'var(--sh)':'var(--ml)';

  el.innerHTML=steps.map((s,i)=>{
    const w=Math.max(8,(s.val/maxVal)*100);
    const dropPct=i>0&&steps[i-1].val>0?((steps[i-1].val-s.val)/steps[i-1].val*100).toFixed(1):null;
    return`<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
        <span style="font-family:var(--mono);font-size:10px;color:var(--mid)">${s.lbl}</span>
        <div style="text-align:right">
          <span style="font-size:18px;font-weight:600;letter-spacing:-.03em;color:var(--night)">${s.val.toLocaleString('es-CL')}</span>
          <span style="font-family:var(--mono);font-size:9px;color:var(--light);margin-left:6px">${s.pct.toFixed(1)}%</span>
        </div>
      </div>
      <div style="height:8px;background:var(--bg);border-radius:4px;overflow:hidden">
        <div style="height:100%;width:${w}%;background:${color};border-radius:4px;opacity:${1-(i*0.15)}"></div>
      </div>
      ${dropPct&&i>0?`<div style="font-family:var(--mono);font-size:9px;color:var(--neg);margin-top:2px">↓ ${dropPct}% drop del paso anterior</div>`:''}
    </div>`;
  }).join('');
}

function renderConvTrend(){
  const byMes={};
  CONV_DATA.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byMes[k])byMes[k]={lbl:r.mesNom+' '+r.anio,sh:{ses:0,com:0},ml:{ses:0,com:0}};
    if(r.canal.includes('Shopify')){byMes[k].sh.ses+=r.sesiones;byMes[k].sh.com+=r.compras;}
    if(r.canal==='ML'){byMes[k].ml.ses+=r.sesiones;byMes[k].ml.com+=r.compras;}
  });
  const sorted=Object.entries(byMes).sort((a,b)=>a[0].localeCompare(b[0]));
  if(!sorted.length)return;

  const shConv=sorted.map(([,v])=>v.sh.ses>0?(v.sh.com/v.sh.ses*100):0);
  const mlConv=sorted.map(([,v])=>v.ml.ses>0?(v.ml.com/v.ml.ses*100):0);
  const lbls=sorted.map(([,v])=>v.lbl);
  const maxV=Math.max(...shConv,...mlConv,1);

  const w=100/sorted.length;
  let svgH='<div style="position:relative;height:100px">';
  // Línea SH
  const shPts=shConv.map((v,i)=>`${(i/(sorted.length-1||1)*100).toFixed(1)}%,${(100-(v/maxV*90)).toFixed(1)}%`).join(' ');
  const mlPts=mlConv.map((v,i)=>`${(i/(sorted.length-1||1)*100).toFixed(1)}%,${(100-(v/maxV*90)).toFixed(1)}%`).join(' ');

  // Usar barras simples por simplicidad
  svgH+='<div style="display:flex;align-items:flex-end;gap:4px;height:100%">';
  sorted.forEach(([,v],i)=>{
    const csh=v.sh.ses>0?(v.sh.com/v.sh.ses*100):0;
    const cml=v.ml.ses>0?(v.ml.com/v.ml.ses*100):0;
    const hsh=Math.max(csh>0?3:0,(csh/maxV)*90);
    const hml=Math.max(cml>0?3:0,(cml/maxV)*90);
    svgH+=`<div style="flex:1;display:flex;gap:2px;align-items:flex-end;height:100%">
      <div style="flex:1;height:${hsh}px;background:var(--sh);border-radius:2px 2px 0 0;opacity:.8" title="SH ${lbls[i]}: ${csh.toFixed(2)}%"></div>
      <div style="flex:1;height:${hml}px;background:var(--ml);border-radius:2px 2px 0 0;opacity:.8" title="ML ${lbls[i]}: ${cml.toFixed(2)}%"></div>
    </div>`;
  });
  svgH+='</div></div>';

  document.getElementById('conv-trend').innerHTML=svgH;
  document.getElementById('conv-trend-lbls').innerHTML=sorted.map(([,v])=>`
    <div style="flex:1;text-align:center;font-family:var(--mono);font-size:8px;color:var(--light)">${v.lbl.slice(0,6)}</div>`).join('');
}

function renderConvTable(){
  const rows=[...CONV_DATA].reverse();
  document.getElementById('conv-tbody').innerHTML=rows.map(r=>{
    const bcC=r.canal.includes('Shopify')?'b-sh':r.canal==='ML'?'b-ml':'b-vd';
    const convColor=r.pctConv>=2?'var(--pos)':r.pctConv>=1?'var(--warn)':'var(--neg)';
    return`<tr>
      <td>${r.mesNom} ${r.anio}</td>
      <td><span class="bdg ${bcC}">${r.canal}</span></td>
      <td>${r.sesiones.toLocaleString('es-CL')}</td>
      <td>${r.carro.toLocaleString('es-CL')}</td>
      <td style="color:var(--mid)">${r.pctCarro.toFixed(1)}%</td>
      <td>${r.pasarela>0?r.pasarela.toLocaleString('es-CL'):'—'}</td>
      <td style="color:var(--mid)">${r.pasarela>0?r.pctPasarela.toFixed(1)+'%':'—'}</td>
      <td style="font-weight:600">${r.compras}</td>
      <td><span style="color:${convColor};font-weight:600">${r.pctConv.toFixed(2)}%</span></td>
      <td style="color:var(--warn)">${r.abandono.toFixed(1)}%</td>
    </tr>`;
  }).join('');
}

