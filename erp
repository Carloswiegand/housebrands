// TABS
let pnlLoaded=false;
function goTab(t){
  ['ventas','pnl','inv'].forEach(x=>{
    document.getElementById('view-'+x).style.display=x===t?'block':'none';
    document.getElementById('tab-'+x).className='tab'+(x===t?' on':'');
  });
  if(t==='pnl'&&!pnlLoaded)loadPnL();
  if(t==='inv')renderInv();
}

let DATA=[],PNL={meses:[],rows:[]},fMarca='Todas',fCanal='Todos';

function initApp(){
  fetchTC();
  loadVentas();
}

async function fetchTC(){
  try{
    const hoy=new Date(),d=hoy.getDate(),m=hoy.getMonth()+1,a=hoy.getFullYear();
    const ds=`${d}-${String(m).padStart(2,'0')}-${a}`;
    const[ru,rf]=await Promise.all([
      fetch('https://mindicador.cl/api/dolar/'+ds).then(r=>r.json()).catch(()=>null),
      fetch('https://mindicador.cl/api/uf/'+ds).then(r=>r.json()).catch(()=>null)
    ]);
    const usd=ru?.serie?.[0]?.valor,uf=rf?.serie?.[0]?.valor;
    if(usd)document.getElementById('tc-usd').textContent='USD $'+Math.round(usd).toLocaleString('es-CL');
    if(uf)document.getElementById('tc-uf').textContent='UF $'+Math.round(uf).toLocaleString('es-CL');
  }catch(e){}
  document.getElementById('tc-act').textContent='act. '+new Date().toLocaleTimeString('es-CL',{hour:'2-digit',minute:'2-digit'});
}

async function loadVentas(){
  try{
    const r=await fetch(CSV_V);
    DATA=parseVentas(await r.text());
    const years=[...new Set(DATA.map(r=>r.anio))].sort();
    const sel=document.getElementById('f-anio');
    years.forEach(y=>{const o=document.createElement('option');o.value=y;o.textContent=y;sel.appendChild(o);});
    document.getElementById('v-loading').style.display='none';
    document.getElementById('v-dash').style.display='block';
    render();
  }catch(e){
    document.getElementById('v-loading').innerHTML='<p style="color:var(--neg);font-family:var(--mono);font-size:11px">Error al cargar datos.<br><button onclick="loadVentas()" style="margin-top:12px;padding:7px 16px;background:var(--night);border:none;color:#fff;border-radius:4px;cursor:pointer;font-family:var(--mono);font-size:10px">Reintentar</button></p>';
  }
}

function parseVentas(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<2)return[];
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<20)continue;
    const marca=c[4]?.trim()||'';
    if(!marca)continue;
    const canal=c[5]?.trim()||'';
    const mes=parseInt(c[1])||0,anio=parseInt(c[3])||0;
    const sku=c[7]?.trim()||'',prod=c[8]?.trim()||'';
    const qty=parseInt(c[9])||1;
    const vb=pn(c[11]),costoUnit=pn(c[17]),costoTotal=pn(c[18]);
    const mb=pn(c[19]),mrg=pn(c[20]);
    const envio=pn(c[12]),cargoMP=pn(c[13]),descto=pn(c[15]);
    if(vb<=0)continue;
    const comision=cargoMP;
    const icn=vb-comision;
    let fecha=c[0]?.trim()||'';
    const dmy=fecha.match(/^(\d{2})[\-\/](\d{2})[\-\/](\d{4})$/);
    if(dmy)fecha=dmy[3]+'-'+dmy[2]+'-'+dmy[1];
    rows.push({fecha,mes,anio,marca,canal,sku,prod,qty,vb,costoUnit,costoTotal,mb,mrg,envio,cargoMP,descto,comision,icn});
  }
  return rows;
}

// FILTROS
function sfm(v,el){
  fMarca=v;
  ['fm-t','fm-mk','fm-mt'].forEach(id=>document.getElementById(id).className='fpill');
  el.className=v==='MemoKoala'?'fpill mk':v==='Montana'?'fpill mt':'fpill on';
  render();
}
function sfc(v,el){
  fCanal=v;
  ['fc-t','fc-sh','fc-ml'].forEach(id=>document.getElementById(id).className='fpill');
  el.className='fpill on';
  render();
}
function fd(){
  const anio=parseInt(document.getElementById('f-anio').value)||0;
  const mes=parseInt(document.getElementById('f-mes').value)||0;
  return DATA.filter(r=>{
    if(fMarca!=='Todas'&&r.marca!==fMarca)return false;
    if(fCanal!=='Todos'&&r.canal!==fCanal)return false;
    if(anio&&r.anio!==anio)return false;
    if(mes&&r.mes!==mes)return false;
    return true;
  });
}
function render(){const d=fd();rKPIs(d);rGastos(d);rTrend(d);rCanal(d);rSKU(d);}

// KPIs principales
function rKPIs(d){
  const vb=sum(d,'vb'),mb=sum(d,'mb'),icn=sum(d,'icn'),comision=sum(d,'comision');
  const un=d.reduce((s,r)=>s+r.qty,0),cnt=d.length;
  const tk=un>0?vb/un:0,mrg=vb>0?mb/vb:0;
  const meses=[...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg=vb/meses,gap=avg/META-1;
  const mc=mrg>=.65?'pos':mrg>=.45?'warn':'neg';
  const byM={};
  d.forEach(r=>{const k=r.anio+'-'+String(r.mes).padStart(2,'0');byM[k]=(byM[k]||0)+r.vb;});
  const spk=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0])).slice(-8).map(([,v])=>v);
  const sm=Math.max(...spk,1);
  const mkSpk=(c)=>spk.map(v=>`<div class="ksbar" style="height:${Math.max(10,(v/sm)*100)}%;background:${c}"></div>`).join('');

  document.getElementById('kgrid').innerHTML=[
    {lbl:'VENTA BRUTA',num:clp(vb),sub:cnt+' órdenes · '+un+' uds',
     delta:gap>=0?{c:'d-pos',t:'↑ +'+Math.abs(gap*100).toFixed(1)+'% vs meta'}:{c:'d-neg',t:'↓ '+Math.abs(gap*100).toFixed(1)+'% vs meta'},
     acc:'#8AA4B4',spk:'#D6E4EC'},
    {lbl:'INGRESO NETO COM.',num:clp(icn),sub:'venta − comisión pasarela',
     delta:{c:'d-neu',t:(vb>0?(comision/vb*100).toFixed(1):0)+'% en comisiones'},
     acc:'#4A6274',spk:'#8AA4B4'},
    {lbl:'MARGEN BRUTO',num:(mrg*100).toFixed(1)+'%',numcls:mc,sub:clp(mb)+' · pvp − costo×1.19',
     delta:mrg>=.65?{c:'d-pos',t:'Saludable'}:mrg>=.45?{c:'d-warn',t:'OK'}:{c:'d-neg',t:'Revisar'},
     acc:'#3d7a62',spk:'#3d7a62'},
    {lbl:'TICKET PROMEDIO',num:clp(tk),sub:'por unidad · '+meses+' mes'+(meses>1?'es':''),
     delta:{c:'d-neu',t:cnt+' transacciones'},
     acc:'#b85a2a',spk:'#b85a2a'},
  ].map(k=>`
    <div class="kcard">
      <div class="kcard-accent" style="background:${k.acc}"></div>
      <div class="kcard-label">${k.lbl}</div>
      <div class="kcard-num${k.numcls?' '+k.numcls:''}">${k.num}</div>
      <div class="kcard-sub">${k.sub}</div>
      <div class="kcard-delta ${k.delta.c}">${k.delta.t}</div>
      <div class="kcard-spark">${mkSpk(k.spk)}</div>
    </div>`).join('');
}

// KPIs gastos (% de venta)
function rGastos(d){
  const vb=sum(d,'vb')||1;
  const envCobrado=sum(d.filter(r=>r.canal==='Shopify'),'envio');
  const comisionSH=sum(d.filter(r=>r.canal==='Shopify'),'comision');
  const comisionML=sum(d.filter(r=>r.canal==='ML'),'comision');
  const pEnvio=envCobrado/vb*100;
  const pComSH=comisionSH/vb*100;
  const pComML=comisionML/vb*100;
  const gastos=[
    {icon:'🚚',lbl:'Envío cobrado clientes',num:pEnvio.toFixed(1)+'%',sub:clp(envCobrado)+' recuperado',bg:'#EBF2FA'},
    {icon:'💳',lbl:'Comisión Shopify (MP)',num:pComSH.toFixed(1)+'%',sub:clp(comisionSH)+' total',bg:'#EBF2FA'},
    {icon:'🛒',lbl:'Comisión MercadoLibre',num:pComML.toFixed(1)+'%',sub:clp(comisionML)+' total',bg:'#FDF6E3'},
    {icon:'📦',lbl:'ABEE Fulfillment',num:'—',sub:'ver P&L para dato mensual',bg:'#F5F8FA'},
    {icon:'📣',lbl:'Inversión en Ads',num:'—',sub:'ver P&L para dato mensual',bg:'#F5F8FA'},
  ];
  document.getElementById('gkgrid').innerHTML=gastos.map(g=>`
    <div class="gcard">
      <div class="gcard-icon" style="background:${g.bg}">${g.icon}</div>
      <div class="gcard-body">
        <div class="gcard-label">${g.lbl}</div>
        <div class="gcard-num">${g.num}</div>
        <div class="gcard-sub">${g.sub}</div>
      </div>
    </div>`).join('');
}

// Gráfico tendencia
function rTrend(d){
  const byM={};
  d.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k])byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;
  });
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('trend-bars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt,h=Math.max(2,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2,hmt=h-hmk;
    return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0">
      <div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%">
        <div style="height:${hmt}px;background:var(--mt);opacity:0.6;border-radius:2px 2px 0 0;width:100%" title="${v.lbl}: ${clp(tot)}"></div>
        <div style="height:${hmk}px;background:var(--mk);width:100%" title="${v.lbl}: ${clp(tot)}"></div>
      </div>
    </div>`;
  }).join('');
  document.getElementById('trend-lbls').innerHTML=sorted.map(([,v])=>`
    <div style="flex:1;text-align:center;font-family:var(--mono);font-size:7px;color:var(--light)">${v.lbl}</div>`).join('');
}

// Canal
function rCanal(d){
  const ch={};
  d.forEach(r=>{
    if(!ch[r.canal])ch[r.canal]={vb:0,mb:0,comision:0,envio:0};
    ch[r.canal].vb+=r.vb;ch[r.canal].mb+=r.mb;
