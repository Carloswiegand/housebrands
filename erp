      <div class="hbar-val">${clp(v.vb)}</div>
    </div>`).join('');
}

function renderRecentTx(d) {
  const sorted=[...d].sort((a,b)=>b.fecha.localeCompare(a.fecha)).slice(0,15);
  document.getElementById('tx-count').textContent=d.length+' ventas';
  document.getElementById('recent-tx').innerHTML=sorted.map(r=>{
    const mc=mColor(r.mrg);
    return `<tr>
      <td>${r.fecha.slice(5)}</td>
      <td><span class="bdg ${r.marca==='MemoKoala'?'b-mk':'b-mt'}">${r.marca==='MemoKoala'?'MK':'MT'}</span></td>
      <td><span class="bdg ${r.canal==='Shopify'?'b-sh':'b-ml'}">${r.canal}</span></td>
      <td>${(r.prod||'').slice(0,22)}</td>
      <td>${clp(r.vb)}</td>
      <td><div class="mrg-bar"><span style="color:${mc};font-weight:500">${r.mrg.toFixed(1)}%</span>
        <div class="mrg-mini"><div class="mrg-fill" style="width:${Math.min(100,r.mrg).toFixed(0)}%;background:${mc}"></div></div>
      </div></td>
    </tr>`;
  }).join('');
}

function renderSkuTable(d) {
  const s={};
  d.forEach(r=>{
    if(!s[r.sku])s[r.sku]={nom:r.prod,marca:r.marca,un:0,vb:0,costo:0,mb:0};
    s[r.sku].un+=r.qty;s[r.sku].vb+=r.vb;s[r.sku].costo+=r.costo;s[r.sku].mb+=r.mb;
  });
  document.getElementById('sku-table').innerHTML=Object.values(s).sort((a,b)=>b.vb-a.vb).map(r=>{
    const mp=r.vb>0?(r.mb/r.vb)*100:0,mc=mColor(mp);
    return `<tr>
      <td style="font-weight:500;color:var(--ink);font-family:var(--mono);font-size:11px">${r.sku||'—'}</td>
      <td>${r.nom||'—'}</td>
      <td><span class="bdg ${r.marca==='MemoKoala'?'b-mk':'b-mt'}">${r.marca==='MemoKoala'?'🐨 MK':'🔪 MT'}</span></td>
      <td>${r.un}</td><td>${clp(r.vb)}</td><td>${clp(r.costo)}</td><td>${clp(r.mb)}</td>
      <td><div class="mrg-bar"><span style="color:${mc};font-weight:500">${mp.toFixed(1)}%</span>
        <div class="mrg-mini"><div class="mrg-fill" style="width:${Math.min(100,mp).toFixed(0)}%;background:${mc}"></div></div>
      </div></td>
    </tr>`;
  }).join('');
}

// ── RENDER P&L ────────────────────────────────────────────
function renderPnL() {
  const {meses, rows} = PNL_DATA;
  if(!rows.length) return;

  // Helper: find row by concepto (partial match)
  const findRow = (term) => rows.find(r=>r.concepto.toUpperCase().includes(term.toUpperCase()));
  const findRows = (terms) => rows.filter(r=>terms.some(t=>r.concepto.toUpperCase().includes(t.toUpperCase())));

  // Total column is last value in valores array
  const totalIdx = meses.length - 1; // last col is TOTAL

  // Key rows
  const vbTot    = findRow('VENTA BRUTA TOTAL');
  const mbTot    = findRow('MARGEN BRUTO TOTAL');
  const logNeto  = findRow('TOTAL LOGÍSTICO');
  const mktTot   = findRow('TOTAL MARKETING');
  const techTot  = findRow('TOTAL TECH');
  const admTot   = findRow('TOTAL ADMINISTRACIÓN');
  const resultado= findRow('RESULTADO NETO');

  // KPIs
  const getTotal = row => row ? row.valores[totalIdx]||0 : 0;
  const vbT  = getTotal(vbTot);
  const mbT  = getTotal(mbTot);
  const resT = getTotal(resultado);
  const mrgP = vbT>0?mbT/vbT:0;

  // Count profitable months (excluding TOTAL col)
  const mesesData = meses.slice(0,-1); // exclude TOTAL
  const mesesPos  = resultado ? resultado.valores.slice(0,-1).filter(v=>v>0).length : 0;

  document.getElementById('pnl-kpi-grid').innerHTML = [
    {lbl:'Venta Bruta Total',val:clp(vbT),sub:mesesData.length+' meses',accent:'#3d7a62',tag:'',cls:''},
    {lbl:'Margen Bruto Total',val:clp(mbT),sub:(mrgP*100).toFixed(1)+'% sobre venta',accent:'#c9a227',tag:mrgP>=.65?'Saludable':'Revisar',cls:mrgP>=.65?'tag-up':'tag-dn'},
    {lbl:'Resultado Neto',val:clp(resT),sub:'acumulado',accent:resT>=0?'#27a05a':'#c0392b',tag:resT>=0?'Positivo':'Negativo',cls:resT>=0?'tag-up':'tag-dn'},
    {lbl:'Meses Positivos',val:mesesPos+'/'+mesesData.length,sub:'meses con resultado >0',accent:'#1a3a5c',tag:'',cls:''},
    {lbl:'Total Gastos Op.',val:clp(getTotal(logNeto)+getTotal(mktTot)+getTotal(techTot)+getTotal(admTot)),sub:'logística+marketing+tech+admin',accent:'#b85a2a',tag:'',cls:''},
    {lbl:'% Gasto / Venta',val:vbT>0?((getTotal(logNeto)+getTotal(mktTot)+getTotal(techTot)+getTotal(admTot))/vbT*100).toFixed(1)+'%':'0%',sub:'sobre venta bruta',accent:'#5a2a8a',tag:'',cls:''},
  ].map(k=>`
    <div class="kpi fade-up" style="--accent:${k.accent}">
      <div class="kpi-label">${k.lbl}</div>
      <div class="kpi-val">${k.val}</div>
      ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');

  // Resultado mensual bars
  if(resultado) {
    const mesVals = resultado.valores.slice(0,-1);
    const maxAbs  = Math.max(...mesVals.map(v=>Math.abs(v)),1);
    document.getElementById('pnl-result-bars').innerHTML = mesVals.map((v,i)=>{
      const h=Math.max(3,(Math.abs(v)/maxAbs)*110);
      const color=v>=0?'var(--green)':'var(--red)';
      const lbl=mesesData[i]||'';
      return `<div class="mbar-col">
        <div class="mbar-wrap">
          <div class="mbar" style="height:${h}px;background:${color};opacity:.85" data-tip="${lbl}: ${clp(v)}"></div>
        </div>
        <div class="mbar-lbl">${lbl.slice(0,6)}</div>
      </div>`;
    }).join('');
  }

  // Gastos breakdown bars
  const gastoRows = [
    {label:'Logístico Neto', row: logNeto,  color:'var(--mt)'},
    {label:'Marketing',      row: mktTot,   color:'#5a2a8a'},
    {label:'Tech & Software',row: techTot,  color:'#1a3a5c'},
    {label:'Administración', row: admTot,   color:'#4e342e'},
  ];
  const maxGasto = Math.max(...gastoRows.map(g=>getTotal(g.row)),1);
  document.getElementById('gasto-bars').innerHTML = gastoRows.map(g=>`
    <div class="hbar-row">
      <div class="hbar-lbl">${g.label}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${(getTotal(g.row)/maxGasto*100).toFixed(1)}%;background:${g.color}"></div></div>
      <div class="hbar-val">${clp(getTotal(g.row))}</div>
    </div>`).join('');

  // Métricas Marca × Canal
  const mkShRow = findRow('MemoKoala × Shopify');
  const mkMlRow = findRow('MemoKoala × MercadoLibre');
  const mtShRow = findRow('Montana × Shopify');
  const mtMlRow = findRow('Montana × MercadoLibre');

  const renderCanalMetrics = (shRow, mlRow, containerId) => {
    if(!shRow && !mlRow) {
      document.getElementById(containerId).innerHTML = '<div style="font-family:var(--mono);font-size:11px;color:var(--ink-dim)">Sin datos de métricas × canal</div>';
      return;
    }
    const channels = [
      {label:'Shopify', row:shRow, color:'var(--green)'},
      {label:'MercadoLibre', row:mlRow, color:'var(--gold)'},
    ];
    document.getElementById(containerId).innerHTML = channels.map(ch=>{
      if(!ch.row) return '';
      const vals = ch.row.valores.slice(0,-1);
      const avg  = vals.filter(v=>v!==0).reduce((s,v)=>s+v,0)/Math.max(vals.filter(v=>v!==0).length,1);
      const mc   = mColor(avg);
      return `<div style="margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;margin-bottom:6px">
          <span class="bdg ${ch.label==='Shopify'?'b-sh':'b-ml'}">${ch.label}</span>
          <span style="font-family:var(--serif);font-size:20px;color:${mc}">${avg.toFixed(1)}%</span>
        </div>
        <div style="height:5px;background:var(--cream-dark);border-radius:3px;overflow:hidden">
          <div style="height:100%;width:${Math.min(100,avg).toFixed(1)}%;background:${ch.color};border-radius:3px"></div>
        </div>
        <div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);margin-top:5px">promedio de meses con venta</div>
      </div>`;
    }).join('');
  };

  renderCanalMetrics(mkShRow, mkMlRow, 'pnl-mk-canal');
  renderCanalMetrics(mtShRow, mtMlRow, 'pnl-mt-canal');

  // Tabla P&L completa
  const SECTIONS = [
    {marker:'INGRESOS',      bg:'#2E7D32'},
    {marker:'MARGEN',        bg:'#1b5e20'},
    {marker:'LOGÍSTICOS',    bg:'#E65100'},
    {marker:'MARKETING',     bg:'#4A148C'},
    {marker:'TECH',          bg:'#1565C0'},
    {marker:'ADMINISTRACIÓN',bg:'#4E342E'},
    {marker:'RESULTADO',     bg:'#111111'},
    {marker:'MÉTRICAS',      bg:'#37474F'},
  ];

  const mesHeaders = mesesData.map(m=>`<div class="pnl-header-cell">${m}</div>`).join('');
  let html = `<div style="overflow-x:auto"><div style="min-width:${220+175+(mesesData.length+1)*90}px">`;
  html += `<div class="pnl-header-row">
    <div class="pnl-header-concept">Concepto</div>
    <div class="pnl-header-cell" style="min-width:175px;text-align:left;color:var(--ink-light)">Categoría</div>
    ${mesHeaders}
    <div class="pnl-header-total">Total</div>
  </div>`;

  rows.forEach(row=>{
    const sec = SECTIONS.find(s=>row.concepto.toUpperCase().includes(s.marker));
    if(sec && (row.concepto.startsWith('▶') || row.categoria==='')) {
      html += `<div class="pnl-subhdr" style="background:${sec.bg}">
        <div class="pnl-subhdr-txt" style="min-width:${220+175}px">${row.concepto}</div>
        ${mesesData.map(()=>'<div style="min-width:90px"></div>').join('')}
        <div style="min-width:110px"></div>
      </div>`;
      return;
    }

    const isBold = row.concepto.startsWith('TOTAL')||row.concepto.startsWith('VENTA BRUTA TOTAL')||row.concepto.startsWith('MARGEN BRUTO TOTAL')||row.concepto.startsWith('RESULTADO');
    const isResultado = row.concepto.startsWith('RESULTADO NETO');
    const mesVals = row.valores.slice(0,-1);
    const total   = row.valores[row.valores.length-1]||0;

    const cellStyle = (v) => {
      if(isResultado) return v>=0?'color:var(--green);font-weight:700':'color:var(--red);font-weight:700';
      return '';
    };

    html += `<div class="pnl-data-row ${isBold?'bold':''}">
      <div class="pnl-concept">${row.concepto}</div>
      <div class="pnl-cell" style="min-width:175px;text-align:left;color:var(--ink-dim);font-size:9px">${row.categoria}</div>
      ${mesVals.map(v=>`<div class="pnl-cell" style="${cellStyle(v)}">${clp(v)}</div>`).join('')}
      <div class="pnl-total-cell" style="${cellStyle(total)}">${clp(total)}</div>
    </div>`;
  });

  html += '</div></div>';
  document.getElementById('pnl-table-wrap').innerHTML = html;
}

// ── CHECKLIST ─────────────────────────────────────────────
function showChecklist(){document.getElementById('checklist-modal').style.display='block';document.body.style.overflow='hidden'}
function hideChecklist(){document.getElementById('checklist-modal').style.display='none';document.body.style.overflow=''}
function clToggle(el){el.classList.toggle('done');clUpdateProgress()}
function clUpdateProgress(){const t=document.querySelectorAll('.cl-item').length,d=document.querySelectorAll('.cl-item.done').length;document.getElementById('cl-prog').style.width=(t>0?(d/t*100).toFixed(0):0)+'%'}
function clReset(){document.querySelectorAll('.cl-item').forEach(el=>el.classList.remove('done'));clUpdateProgress()}
document.addEventListener('keydown',e=>{if(e.key==='Escape')hideChecklist()});
</script>
