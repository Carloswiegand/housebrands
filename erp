      <div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);margin-top:5px">${clp(v.vb)} bruto · ${clp(v.mb)} margen</div>
    </div>`;
  }).join('');
}

function renderProdBars(d){
  const p={};
  d.forEach(r=>{if(!p[r.sku])p[r.sku]={nom:r.prod,vb:0,marca:r.marca};p[r.sku].vb+=r.vb;});
  const sorted=Object.entries(p).sort((a,b)=>b[1].vb-a[1].vb).slice(0,9);
  const mx=sorted[0]?.[1]?.vb||1;
  document.getElementById('prod-bars').innerHTML=sorted.map(([sku,v])=>`
