    const tds=idxs.map(i=>{const v=row.mv[i]||0;return`<td>${v?v.toFixed(1)+'%':'—'}</td>`;}).join('');
    html+=`<tr class="compact"><td>${row.concepto}</td>${tds}<td class="td-tot">${pavg(row.mv).toFixed(1)}%</td></tr>`;
  });

  html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:#263238">▶ MARCA × CANAL</td></tr>`;
  [{lbl:'MemoKoala × Shopify',vR:'Venta MemoKoala × Shopify',mR:'% Margen MemoKoala × Shopify'},
   {lbl:'MemoKoala × ML',vR:'Venta MemoKoala × MercadoLibre',mR:'% Margen MemoKoala × MercadoLibre'},
   {lbl:'Montana × Shopify',vR:'Venta Montana × Shopify',mR:'% Margen Montana × Shopify'},
   {lbl:'Montana × ML',vR:'Venta Montana × MercadoLibre',mR:'% Margen Montana × MercadoLibre'}].forEach(({lbl,vR,mR})=>{
    const vRow=fr(vR),mRow=fr(mR);if(!vRow)return;
    const tds=idxs.map(i=>{const v=vRow.mv[i]||0,m=mRow?(mRow.mv[i]||0):0;return`<td>${v?clp(v):'—'}${m?`<br><span style="font-size:9px;color:${m>=65?'var(--pos)':m>=45?'var(--warn)':'var(--neg)'}">${m.toFixed(1)}%</span>`:''}</td>`;}).join('');
    const vtot=ps(vRow.mv),mavg=mRow?pavg(mRow.mv):0;
    html+=`<tr class="compact"><td>${lbl}</td>${tds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${mavg>=65?'#1a7a45':'#c0392b'}">${mavg.toFixed(1)}%</span></td></tr>`;
  });

  html+='</tbody></table>';
  document.getElementById('pnl-table-wrap').innerHTML=html;
}

