  }
}

function parsePnLCSV(text){
  // Force UTF-8 decode — fix garbled chars
  const lines=text.split('\n').filter(l=>l.trim());
  if(lines.length<3) return {meses:[],rows:[]};

  // Find header row with CONCEPTO
  let hdrIdx=-1;
  for(let i=0;i<Math.min(lines.length,6);i++){
    if(lines[i].toUpperCase().includes('CONCEPTO')){hdrIdx=i;break;}
  }
  if(hdrIdx===-1) hdrIdx=2;

  const hdrCols=splitCSV(lines[hdrIdx]);
  // Cols: 0=CONCEPTO, 1=CATEGORIA, 2..N-1=meses, N=TOTAL
  // Extract month names from header (skip first 2, last 1 is TOTAL)
  const allCols=hdrCols.slice(2).map(m=>m.trim()).filter(m=>m);
  // Last col is TOTAL
  const meses=allCols.slice(0,-1);
  const totalLabel=allCols[allCols.length-1];

  const rows=[];
  for(let i=hdrIdx+1;i<lines.length;i++){
    const cols=splitCSV(lines[i]);
    if(cols.length<3) continue;
    const concepto=fixEncoding(cols[0]?.trim()||'');
    const categoria=fixEncoding(cols[1]?.trim()||'');
    if(!concepto) continue;

    // Values: cols[2..N-1]=monthly, cols[N]=total
    const allVals=cols.slice(2);
    const mesVals=allVals.slice(0,-1).map(v=>parsePnLNum(v));
    const totalVal=parsePnLNum(allVals[allVals.length-1]||'0');
    // Pad
    while(mesVals.length<meses.length) mesVals.push(0);

    rows.push({concepto,categoria,mesVals,totalVal});
  }

  return{meses,rows};
}

function fixEncoding(s){
  return s
    .replace(/â–¶/g,'▶').replace(/â€"/g,'—').replace(/Ã©/g,'é')
    .replace(/Ã³/g,'ó').replace(/Ã­/g,'í').replace(/Ã¡/g,'á')
    .replace(/Ã±/g,'ñ').replace(/Ã—/g,'×').replace(/Ã"/g,'Ó')
    .replace(/Ã‰/g,'É').replace(/â€œ/g,'"').replace(/â€/g,'"')
    .replace(/Ã"/g,'Ú').replace(/Ã¼/g,'ü');
}

function parsePnLNum(v){
  if(v===null||v===undefined||v==='') return 0;
  const s=String(v).trim();
  // Is it a percentage string like "71.4%" or "-41.1%"?
  if(s.endsWith('%')){
    return parseFloat(s.replace('%','').replace(',','.'))||0;
  }
  // Regular number — remove $, spaces, quotes
  let n=s.replace(/[$\s"]/g,'');
  if(n==='') return 0;
  const dots=(n.match(/\./g)||[]).length;
  const commas=(n.match(/,/g)||[]).length;
  if(commas>=1&&dots===0) n=n.replace(/,/g,'');
  else if(commas===1&&dots===1) n=n.replace(',','');
  else if(commas===0&&dots>1) n=n.replace(/\./g,'');
  return parseFloat(n)||0;
}

// ── PERIOD LOGIC ──────────────────────────────────────────
// "Año corrido" = últimos 12 meses desde el más reciente en el P&L
// Se auto-actualiza: al llegar junio-26, mayo-25 sale de la vista

function getMesIdx(mesStr){
  // mesStr like "MAY-25" or "may-25"
  const ord=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  const s=mesStr.toLowerCase().trim();
  const m=ord.indexOf(s.slice(0,3));
  const y=parseInt('20'+s.slice(4));
  return y*100+m;
}

function getPeriodMeses(){
  const {meses}=PNL_RAW;
  if(!meses.length) return{idxs:[],labels:[]};

  if(pnlPeriod==='corrido'){
    // Sort meses chronologically, take last 12
    const ord=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
    const indexed=meses.map((m,i)=>({m,i})).sort((a,b)=>{
      const ya=parseInt('20'+a.m.slice(-2)),yb=parseInt('20'+b.m.slice(-2));
      if(ya!==yb) return ya-yb;
      return ord.indexOf(a.m.slice(0,3).toLowerCase())-ord.indexOf(b.m.slice(0,3).toLowerCase());
    });
    const last12=indexed.slice(-12);
    return{idxs:last12.map(x=>x.i),labels:last12.map(x=>x.m)};
  }
  // Year filter
  const idxs=[],labels=[];
  const yrSuffix=pnlPeriod.slice(2); // '25' or '26'
  meses.forEach((m,i)=>{
    if(m.slice(-2)===yrSuffix){idxs.push(i);labels.push(m);}
  });
  return{idxs,labels};
}

function buildPeriodPills(){
  const {meses}=PNL_RAW;
  const years=[...new Set(meses.map(m=>m.slice(-2)))].sort();
  const pills=[
    {id:'corrido',label:'Año corrido (12m)'},
    ...years.map(y=>({id:'20'+y,label:'20'+y}))
  ];
  document.getElementById('period-pills').innerHTML=pills.map(p=>
    `<button class="period-pill${p.id===pnlPeriod?' on':''}" onclick="setPeriod('${p.id}',this)">${p.label}</button>`
  ).join('');
}

function setPeriod(id,el){
  pnlPeriod=id;
  document.querySelectorAll('.period-pill').forEach(p=>p.classList.remove('on'));
  el.classList.add('on');
  renderPnL();
}

// ── RENDER PNL ────────────────────────────────────────────
function renderPnL(){
  const {rows}=PNL_RAW;
  if(!rows.length) return;
  const {idxs,labels}=getPeriodMeses();

  const findRow=term=>rows.find(r=>r.concepto.toUpperCase().includes(term.toUpperCase()));

  // Get values for current period (sum of selected months)
  const periodSum=row=>{
    if(!row) return 0;
    return idxs.reduce((s,i)=>s+(row.mesVals[i]||0),0);
  };
  const periodVals=row=>{
    if(!row) return idxs.map(()=>0);
    return idxs.map(i=>row.mesVals[i]||0);
  };

  const vbTot=findRow('VENTA BRUTA TOTAL');
  const mbTot=findRow('MARGEN BRUTO TOTAL');
  const logNeto=findRow('TOTAL LOG');
  const mktTot=findRow('TOTAL MARKETING');
  const techTot=findRow('TOTAL TECH');
  const admTot=findRow('TOTAL ADMINISTRACI');
  const resultado=findRow('RESULTADO NETO');

  const vbS=periodSum(vbTot),mbS=periodSum(mbTot),resS=periodSum(resultado);
  const mrgP=vbS>0?mbS/vbS:0;
  const gastosS=periodSum(logNeto)+periodSum(mktTot)+periodSum(techTot)+periodSum(admTot);
  const mesesPos=resultado?periodVals(resultado).filter(v=>v>0).length:0;

  // KPIs
  document.getElementById('pnl-kpi-grid').innerHTML=[
    {lbl:'Venta Bruta',val:clp(vbS),sub:labels.length+' meses',accent:'#3d7a62',tag:'',cls:''},
    {lbl:'Margen Bruto',val:clp(mbS),sub:(mrgP*100).toFixed(1)+'% sobre venta',accent:'#c9a227',tag:mrgP>=.65?'Saludable':'Revisar',cls:mrgP>=.65?'tag-up':'tag-dn'},
    {lbl:'Resultado Neto',val:clp(resS),sub:'período',accent:resS>=0?'#27a05a':'#c0392b',tag:resS>=0?'Positivo':'Negativo',cls:resS>=0?'tag-up':'tag-dn'},
    {lbl:'Meses Positivos',val:mesesPos+'/'+labels.length,sub:'con resultado >0',accent:'#1a3a5c',tag:'',cls:''},
    {lbl:'Total Gastos Op.',val:clp(gastosS),sub:'log+mkt+tech+admin',accent:'#b85a2a',tag:'',cls:''},
    {lbl:'% Gasto / Venta',val:vbS>0?(gastosS/vbS*100).toFixed(1)+'%':'0%',sub:'sobre venta bruta',accent:'#5a2a8a',tag:'',cls:''},
  ].map(k=>`<div class="kpi fade-up" style="--accent:${k.accent}">
    <div class="kpi-label">${k.lbl}</div>
    <div class="kpi-val">${k.val}</div>
    ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
    <div class="kpi-sub">${k.sub}</div>
  </div>`).join('');

  // Resultado bars
  if(resultado){
    const vals=periodVals(resultado);
    const maxAbs=Math.max(...vals.map(v=>Math.abs(v)),1);
    document.getElementById('pnl-result-bars').innerHTML=vals.map((v,i)=>{
      const h=Math.max(3,(Math.abs(v)/maxAbs)*110);
      return `<div class="mbar-col">
        <div class="mbar-wrap">
          <div class="mbar" style="height:${h}px;background:${v>=0?'var(--green)':'var(--red)'};opacity:.85" data-tip="${labels[i]}: ${clp(v)}"></div>
        </div>
        <div class="mbar-lbl">${(labels[i]||'').slice(0,6)}</div>
      </div>`;
    }).join('');
  }

  // Gastos bars
  const gastoRows=[
    {label:'Logístico Neto',row:logNeto,color:'var(--mt)'},
    {label:'Marketing',row:mktTot,color:'#5a2a8a'},
    {label:'Tech & Software',row:techTot,color:'#1a3a5c'},
    {label:'Administración',row:admTot,color:'#4e342e'},
  ];
  const maxG=Math.max(...gastoRows.map(g=>periodSum(g.row)),1);
  document.getElementById('gasto-bars').innerHTML=gastoRows.map(g=>`
    <div class="hbar-row">
      <div class="hbar-lbl">${g.label}</div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${(periodSum(g.row)/maxG*100).toFixed(1)}%;background:${g.color}"></div></div>
      <div class="hbar-val">${clp(periodSum(g.row))}</div>
    </div>`).join('');

  // Margen × Canal — ahora los valores ya vienen como % correctos
  const renderCanalMrg=(shConcepto,mlConcepto,containerId)=>{
    const shRow=findRow(shConcepto),mlRow=findRow(mlConcepto);
    const channels=[
      {label:'Shopify',row:shRow,color:'var(--green)',cls:'b-sh'},
      {label:'MercadoLibre',row:mlRow,color:'var(--gold)',cls:'b-ml'},
    ];
    document.getElementById(containerId).innerHTML=channels.map(ch=>{
      if(!ch.row) return '';
      const vals=periodVals(ch.row).filter(v=>v!==0);
      const avg=vals.length?vals.reduce((s,v)=>s+v,0)/vals.length:0;
      const mc=mColor(avg);
      return `<div style="margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;margin-bottom:6px">
          <span class="bdg ${ch.cls}">${ch.label}</span>
          <span style="font-family:var(--serif);font-size:22px;color:${mc}">${avg.toFixed(1)}%</span>
        </div>
        <div style="height:5px;background:var(--cream-dark);border-radius:3px;overflow:hidden">
          <div style="height:100%;width:${Math.min(100,avg).toFixed(1)}%;background:${ch.color};border-radius:3px"></div>
