function filtered() {
  return DATA.filter(r => {
    if(filters.m!=='Todas' && r.marca!==filters.m) return false;
    if(filters.c!=='Todos' && r.canal!==filters.c) return false;
    if(filters.y!==0 && r.anio!==filters.y) return false;
    if(filters.me!==0 && r.mes!==filters.me) return false;
    return true;
  });
}

// ── DATA LOADING ──────────────────────────────────────────────
async function loadData() {
  try {
    // Usar proxy CORS para evitar bloqueos — el Sheets debe ser público
    const url = CSV_URL;
    const resp = await fetch(url);
    if(!resp.ok) throw new Error('HTTP '+resp.status);
    const text = await resp.text();
    DATA = parseCSV(text);
    document.getElementById('loading-state').style.display='none';
    document.getElementById('dash-content').style.display='block';
    document.getElementById('updated-label').textContent =
      'Actualizado: '+new Date().toLocaleTimeString('es-CL');
    render();
  } catch(e) {
    document.getElementById('loading-state').innerHTML =
      '<div style="color:#c0392b;font-family:var(--mono);font-size:12px">'+
      'Error cargando datos.<br>Verifica que el Sheets sea público.<br><br>'+
      '<button onclick="loadData()" style="background:var(--mk);color:#fff;border:none;'+
      'padding:8px 16px;border-radius:6px;cursor:pointer;font-family:var(--mono)">Reintentar</button></div>';
    console.error('Load error:', e);
  }
}

function parseCSV(text) {
  const lines = text.split('\n').filter(l=>l.trim());
  if(lines.length < 2) return [];

  // Fixed column indices based on confirmed CSV structure:
  // 0=Fecha, 1=MesN, 2=Mes, 3=Año, 4=Marca, 5=Canal, 6=Orden
  // 7=SKU, 8=Producto, 9=Cantidad, 10=PrecioUnit, 11=PrecioTotal
  // 12=Envío, 13=CargoMP, 14=CodDesc, 15=Descuento$, 16=IngresoNeto
  // 17=CostoUnit, 18=CostoTotal, 19=Margen$, 20=Margen%, 21=Ciudad
  // 22=Región, 23=País, 24=FechaIngreso, 25=Origen

  const records = [];
  for(let i=1; i<lines.length; i++) {
    const cols = splitCSVLine(lines[i]);
    if(cols.length < 20) continue;

    const marca = cols[4]?.trim()||'';
    const canal = cols[5]?.trim()||'';
    if(!marca) continue;

    const mes   = parseInt(cols[1])||0;
    const anio  = parseInt(cols[3])||0;
    const sku   = cols[7]?.trim()||'';
    const prod  = cols[8]?.trim()||'';
    const qty   = parseInt(cols[9])||1;
    const vb    = parseNum(cols[11]);  // Precio Total
    const costo = parseNum(cols[18]);  // Costo Total
    const mb    = parseNum(cols[19]);  // Margen $
    const mrg   = parseNum(cols[20]);  // Margen %

    if(vb<=0) continue;

    // If margen columns are empty, calculate directly
    const mb_final  = mb !== 0 ? mb  : (vb - costo);
    const mrg_final = mrg !== 0 ? mrg : (vb > 0 ? (mb_final/vb)*100 : 0);

    const fecha = cols[0]?.trim()||'';

    records.push({fecha, mes, anio, marca, canal, sku, prod, qty,
                  vb, costo, mb: mb_final, mrg: mrg_final});
  }
  console.log('Records loaded:', records.length,
    '| Sample vb:', records[0]?.vb,
    '| Sample mrg:', records[0]?.mrg?.toFixed(1)+'%');
  return records;
}

function splitCSVLine(line) {
  const res=[]; let f='', inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){f+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){res.push(f.trim());f='';}
    else f+=c;
  }
  res.push(f.trim());
  return res;
}

function parseNum(v) {
  if(v===null||v===undefined||v==='') return 0;
  if(typeof v==='number') return v;
  let s = String(v).trim();
  if(s==='') return 0;

  // CSV from Sheets comes as: "$ 49,990" or "67.68%" or "49990"
  // Remove $, spaces, %
  s = s.replace(/[$\s%]/g,'');
  if(s==='') return 0;

  // "49,990" → comma is thousands separator → remove comma → 49990
  // "67.68"  → dot is decimal → keep as is
  // "49990"  → plain integer → keep as is
  // "1,234,567" → multiple commas = thousands → remove all commas

  const dots   = (s.match(/\./g)||[]).length;
  const commas = (s.match(/,/g)||[]).length;

  if(commas >= 1 && dots === 0) {
    // Commas are thousands separators: 49,990 or 1,234,567
    s = s.replace(/,/g,'');
  } else if(commas === 1 && dots === 1) {
    // Both: 1,234.56 → remove comma, keep dot
    s = s.replace(',','');
  } else if(commas === 0 && dots === 1) {
    // Could be decimal (67.68) or thousands (49.990)
    const afterDot = s.split('.')[1];
    if(afterDot && afterDot.length === 3) {
      s = s.replace('.',''); // thousands
    }
    // else keep as decimal
  } else if(commas === 0 && dots > 1) {
    s = s.replace(/\./g,''); // multiple dots = thousands
  }

  return parseFloat(s)||0;
}

function splitCSVLine(line) {
  const res=[]; let f='', inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){f+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){res.push(f.trim());f='';}
    else f+=c;
  }
  res.push(f.trim());
  return res;
}



// ── RENDER ────────────────────────────────────────────────────
const clp = n => '$'+Math.round(n).toLocaleString('es-CL');
const pct = n => (n*100).toFixed(1)+'%';
// mrg is stored as percentage points (e.g. 69.05 means 69.05%)
// mColor expects 0-1 range so divide by 100
const mColor = p => p>=65?'var(--green)':p>=45?'var(--gold)':'var(--red)';
const mBg    = p => p>=65?'var(--green-light)':p>=45?'var(--gold-light)':'var(--red-light)';

function render() {
  const d = filtered();
  renderKPIs(d);
  renderMonthBars(d);
  renderCanal(d);
  renderMarca(d);
  renderProdBars(d);
  renderRecentTx(d);
  renderSkuTable(d);
}

function renderKPIs(d) {
  const vb  = d.reduce((s,r)=>s+r.vb,0);
  const mb  = d.reduce((s,r)=>s+r.mb,0);
  const un  = d.reduce((s,r)=>s+r.qty,0);
  const cnt = d.length;
  const tk  = un>0?vb/un:0;
  const mrg = vb>0?mb/vb:0; // 0-1 range for KPI display

  // Meta mensual
  const META = 14969250;
  const meses = [...new Set(d.map(r=>r.anio+'-'+r.mes))].length||1;
  const avg = vb/meses;
  const gap = avg/META-1;

  const kpis = [
    {lbl:'Venta Bruta',val:clp(vb),sub:cnt+' transacciones · '+un+' uds',
     tag:gap>=0?'↑ +'+Math.abs(gap*100).toFixed(1)+'% vs meta':'↓ '+Math.abs(gap*100).toFixed(1)+'% vs meta',
     cls:gap>=0?'tag-up':'tag-dn', accent:'#3d7a62'},
    {lbl:'Margen Bruto $',val:clp(mb),sub:pct(mrg)+' sobre venta bruta',
     tag:mrg>=0.65?'Margen saludable':mrg>=0.45?'Margen ok':'Revisar margen',
     cls:mrg>=0.65?'tag-up':mrg>=0.45?'tag-n':'tag-dn', accent:'#c9a227'},
    {lbl:'Ticket Promedio',val:clp(tk),sub:'por unidad vendida',tag:'',cls:'', accent:'#1a3a5c'},
    {lbl:'Unidades',val:un.toLocaleString('es-CL'),sub:meses+' mes'+(meses>1?'es':'')+' activo'+(meses>1?'s':''),tag:'',cls:'', accent:'#b85a2a'},
    {lbl:'Prom. Mensual',val:clp(avg),sub:'meta: '+clp(META),
     tag:gap>=0?'↑ Sobre meta':'↓ Bajo meta',
     cls:gap>=0?'tag-up':'tag-dn', accent:'#5a2a8a'},
    {lbl:'Costo Total',val:clp(d.reduce((s,r)=>s+r.costo,0)),sub:'costo de importación',tag:'',cls:'', accent:'#4a4540'},
  ];

  document.getElementById('kpi-grid').innerHTML = kpis.map(k=>`
    <div class="kpi fade-up" style="--accent:${k.accent}">
      <div class="kpi-label">${k.lbl}</div>
      <div class="kpi-val">${k.val}</div>
      ${k.tag?`<div class="kpi-tag ${k.cls}">${k.tag}</div>`:''}
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');
}

function renderMonthBars(d) {
  const byM = {};
  d.forEach(r=>{
    const k=r.anio+'-'+String(r.mes).padStart(2,'0');
    if(!byM[k]) byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),mk:0,mt:0};
    byM[k][r.marca==='MemoKoala'?'mk':'mt']+=r.vb;
  });
  const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0]));
  const maxV=Math.max(...sorted.map(([,v])=>v.mk+v.mt),1);
  document.getElementById('month-bars').innerHTML=sorted.map(([,v])=>{
    const tot=v.mk+v.mt, h=Math.max(3,(tot/maxV)*100);
    const hmk=tot>0?(v.mk/tot)*h:h/2, hmt=h-hmk;
    return `<div class="mbar-col">
      <div class="mbar-wrap" style="flex-direction:column;justify-content:flex-end">
        <div class="mbar" style="height:${hmt}px;background:var(--mt-mid);opacity:.8" data-tip="${v.lbl} Montana: ${clp(v.mt)}"></div>
        <div class="mbar" style="height:${hmk}px;background:var(--mk)" data-tip="${v.lbl} MemoKoala: ${clp(v.mk)}"></div>
      </div>
      <div class="mbar-lbl">${v.lbl}</div>
    </div>`;
  }).join('');
  document.getElementById('month-legend').innerHTML=`
    <div class="leg"><div class="leg-dot" style="background:var(--mk)"></div>MemoKoala</div>
    <div class="leg"><div class="leg-dot" style="background:var(--mt-mid)"></div>Montana</div>`;
}

function renderCanal(d) {
  const ch={};
  d.forEach(r=>{ch[r.canal]=(ch[r.canal]||{vb:0,mb:0,cnt:0}); ch[r.canal].vb+=r.vb; ch[r.canal].mb+=r.mb; ch[r.canal].cnt++;});
  const tot=Object.values(ch).reduce((s,v)=>s+v.vb,0)||1;
  const cc={Shopify:'var(--green)',ML:'var(--gold)'};
  document.getElementById('canal-split').innerHTML=Object.entries(ch).map(([k,v])=>
    `<div style="flex:${v.vb};background:${cc[k]||'#ccc'}"></div>`).join('');
  document.getElementById('canal-detail').innerHTML=Object.entries(ch).map(([k,v])=>`
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div class="leg"><div class="leg-dot" style="background:${cc[k]||'#ccc'}"></div>
      <span class="bdg ${k==='Shopify'?'b-sh':'b-ml'}">${k}</span></div>
      <span style="font-family:var(--mono);font-size:11px">${clp(v.vb)} <span style="color:var(--ink-dim)">${pct(v.vb/tot)}</span></span>
    </div>`).join('');
  document.getElementById('canal-margin').innerHTML='<div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Margen por canal</div>'+
    Object.entries(ch).map(([k,v])=>{
      const p=v.vb>0?v.mb/v.vb:0;
      const pp_pct = p*100;
      return `<div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;margin-bottom:4px">
        <span style="color:var(--ink-light)">${k}</span>
        <span style="color:${mColor(pp_pct)};font-weight:500">${pct(p)}</span>
      </div>`;
    }).join('');
}

function renderMarca(d) {
  const bm={};
  d.forEach(r=>{bm[r.marca]=(bm[r.marca]||{vb:0,mb:0}); bm[r.marca].vb+=r.vb; bm[r.marca].mb+=r.mb;});
  const bc={MemoKoala:'var(--mk)',Montana:'var(--mt)'};
  document.getElementById('marca-margen').innerHTML=Object.entries(bm).map(([m,v])=>{
    const p=v.vb>0?v.mb/v.vb:0;
    return `<div style="margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;margin-bottom:6px">
        <span class="bdg ${m==='MemoKoala'?'b-mk':'b-mt'}">${m==='MemoKoala'?'🐨':'🔪'} ${m}</span>
        <span style="font-family:var(--serif);font-size:20px;color:${bc[m]}">${pct(p)}</span>
      </div>
      <div style="height:5px;background:var(--cream-dark);border-radius:3px;overflow:hidden">
        <div style="height:100%;width:${Math.min(100,p*100).toFixed(1)}%;background:${bc[m]};border-radius:3px;transition:width .7s"></div>
      </div>
      <div style="font-family:var(--mono);font-size:9px;color:var(--ink-dim);margin-top:5px">
        ${clp(v.vb)} bruto · ${clp(v.mb)} margen
      </div>
    </div>`;
  }).join('');
}

function renderProdBars(d) {
  const p={};
  d.forEach(r=>{
    if(!p[r.sku]) p[r.sku]={nom:r.prod,vb:0,marca:r.marca};
    p[r.sku].vb+=r.vb;
  });
  const sorted=Object.entries(p).sort((a,b)=>b[1].vb-a[1].vb).slice(0,9);
  const mx=sorted[0]?.[1]?.vb||1;
  document.getElementById('prod-bars').innerHTML=sorted.map(([sku,v])=>`
    <div class="hbar-row">
      <div class="hbar-lbl" title="${v.nom}">${v.nom||sku}</div>
      <div class="hbar-track">
        <div class="hbar-fill" style="width:${(v.vb/mx*100).toFixed(1)}%;background:${v.marca==='MemoKoala'?'var(--mk)':'var(--mt)'}"></div>
      </div>
      <div class="hbar-val">${clp(v.vb)}</div>
    </div>`).join('');
}

function renderRecentTx(d) {
  const sorted=[...d].sort((a,b)=>b.fecha.localeCompare(a.fecha)).slice(0,15);
  document.getElementById('tx-count').textContent=d.length+' ventas';
  document.getElementById('recent-tx').innerHTML=sorted.map(r=>{
    const mc=mColor(r.mrg);
    return `<tr>
      <td>${r.fecha.slice(5)}</td>
      <td><span class="bdg ${r.marca==='MemoKoala'?'b-mk':'b-mt'}">${r.marca==='MemoKoala'?'MK':'MT'}</span></td>
      <td><span class="bdg ${r.canal==='Shopify'?'b-sh':'b-ml'}">${r.canal}</span></td>
      <td>${(r.prod||'').slice(0,22)}</td>
      <td>${clp(r.vb)}</td>
      <td><div class="mrg-bar"><span style="color:${mc};font-weight:500">${r.mrg.toFixed(1)}%</span>
        <div class="mrg-mini"><div class="mrg-fill" style="width:${Math.min(100,r.mrg).toFixed(0)}%;background:${mc}"></div></div>
      </div></td>
    </tr>`;
  }).join('');
}

function renderSkuTable(d) {
  const s={};
  d.forEach(r=>{
    if(!s[r.sku]) s[r.sku]={nom:r.prod,marca:r.marca,un:0,vb:0,costo:0,mb:0};
    s[r.sku].un+=r.qty; s[r.sku].vb+=r.vb; s[r.sku].costo+=r.costo; s[r.sku].mb+=r.mb;
  });
  const sorted=Object.values(s).sort((a,b)=>b.vb-a.vb);
  document.getElementById('sku-table').innerHTML=sorted.map(r=>{
    const mrg_pct = r.vb>0?(r.mb/r.vb)*100:0;
    const mc=mColor(mrg_pct);
    return `<tr>
      <td style="font-weight:500;color:var(--ink);font-family:var(--mono);font-size:11px">${r.sku||'—'}</td>
      <td>${r.nom||'—'}</td>
      <td><span class="bdg ${r.marca==='MemoKoala'?'b-mk':'b-mt'}">${r.marca==='MemoKoala'?'🐨 MK':'🔪 MT'}</span></td>
      <td style="text-align:right">${r.un}</td>
      <td style="text-align:right">${clp(r.vb)}</td>
      <td style="text-align:right">${clp(r.costo)}</td>
      <td style="text-align:right">${clp(r.mb)}</td>
      <td><div class="mrg-bar"><span style="color:${mc};font-weight:500">${mrg_pct.toFixed(1)}%</span>
        <div class="mrg-mini"><div class="mrg-fill" style="width:${Math.min(100,mrg_pct).toFixed(0)}%;background:${mc}"></div></div>
      </div></td>
    </tr>`;
  }).join('');
}

// ── CHECKLIST ─────────────────────────────────────────────
function showChecklist() {
  document.getElementById('checklist-modal').style.display='block';
  document.body.style.overflow='hidden';
}
function hideChecklist() {
  document.getElementById('checklist-modal').style.display='none';
  document.body.style.overflow='';
}
function clToggle(el) {
  el.classList.toggle('done');
  clUpdateProgress();
}
function clUpdateProgress() {
  const total = document.querySelectorAll('.cl-item').length;
  const done  = document.querySelectorAll('.cl-item.done').length;
  const pct   = total>0?(done/total*100).toFixed(0):0;
  document.getElementById('cl-prog').style.width = pct+'%';
}
function clReset() {
  document.querySelectorAll('.cl-item').forEach(el=>el.classList.remove('done'));
  clUpdateProgress();
}
// Cerrar con Escape
document.addEventListener('keydown', e=>{ if(e.key==='Escape') hideChecklist(); });
</script>
</body>
</html>
