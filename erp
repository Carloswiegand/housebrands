    {lbl:'Montana × ML',vR:'Venta Montana × MercadoLibre',mR:'% Margen Montana × MercadoLibre'},
  ].forEach(({lbl,vR,mR})=>{
    const vRow=findRow(vR),mRow=findRow(mR);
    if(!vRow)return;
    const tds=idxs.map(i=>{
      const v=vRow.mv[i]||0,m=mRow?(mRow.mv[i]||0):0;
      return`<td>${v?clp(v):'—'}${m?`<br><span style="font-size:9px;color:${m>=65?'var(--pos)':m>=45?'var(--warn)':'var(--neg)'}">${m.toFixed(1)}%</span>`:''}
      </td>`;
    }).join('');
    const vtot=ps(vRow.mv),mavg=mRow?pavg(mRow.mv):0;
    html+=`<tr class="compact"><td>${lbl}<br><span style="color:var(--light)">Venta · Margen %</span></td>${tds}
      <td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${mavg>=65?'#4acf80':'#f87171'}">${mavg.toFixed(1)}%</span></td></tr>`;
  });

  html+='</tbody></table>';
  document.getElementById('pnl-table-wrap').innerHTML=html;
}

// ── INVENTARIO ──────────────────────────────────────────
function renderInv(){
  const hoy=new Date();
  const hace90=new Date(hoy);hace90.setDate(hoy.getDate()-90);

  // Calcular ventas post-cierre y últimos 90 días desde DATA
  const vendSep={},vend90={};
  DATA.forEach(r=>{
    if(!r.sku||!r.fecha)return;
    const f=new Date(r.fecha);
    if(isNaN(f.getTime()))return;
    if(f>FECHA_CIERRE)vendSep[r.sku]=(vendSep[r.sku]||0)+r.qty;
    if(f>=hace90)vend90[r.sku]=(vend90[r.sku]||0)+r.qty;
  });

  const skus=Object.keys(STOCK_BASE);
  let totalStock=0,totalVal=0,alertas=0,criticos=0;

  const cards=skus.map(sku=>{
    const marca=sku.startsWith('MK')||sku==='TO04-4'?'MemoKoala':'Montana';
    const base=STOCK_BASE[sku]||0;
    const vendido=vendSep[sku]||0;
    const actual=Math.max(0,base-vendido);
    const v90=vend90[sku]||0;
    const vDia=Math.round((v90/90)*100)/100;
    const dias=vDia>0?Math.round(actual/vDia):9999;
    const umbral=60;
    const costo=COSTOS[sku]||0;
    const val=actual*costo*IVA;
    totalStock+=actual;totalVal+=val;

    let stato='ok',statoTxt='✅ Stock OK';
    if(dias===9999){stato='none';statoTxt='Sin ventas recientes';}
    else if(dias<umbral/2){stato='crit';statoTxt='🔴 Crítico';criticos++;}
    else if(dias<umbral){stato='alert';statoTxt='🟠 Alerta';alertas++;}
    else if(dias<umbral*2){stato='warn';statoTxt='🟡 Revisar';}

    const barW=dias===9999?100:Math.min(100,(dias/180)*100);
    const barC=stato==='ok'?'var(--pos)':stato==='warn'?'var(--warn)':stato==='alert'?'#D35400':'var(--neg)';
    const nota=sku==='MK-0001'||sku==='MK-0002'?'<div style="font-family:var(--mono);font-size:9px;color:var(--warn);margin-top:4px">⚠ Solo stock ABEE — bodega papás pendiente</div>':'';

    return`<div class="inv-card" style="border-color:${stato==='crit'?'var(--neg)':stato==='alert'?'#e8a85a':'var(--border)'}">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
        <div class="inv-sku">${sku}</div>
        <span class="bdg ${marca==='MemoKoala'?'b-mk':'b-mt'}" style="font-size:8px">${marca==='MemoKoala'?'MK':'MT'}</span>
      </div>
      <div class="inv-nom">${NOMBRES[sku]||sku}</div>
      <div class="inv-num">${actual}</div>
      <div class="inv-lbl">unidades en stock</div>
      <div class="inv-row"><span>Ventas 90 días</span><span>${v90} uds</span></div>
      <div class="inv-row"><span>Promedio diario</span><span>${vDia.toFixed(2)} uds/día</span></div>
      <div class="inv-row"><span>Días de stock</span><span>${dias===9999?'—':dias+' días'}</span></div>
      <div class="inv-row"><span>Valor stock (costo×1.19)</span><span>${clp(val)}</span></div>
      <div class="inv-bar"><div class="inv-fill" style="width:${barW}%;background:${barC}"></div></div>
      <span class="stato s-${stato}">${statoTxt}</span>
      ${nota}
    </div>`;
  }).join('');

  // KPIs inventario
  document.getElementById('inv-kgrid').innerHTML=[
    {lbl:'STOCK TOTAL',num:totalStock.toLocaleString('es-CL'),sub:'unidades en sistema',acc:'#4A6274',delta:{c:'d-neu',t:'cierre base: 31-ago-2026'}},
    {lbl:'VALOR TOTAL STOCK',num:clp(totalVal),sub:'a costo internado × 1.19',acc:'#2C3E4C',delta:{c:'d-neu',t:'según COSTOS_SKU'}},
    {lbl:'ALERTAS',num:alertas+criticos,sub:criticos+' crítico'+(criticos!==1?'s':'')+' · '+alertas+' alerta'+(alertas!==1?'s':''),
     acc:alertas+criticos>0?'#c0392b':'#1a7a45',
     delta:alertas+criticos>0?{c:'d-neg',t:'Revisar reposición'}:{c:'d-pos',t:'Todo OK'}},
    {lbl:'SKUs SIN ROTACIÓN',num:Object.keys(STOCK_BASE).filter(s=>(vend90[s]||0)===0).length,
     sub:'sin ventas en 90 días',acc:'#8AA4B4',delta:{c:'d-neu',t:'últimos 90 días'}},
  ].map(k=>`<div class="kcard">
    <div class="kcard-accent" style="background:${k.acc}"></div>
    <div class="kcard-label">${k.lbl}</div>
    <div class="kcard-num">${k.num}</div>
    <div class="kcard-sub">${k.sub}</div>
    <div class="kcard-delta ${k.delta.c}">${k.delta.t}</div>
  </div>`).join('');

  document.getElementById('inv-cards').innerHTML=cards;
}

// CHECKLIST
function showCL(){document.getElementById('cl-modal').style.display='block';document.body.style.overflow='hidden';}
function hideCL(){document.getElementById('cl-modal').style.display='none';document.body.style.overflow='';}
function clTog(el){el.classList.toggle('done');clProg();}
function clProg(){const t=document.querySelectorAll('.cl-item').length,d=document.querySelectorAll('.cl-item.done').length;document.getElementById('cl-prog').style.width=(t?d/t*100:0)+'%';}
function clReset(){document.querySelectorAll('.cl-item').forEach(e=>e.classList.remove('done'));clProg();}
document.addEventListener('keydown',e=>{if(e.key==='Escape')hideCL();});

// UTILS
const clp=n=>'$'+Math.round(n).toLocaleString('es-CL');
const sum=(arr,k)=>arr.reduce((s,r)=>s+(r[k]||0),0);
function pn(v){
  if(v===null||v===undefined||v==='')return 0;
  if(typeof v==='number')return v;
  let s=String(v).trim().replace(/[$\s%]/g,'');
  if(!s)return 0;
  const dots=(s.match(/\./g)||[]).length,commas=(s.match(/,/g)||[]).length;
  if(commas>=1&&dots===0)s=s.replace(/,/g,'');
  else if(commas===1&&dots===1)s=s.replace(',','');
  else if(commas===0&&dots>1)s=s.replace(/\./g,'');
  return parseFloat(s)||0;
}
function scsv(line){
  const res=[];let f='',inQ=false;
  for(let i=0;i<line.length;i++){
    const c=line[i];
    if(c==='"'){if(inQ&&line[i+1]==='"'){f+='"';i++;}else inQ=!inQ;}
    else if(c===','&&!inQ){res.push(f.trim());f='';}
    else f+=c;
  }
  res.push(f.trim());return res;
}
