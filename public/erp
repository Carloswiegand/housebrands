// Stock: foto de la hoja Inventario_Diario (Apps Script la actualiza cada hora desde Shopify y ML;
// ABEE sincroniza Shopify). Stock total = stock ABEE (Shopify) + stock externo (hoja Stock_Externo).
let INV_SNAP=null, INV_FECHA='', invLoading=null;
async function loadInvSnap(){
  if(INV_SNAP)return INV_SNAP;
  if(invLoading)return invLoading;
  invLoading=(async()=>{
    const r=await fetch(CSV_INV);
    if(!r.ok)throw new Error('HTTP '+r.status);
    const lines=(await r.text()).split('\n').filter(l=>l.trim()).slice(1).map(scsv);
    INV_FECHA=lines.reduce((m,c)=>c[0]>m?c[0]:m,'');
    INV_SNAP={};
    lines.filter(c=>c[0]===INV_FECHA&&c[1]).forEach(c=>{
      const num=v=>v===''||v===undefined?null:pn(v);
      INV_SNAP[c[1]]={sku:c[1],prod:c[2],marca:c[3],sh:num(c[4]),ml:num(c[5]),dif:num(c[6]),estadoSync:c[7],pubs:pn(c[8]),ext:pn(c[9]),total:pn(c[10])};
    });
    return INV_SNAP;
  })();
  try{return await invLoading;}finally{invLoading=null;}
}

function calcInvData(){
  const hoy=new Date(),hace90=new Date(hoy);hace90.setDate(hoy.getDate()-90);
  const vend90={};
  DATA.forEach(r=>{
    if(!r.sku||!r.fecha)return;
    const f=new Date(r.fecha);if(isNaN(f.getTime()))return;
    if(f>=hace90)vend90[r.sku]=(vend90[r.sku]||0)+r.qty;
  });
  return Object.values(INV_SNAP||{}).map(s=>{
    const sku=s.sku;
    const marca=s.marca&&s.marca.toLowerCase().startsWith('memo')?'MemoKoala':'Montana';
    const actual=Math.max(0,s.total);
    const v90=vend90[sku]||0,vDia=Math.round((v90/90)*100)/100;
    const dias=vDia>0?Math.round(actual/vDia):9999;
    const umbral=60,costo=COSTOS[sku]||0;
    const val=actual*costo*IVA;
    let stato='ok',statoTxt='✅ OK';
    if(dias===9999){stato='none';statoTxt='Sin ventas';}
    else if(dias<umbral/2){stato='crit';statoTxt='🔴 Crítico';}
    else if(dias<umbral){stato='alert';statoTxt='🟠 Alerta';}
    else if(dias<umbral*2){stato='warn';statoTxt='🟡 Revisar';}
    return{...s,marca,actual,v90,vDia,dias,umbral,costo,val,stato,statoTxt,nombre:NOMBRES[sku]||s.prod||sku};
  });
}

async function renderInv(){
  const kg=document.getElementById('inv-kgrid');
  if(!INV_SNAP){
    kg.innerHTML='<div style="padding:16px;font-family:var(--mono);font-size:10px;color:var(--light)">Cargando stock…</div>';
    try{await loadInvSnap();}
    catch(e){kg.innerHTML='<div style="padding:16px;font-family:var(--mono);font-size:11px;color:var(--neg)">No se pudo cargar el stock. <button onclick="renderInv()" class="inv-edit-btn">Reintentar</button></div>';return;}
  }
  const inv=calcInvData();
  let totalStock=0,totalVal=0,alertas=0,criticos=0,descuadre=0;
  inv.forEach(r=>{totalStock+=r.actual;totalVal+=r.val;if(r.stato==='crit')criticos++;if(r.stato==='alert')alertas++;if(r.estadoSync==='Revisar')descuadre++;});
  kg.innerHTML=[
    {lbl:'STOCK TOTAL',num:totalStock.toLocaleString('es-CL'),sub:'unidades · ABEE + bodegas externas',acc:'#4A6274',delta:{c:'d-neu',t:'foto '+INV_FECHA}},
