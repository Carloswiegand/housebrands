// ══ META DEL MES: punto de equilibrio fijo arriba del Resumen ══
// Se calcula con el último mes cerrado del P&L que ya tiene gastos fijos: gastos fijos ÷ % de contribución.

// ══ METAS DEL FLUJO DE CAJA ═══════════════════════════════════
async function gLoadMetas(force){
  if(G.metas&&!force)return G.metas;
  try{const f=await gCsv('/erp/api/metas');G.metas={};
    f.slice(1).forEach(c=>{if(!/^\d{4}-\d{2}$/.test(c[0]))return;const n=i=>pn(c[i]);(G.metas[c[0]]=G.metas[c[0]]||{})[c[1]]={ventas:n(2),costo:parseFloat(c[3])||0,log:parseFloat(c[4])||0,pub:n(5),ag:n(6),ct:n(7),sh:n(8),tpl:n(9),sueldo:n(10),cuota:n(11)};});
  }catch(e){G.metas={};}
  return G.metas;
}
// Plan del mes (si el mes pasa el horizonte del flujo, se usa el último mes = régimen).
function gPlan(mes,esc){const M=G.metas||{};if(M[mes]&&M[mes][esc])return M[mes][esc];const ks=Object.keys(M).sort();const k=ks.filter(x=>x<=mes).pop();return k&&M[k][esc]?M[k][esc]:null;}
const gFijosPlan=p=>p.pub+p.ag+p.ct+p.sh+p.tpl+p.sueldo+p.cuota;

// Meta del mes: punto de equilibrio y meta de venta según el flujo; además, corregido con la operación real.
async function gMetaMes(){
  const el=document.getElementById('x-meta');if(!el)return;
  try{
    await gLoadMetas();
    if(!PNL.rows.length){const r=await fetch(CSV_PNL);PNL=parsePnL(await r.text());pnlLoaded=true;}
    const hoy=new Date(),mes=xIso(hoy).slice(0,7),ini=mes+'-01',dias=new Date(hoy.getFullYear(),hoy.getMonth()+1,0).getDate(),dia=hoy.getDate();
    const mtd=DATA.filter(r=>r.vb>0&&r.fecha>=ini&&r.fecha<=gHoy()).reduce((s,r)=>s+r.vb,0),proy=mtd/dia*dias;
