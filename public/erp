// ── Alertas automáticas ──
function xAlertas(){
  const out=[],desc=[];const hoy=xIso(new Date());
  const v90=xGrupo(xEn(DATA.filter(r=>r.vb>0),xAdd(hoy,-89),hoy),r=>r.sku);
  if(INV_SNAP){Object.values(INV_SNAP).forEach(s=>{
    const u=(v90[s.sku]||[]).reduce((a,r)=>a+r.qty,0),dia=u/90,st=s.total;const nom=NOMBRES[s.sku]||s.prod||s.sku;
    if(dia>0&&st/dia<21)out.push({c:'r',p:1,t:`${nom}: ${Math.round(st/dia)} días de stock`,x:`Quedan ${st} y se venden ~${(dia*7).toFixed(1).replace('.',',')} por semana. Reponer.`});
    else if(st>=30&&(dia===0||st/dia>365))out.push({c:'b',p:3,t:`${nom}: ${st} unidades, ${dia===0?'sin ventas en 90 días':'stock para '+(st/dia/365).toFixed(1).replace('.',',')+' años'}`,x:'Candidato a liquidar, bajar precio o usar en un pack.'});
    if(s.estadoSync==='Revisar'&&s.ml>s.sh)desc.push(`${nom} (+${s.ml-s.sh})`);
  });
  if(desc.length)out.push({c:'r',p:2,t:`ML muestra stock de más en ${desc.length} producto${desc.length!==1?'s':''}`,x:desc.join(', ')+'. Riesgo de vender unidades que no existen.'});}
  const sinCosto=DATA.filter(r=>r.vb>0&&!(r.costoUnit>0));
  if(sinCosto.length)out.push({c:'r',p:0,t:`${sinCosto.length} ventas sin costo cargado`,x:'SKU: '+[...new Set(sinCosto.map(r=>r.sku))].join(', ')+'. El margen aparece inflado.'});
  // productos que caen fuerte: 30 días vs 30 anteriores
  const a=xGrupo(xEn(DATA.filter(r=>r.vb>0),xAdd(hoy,-29),hoy),r=>r.sku),b=xGrupo(xEn(DATA.filter(r=>r.vb>0),xAdd(hoy,-59),xAdd(hoy,-30)),r=>r.sku);
  Object.keys(b).forEach(k=>{const ua=(a[k]||[]).reduce((s,r)=>s+r.qty,0),ub=b[k].reduce((s,r)=>s+r.qty,0);if(ub>=5&&ua<=ub*0.5)out.push({c:'b',p:4,t:`${NOMBRES[k]||k}: ventas cayendo`,x:`${ua} unidades en los últimos 30 días vs ${ub} en los 30 anteriores.`});});
  // comisión ML fuera de lo habitual (30 días vs 90)
  const ml=DATA.filter(r=>r.canal==='ML'&&r.vb>0);
  const pct=rs=>{const v=rs.reduce((s,r)=>s+r.vb,0);return v?rs.reduce((s,r)=>s+r.cargoMP,0)/v:0;};
  Object.entries(xGrupo(xEn(ml,xAdd(hoy,-119),xAdd(hoy,-30)),r=>r.sku)).forEach(([k,rs])=>{const rec=xEn(ml,xAdd(hoy,-29),hoy).filter(r=>r.sku===k);if(rec.length>=2&&rs.length>=3){const d=pct(rec)-pct(rs);if(Math.abs(d)>0.005)out.push({c:d>0?'r':'g',p:5,t:`Comisión ML de ${NOMBRES[k]||k}: ${xP(pct(rec))}`,x:`Antes era ${xP(pct(rs))}. ${d>0?'ML está cobrando más.':'ML está cobrando menos.'}`});}});
  return out.sort((x,y)=>x.p-y.p);
}

