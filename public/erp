const SM_RUBROS_UI=['Bebé','Cocina','Hogar','Decoración','Mascotas','Adulto mayor','Parrilla','Otro'];
async function gLoadIdeas(force){
  if(G.ideas&&!force)return;
  const q=s=>gCsv('/erp/api/'+s+(force?'?x='+Date.now():'')).catch(()=>[]);
  const [i,s,o]=await Promise.all([q('ideas'),q('seg'),q('opor')]);
  G.ideas=i.slice(1).filter(r=>r[0]).map(r=>({id:r[0],creada:r[1],kw:r[2],rubro:r[3],origen:r[4],hip:r[5],marca:r[6],plazo:r[7],baseP:pn(r[8]),baseM:pn(r[9]),estado:r[10],ver:r[11],fver:r[12],notas:r[13]}));
  G.seg=s.slice(1).filter(r=>r[1]).map(r=>({fecha:r[0],id:r[1],pos:pn(r[3])||null,prod:pn(r[4])||null,marcas:pn(r[5])||null}));
  G.opor=o.slice(1).filter(r=>r[2]).map(r=>({fecha:r[0],rubro:r[1],kw:r[2],donde:r[3],sem:pn(r[4]),prod:pn(r[5])||null,marcas:pn(r[6])||null,top:r[7]||''}));
