function rOrdersChart(d){
  const mes=parseInt(document.getElementById('f-mes').value)||0;
  const title=mes>0?'Pedidos diarios':'Pedidos — últimos 6 meses';
  const el=document.getElementById('orders-chart-title');
  if(el) el.textContent=title;

  if(mes>0){
    // Vista diaria pedidos
    const anio=parseInt(document.getElementById('f-anio').value)||new Date().getFullYear();
    const diasMes=new Date(anio,mes,0).getDate();
    const byDay={};
    d.forEach(r=>{
      const day=r.fecha?.slice(8,10);if(!day)return;
      byDay[day]=(byDay[day]||0)+1;
    });
    const allDays=Array.from({length:diasMes},(_,i)=>String(i+1).padStart(2,'0'));
    const vals=allDays.map(d=>byDay[d]||0);
    const valsToShow=chartMode==='acum'?vals.map((v,i)=>vals.slice(0,i+1).reduce((s,x)=>s+x,0)):vals;
    const maxV=Math.max(...valsToShow,1);
    document.getElementById('orders-bars').innerHTML=valsToShow.map((v,i)=>{
      const h=Math.max(v>0?3:0,(v/maxV)*90);
      const isWE=new Date(anio,mes-1,parseInt(allDays[i])).getDay()%6===0;
      return`<div style="flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;cursor:default" title="Día ${parseInt(allDays[i])}: ${v} pedido${v!==1?'s':''}">
        <div style="width:100%;height:90px;display:flex;flex-direction:column;justify-content:flex-end">
          ${v>0?`<div style="height:${h}px;background:var(--sh);border-radius:1px 1px 0 0;width:100%;opacity:.8"></div>`:`<div style="height:2px;background:var(--border);width:100%"></div>`}
        </div>
        <div style="font-family:var(--mono);font-size:6px;color:${isWE?'var(--mid)':'var(--light)'};margin-top:3px">${parseInt(allDays[i])}</div>
      </div>`;
    }).join('');
    document.getElementById('orders-lbls').innerHTML='';
  } else {
    // Vista mensual
    const byM={};
    d.forEach(r=>{
      const k=r.anio+'-'+String(r.mes).padStart(2,'0');
      if(!byM[k])byM[k]={lbl:['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][r.mes-1]+' '+String(r.anio).slice(2),cnt:0};
      byM[k].cnt++;
    });
    const sorted=Object.entries(byM).sort((a,b)=>a[0].localeCompare(b[0])).slice(-6);
    if(!sorted.length){document.getElementById('orders-bars').innerHTML='';return;}
    let vals=sorted.map(([,v])=>v.cnt);
