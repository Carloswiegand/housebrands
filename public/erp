      <div style="flex:1 1 230px"><div class="xk-l">Meta de venta del mes · escenario neutro</div><div class="xk-v">${clp(meta)}</div>
        <div class="xsmall" style="margin-top:4px;line-height:1.5">Optimista ${O?clp(O.ventas):'–'} · Pesimista ${P?clp(P.ventas):'–'}</div></div>
      <div style="flex:1 1 230px"><div class="xk-l">Mínimo para no perder · punto de equilibrio</div><div class="xk-v">${clp(Math.max(bePlan,beReal))}</div>
        <div class="xsmall" style="margin-top:4px;line-height:1.5">Según el flujo: ${clp(bePlan)} (gastos ${clp(fijos)}${N.sueldo?' con sueldo':''}${N.cuota?' y cuota':''}). ${txtReal}</div></div>
      <div style="flex:2 1 380px"><div style="display:flex;justify-content:space-between;font-size:13px"><span>Llevas <b>${clp(mtd)}</b> · ${xP(meta?mtd/meta:0,0)} de la meta</span><span>día ${dia} de ${dias}</span></div>
        <div class="mm-bar"><i style="width:${pos(mtd)}%"></i><i class="p" style="width:${pos(proy)}%"></i>${mk(beReal||bePlan,'var(--x-neg)','Equilibrio')}${mk(P&&P.ventas,'#c98a00','Pesimista')}${mk(meta,'var(--x-tx)','Neutro')}${mk(O&&O.ventas,'var(--x-pos)','Optimista')}</div>
        <div class="xleg" style="flex-wrap:wrap;gap:10px;margin-bottom:6px"><span><i style="background:var(--x-ac)"></i>vendido</span><span><i style="background:rgba(var(--x-acRGB),.25)"></i>proyección a fin de mes</span><span><i style="background:var(--x-neg)"></i>equilibrio</span><span><i style="background:#c98a00"></i>pesimista</span><span><i style="background:var(--x-tx)"></i>neutro</span><span><i style="background:var(--x-pos)"></i>optimista</span></div>
        <div class="xsmall">A este ritmo cierras en <b>${clp(proy)}</b>: ${ok?'<span style="color:var(--x-pos)">sobre la meta neutra</span>':okBe?'<span style="color:#b37400">sobre el equilibrio pero bajo la meta neutra (faltan '+clp(meta-proy)+')</span>':'<span style="color:var(--x-neg)">bajo el punto de equilibrio: faltan '+clp(Math.max(bePlan,beReal)-proy)+'</span>'}.</div></div></div>`;
  }catch(e){el.innerHTML='<div class="xsmall">No se pudo calcular la meta: '+escH(e.message)+'</div>';}
}

