    const pts=h.filter(x=>x.prod).map(x=>x.prod);const sp=pts.length>1?(()=>{const mn=Math.min(...pts),mx=Math.max(...pts)||1;return`<svg viewBox="0 0 80 22" style="width:80px;height:22px"><polyline fill="none" stroke="#3355f0" stroke-width="2" points="${pts.map((p,k)=>(k/(pts.length-1)*78+1).toFixed(1)+','+(20-(mx===mn?9:(p-mn)/(mx-mn)*18)).toFixed(1)).join(' ')}"/></svg>`;})():'';
