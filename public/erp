    <button type="button" class="xs-nav on" id="tab-res" onclick="goTab('res')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12l9-8 9 8M5 10v10h14V10"/></svg>Resumen</button>
    <button type="button" class="xs-nav" id="tab-prod" onclick="goTab('prod')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7"/></svg>Productos</button>
    <button type="button" class="xs-nav" id="tab-cli" onclick="goTab('cli')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>Clientes</button>
    <button type="button" class="xs-nav" id="tab-canal" onclick="goTab('canal')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h6"/></svg>Canales y marketing</button>
    <button type="button" class="xs-nav" id="tab-geo" onclick="goTab('geo')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Geografía</button>
    <div class="xs-sec">Gestión</div>
    <button type="button" class="xs-nav" id="tab-inv" onclick="goTab('inv')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16v13H4zM9 7V4h6v3"/></svg>Inventario</button>
    <button type="button" class="xs-nav" id="tab-imp" onclick="goTab('imp')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 17h14l4-6h-6l-2-4H8M2 17l2 3h12"/></svg>Importaciones</button>
    <button type="button" class="xs-nav" id="tab-ventas" onclick="goTab('ventas')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4zM4 9h16M9 9v11"/></svg>Ventas</button>
    <button type="button" class="xs-nav" id="tab-pnl" onclick="goTab('pnl')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>P&amp;L</button>
    <button type="button" class="xs-nav" id="tab-gas" onclick="goTab('gas')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l3 3v15H6zM9 9h6M9 13h6M9 17h4"/></svg>Gastos</button>
    <button type="button" class="xs-nav" id="tab-conv" onclick="goTab('conv')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18l-7 8v6l-4 2v-8z"/></svg>Conversión</button>
    <button type="button" class="xs-nav" id="tab-sis" onclick="goTab('sis')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 8-6-16-3 8H2"/></svg>Estado del sistema</button>
    <div class="xs-sec">Oportunidades</div>
    <button type="button" class="xs-nav" id="tab-scout" onclick="goTab('scout')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>Scout</button>
    <div style="flex-grow:1;min-height:18px"></div>
    <div style="display:flex;flex-direction:column;gap:6px">
      <button type="button" class="xs-tool pri" onclick="showMV()">+ Venta manual</button>
      <label class="xs-tool" style="cursor:pointer" title="Completa hora, cliente, medio de pago y región de pedidos antiguos con el CSV exportado desde Shopify">Historial Shopify (CSV)<input type="file" accept=".csv,text/csv" multiple style="display:none" onchange="importarHistorialShopify(this.files);this.value=''"></label>
      <button type="button" class="xs-tool" onclick="xEstilo()" id="xs-estilo">Estilo: híbrido</button>
      <button type="button" class="xs-tool" onclick="doLogout()">Salir</button>
    </div>
  </aside>
  <div class="xs-main">
    <header class="xs-top">
      <div style="flex:1 1 240px">
        <h1 id="xs-title">Resumen</h1>
        <p class="sub" id="xs-sub">Cargando ventas…</p>
      </div>
      <div id="xs-filtros" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
        <div class="xs-dwrap"><button type="button" class="xs-dbtn" id="xs-btn-per" onclick="xAbrir('per')" aria-haspopup="dialog"></button></div>
        <div class="xs-dwrap"><button type="button" class="xs-dbtn" id="xs-btn-cmp" onclick="xAbrir('cmp')" aria-haspopup="dialog"></button></div>
        <label class="xs-sel">Marca<select id="xs-marca" onchange="xFiltro()"><option value="">Todas</option><option>MemoKoala</option><option>Montana</option></select></label>
        <label class="xs-sel">Canal<select id="xs-canal" onchange="xFiltro()"><option value="">Todos</option></select></label>
      </div>
      <div class="xs-chips">
        <span class="xs-chip" id="tc-usd">USD —</span>
        <span class="xs-chip" id="tc-uf">UF —</span>
        <span class="xs-chip" id="tc-act">—</span>
      </div>
    </header>
    <div id="view-res" class="xv"></div>
    <div id="view-prod" class="xv" style="display:none"></div>
    <div id="view-cli" class="xv" style="display:none"></div>
    <div id="view-canal" class="xv" style="display:none"></div>
    <div id="view-geo" class="xv" style="display:none"></div>
    <div id="view-inv" class="xv" style="display:none"></div>
    <div id="view-imp" class="xv" style="display:none"></div>
    <div id="view-ventas" class="xv" style="display:none"></div>
    <div id="view-pnl" class="xv" style="display:none"></div>
    <div id="view-gas" class="xv" style="display:none"></div>
    <div id="view-conv" class="xv" style="display:none"></div>
    <div id="view-sis" class="xv" style="display:none"></div>
    <div id="view-scout" class="xv" style="display:none"></div>
  <div id="legacy" style="display:none" aria-hidden="true">
  <!-- TAB VENTAS -->
  <div id="old-ventas">
    <div class="fbar">
      <span class="flbl">Año</span>
      <select class="fsel" id="f-anio" onchange="render()"><option value="0">Todos</option></select>
      <span class="flbl" style="margin-left:4px">Mes</span>
      <select class="fsel" id="f-mes" onchange="render()">
        <option value="0">Todos los meses</option>
        <option value="1">Enero</option><option value="2">Febrero</option><option value="3">Marzo</option>
        <option value="4">Abril</option><option value="5">Mayo</option><option value="6">Junio</option>
        <option value="7">Julio</option><option value="8">Agosto</option><option value="9">Septiembre</option>
        <option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option>
      </select>
      <div class="fsep"></div>
      <span class="flbl">Marca</span>
      <select class="fsel" id="f-marca" onchange="sfmSel()">
        <option value="Todas">Todas las marcas</option>
        <option value="MemoKoala">🐨 MemoKoala</option>
        <option value="Montana">🔪 Montana</option>
      </select>
      <div class="fsep"></div>
      <span class="flbl">Canal</span>
      <select class="fsel" id="f-canal" onchange="sfcSel()">
        <option value="Todos">Todos los canales</option>
      </select>
    </div>

    <div id="v-loading" class="spin" style="padding:80px 0"><div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div><p>Cargando ventas...</p></div>

    <div id="v-dash" style="display:none">
      <div id="v-alerta" role="alert"></div>
      <div class="page">
        <!-- KPIs principales -->
        <div class="krow k4" id="kgrid"></div>
        <!-- KPIs análisis -->
        <div class="krow k5" id="kgrid2" style="margin-bottom:16px"></div>
        <!-- KPIs gastos -->
        <div class="krow k5" id="gkgrid" style="margin-bottom:16px"></div>

        <!-- Dos gráficos + Canal -->
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px">
          <div class="card">
            <div class="card-head">
              <span class="card-title" id="chart-title">Venta bruta</span>
              <div style="display:flex;gap:8px;align-items:center">
                <span style="display:flex;align-items:center;gap:3px;font-family:var(--mono);font-size:9px;color:var(--mk)"><span style="width:7px;height:7px;background:var(--mk);border-radius:2px;display:inline-block"></span>MK</span>
                <span style="display:flex;align-items:center;gap:3px;font-family:var(--mono);font-size:9px;color:var(--mt)"><span style="width:7px;height:7px;background:var(--mt);border-radius:2px;display:inline-block;opacity:.7"></span>MT</span>
                <button onclick="toggleChartMode()" id="chart-mode-btn" style="font-family:var(--mono);font-size:9px;padding:2px 8px;border:1px solid var(--border);border-radius:3px;background:transparent;color:var(--mid);cursor:pointer">Acum.</button>
              </div>
            </div>
            <div class="card-body" style="padding:12px 14px">
              <div id="main-bars" style="display:flex;align-items:flex-end;gap:2px;height:100px;width:100%"></div>
              <div id="main-lbls" style="display:flex;justify-content:space-between;margin-top:4px;overflow:hidden"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head">
              <span class="card-title" id="orders-chart-title">Pedidos</span>
              <div style="display:flex;gap:8px;align-items:center">
                <span style="display:flex;align-items:center;gap:3px;font-family:var(--mono);font-size:9px;color:var(--sh)"><span style="width:7px;height:7px;background:var(--sh);border-radius:2px;display:inline-block"></span>Pedidos</span>
              </div>
            </div>
            <div class="card-body" style="padding:12px 14px">
              <div id="orders-bars" style="display:flex;align-items:flex-end;gap:2px;height:100px;width:100%"></div>
              <div id="orders-lbls" style="display:flex;justify-content:space-between;margin-top:4px;overflow:hidden"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Canal · Margen % y comisión</span></div>
            <div class="card-body" id="canal-content"></div>
          </div>
        </div>

        <!-- Mix marcas -->
        <div class="g3">
          <div class="card">
            <div class="card-head"><span class="card-title">Mix MemoKoala vs Montana</span></div>
            <div class="card-body" id="mix-content"></div>
          </div>
          <div class="card" style="grid-column:span 2">
