<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HB Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --night:#1C2B3A;--dark:#2C3E4C;--mid:#4A6274;--light:#8AA4B4;--pale:#D6E4EC;
  --bg:#EEF3F7;--surface:#fff;--off:#F5F8FA;--border:#D6E4EC;--border2:#C2D4DF;
  --mk:#3d7a62;--mk-bg:#EAF4EF;--mk-bd:#A8D0BC;
  --mt:#b85a2a;--mt-bg:#F7EDE6;--mt-bd:#E0A882;
  --pos:#1a7a45;--pos-bg:#E8F8EE;--neg:#c0392b;--neg-bg:#FDECEA;
  --warn:#b07d10;--warn-bg:#FDF6E3;--sh:#2563a8;--sh-bg:#EBF2FA;
  --ml:#9a6f00;--ml-bg:#FDF6E3;
  --f:'Inter',system-ui,sans-serif;--mono:'Inter',system-ui,sans-serif;
  --r:8px;--r2:5px;
  --shadow:0 1px 3px rgba(28,43,58,.08),0 4px 12px rgba(28,43,58,.05);
  --shadow2:0 2px 8px rgba(28,43,58,.12);
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--night);font-family:var(--f);font-size:13px;min-height:100vh;-webkit-font-smoothing:antialiased;font-feature-settings:'tnum' 1,'cv11' 1;font-weight:450}
b,strong,h1,h2,h3,h4,h5{font-weight:600}th{font-weight:550}

/* LOGIN */
#login{position:fixed;inset:0;z-index:999;background:var(--night);display:flex;align-items:center;justify-content:center}
.lbox{width:340px;background:var(--surface);border-radius:12px;padding:36px 32px;box-shadow:0 20px 60px rgba(0,0,0,.3);display:flex;flex-direction:column;gap:24px}
.llogo{display:flex;align-items:center;gap:10px}
.lmark{font-size:18px;font-weight:550;letter-spacing:-.03em;color:var(--night)}
.lmark b{color:var(--mid);font-weight:400}
.ltag{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:.12em;margin-top:4px}
.lfield label{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:.1em;display:block;margin-bottom:6px}
.linput{width:100%;background:var(--off);border:1.5px solid var(--border);border-radius:var(--r2);padding:10px 14px;color:var(--night);font-family:var(--mono);font-size:13px;outline:none;transition:border .2s}
.linput:focus{border-color:var(--mid);background:#fff}
.lbtn{width:100%;background:var(--night);border:none;border-radius:var(--r2);padding:12px;color:#fff;font-family:var(--f);font-size:13px;font-weight:500;cursor:pointer;transition:background .2s}
.lbtn:hover{background:var(--dark)}
.lerr{font-family:var(--mono);font-size:11px;color:var(--neg);text-align:center;display:none}

/* APP */
#app{display:none;min-height:100vh}
.topbar{background:var(--night);height:52px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.06)}
.tmark{font-size:15px;font-weight:550;letter-spacing:-.025em;color:#fff}
.tmark b{color:var(--light);font-weight:400}
.terp{font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.3);margin-left:10px;letter-spacing:.1em}
.tright{display:flex;align-items:center;gap:8px}
.tchip{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.5);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:4px;padding:3px 9px}
.tbtn{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.45);background:transparent;border:1px solid rgba(255,255,255,.12);border-radius:4px;padding:4px 12px;cursor:pointer;transition:all .15s}
.tbtn:hover{color:#fff;border-color:rgba(255,255,255,.3)}
.tabbar{background:var(--night);border-bottom:1px solid rgba(255,255,255,.08);padding:0 24px;display:flex}
.tab{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.4);padding:12px 18px;cursor:pointer;border-bottom:2px solid transparent;letter-spacing:.05em;transition:all .15s}
.tab:hover{color:rgba(255,255,255,.7)}
.tab.on{color:#fff;border-bottom-color:var(--pale)}

/* FILTROS */
.fbar{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 24px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;box-shadow:0 1px 3px rgba(28,43,58,.04)}
.flbl{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:.08em;flex-shrink:0}
.fsel{background:var(--off);border:1.5px solid var(--border);border-radius:var(--r2);color:var(--dark);font-family:var(--mono);font-size:10px;padding:5px 10px;height:28px;outline:none;cursor:pointer}
.fpill{font-family:var(--mono);font-size:10px;padding:4px 12px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--mid);cursor:pointer;transition:all .15s}
.fpill:hover{border-color:var(--light);color:var(--dark)}
.fpill.on{background:var(--night);border-color:var(--night);color:#fff}
.fpill.mk{background:var(--mk-bg);border-color:var(--mk-bd);color:var(--mk)}
.fpill.mt{background:var(--mt-bg);border-color:var(--mt-bd);color:var(--mt)}
.fsep{width:1px;height:16px;background:var(--border);margin:0 4px;flex-shrink:0}

/* LAYOUT */
.page{padding:20px 24px;max-width:1600px;margin:0 auto}
.krow{display:grid;gap:12px;margin-bottom:12px}
.k4{grid-template-columns:repeat(4,1fr)}
.k5{grid-template-columns:repeat(5,1fr)}
.k3{grid-template-columns:repeat(3,1fr)}
.g2{display:grid;grid-template-columns:1.5fr 1fr;gap:12px;margin-bottom:12px}
.g23{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}

/* KPI CARD */
.kcard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden;transition:box-shadow .2s}
.kcard:hover{box-shadow:var(--shadow2)}
.kcard-accent{position:absolute;top:0;left:0;right:0;height:3px}
.kcard-label{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:.1em;margin-bottom:8px}
.kcard-num{font-size:26px;font-weight:550;letter-spacing:-.04em;line-height:1;color:var(--night);margin-bottom:4px}
.kcard-num.pos{color:var(--pos)}
.kcard-num.neg{color:var(--neg)}
.kcard-num.warn{color:var(--warn)}
.kcard-sub{font-size:11px;color:var(--light);margin-bottom:8px;line-height:1.3}
.kdelta{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:10px;padding:2px 8px;border-radius:4px;font-weight:500}
.d-pos{background:var(--pos-bg);color:var(--pos)}
.d-neg{background:var(--neg-bg);color:var(--neg)}
.d-neu{background:var(--off);color:var(--mid);border:1px solid var(--border)}
.d-warn{background:var(--warn-bg);color:var(--warn)}
.kspark{display:flex;align-items:flex-end;gap:2px;height:24px;margin-top:10px}
.ksbar{flex:1;border-radius:2px 2px 0 0;min-height:2px}

/* MINI KPI (gastos) */
.gcard{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow);display:flex;align-items:center;gap:12px}
.gcard-icon{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.gcard-label{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:.06em;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gcard-num{font-size:19px;font-weight:550;letter-spacing:-.03em;color:var(--night);line-height:1}
.gcard-sub{font-family:var(--mono);font-size:9px;color:var(--light);margin-top:2px}

/* CARD */
.card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:.1em}
.card-meta{font-family:var(--mono);font-size:9px;color:var(--light)}
.card-body{padding:16px}

/* CANAL */
.canal-item{margin-bottom:14px}
.canal-item:last-child{margin-bottom:0}
.canal-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
.canal-num{font-size:22px;font-weight:550;letter-spacing:-.04em;color:var(--night)}
.canal-track{height:5px;background:var(--bg);border-radius:3px;overflow:hidden;margin-bottom:3px}
.canal-fill{height:100%;border-radius:3px}
.canal-sub{font-family:var(--mono);font-size:9px;color:var(--light)}

/* BARRAS */
.trend{display:flex;align-items:flex-end;gap:2px}
.tbar-wrap{flex:1;display:flex;flex-direction:column;align-items:center}
.tbar-inner{flex:1;display:flex;flex-direction:column;justify-content:flex-end;width:100%}
.tbar-lbl{font-family:var(--mono);font-size:7px;color:var(--light);text-align:center;margin-top:3px;white-space:nowrap}

/* TABLA */
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead th{padding:8px 12px;text-align:right;font-family:var(--mono);font-size:8px;color:var(--light);font-weight:500;letter-spacing:.08em;border-bottom:1.5px solid var(--border);white-space:nowrap;background:var(--off)}
thead th:first-child,thead th:nth-child(2){text-align:left}
tbody td{padding:9px 12px;text-align:right;font-family:var(--mono);font-size:10px;color:var(--dark);border-bottom:1px solid var(--off)}
tbody td:first-child{text-align:left;color:var(--night);font-weight:500}
tbody td:nth-child(2){text-align:left;color:var(--mid)}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--bg)}
.bdg{display:inline-flex;align-items:center;font-family:var(--mono);font-size:9px;padding:2px 7px;border-radius:4px;font-weight:500}
.b-mk{background:var(--mk-bg);color:var(--mk);border:1px solid var(--mk-bd)}
.b-mt{background:var(--mt-bg);color:var(--mt);border:1px solid var(--mt-bd)}
.b-sh{background:var(--sh-bg);color:var(--sh)}
.b-ml{background:var(--ml-bg);color:var(--ml)}
.b-vd{background:#f0ebff;color:#6a35d4;border:1px solid #c9b8f0}
.mrg-cell{display:flex;align-items:center;gap:6px;justify-content:flex-end}
.mbar{width:40px;height:4px;background:var(--bg);border-radius:2px;overflow:hidden}
.mfill{height:100%;border-radius:2px}
.neg-v{color:var(--neg)}
.pos-v{color:var(--pos);font-weight:550}

/* P&L */
.pnl-periods{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 24px;display:flex;gap:6px;align-items:center}
.ppill{font-family:var(--mono);font-size:10px;padding:4px 14px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--mid);cursor:pointer;transition:all .15s}
.ppill:hover{border-color:var(--mid);color:var(--dark)}
.ppill.on{background:var(--night);border-color:var(--night);color:#fff}
.pnl-wrap{overflow-x:auto}
.pnl-tbl{border-collapse:collapse;width:100%;min-width:800px;font-size:11px}
.pnl-tbl th{font-family:var(--mono);font-size:8px;color:var(--light);padding:7px 10px;text-align:right;border-bottom:1.5px solid var(--border);white-space:nowrap;background:var(--off);font-weight:500;letter-spacing:.06em;position:sticky;top:0;z-index:2}
.pnl-tbl th:first-child{text-align:left;min-width:200px;position:sticky;left:0;z-index:3;background:var(--off)}
.pnl-tbl th.th-tot{background:var(--night);color:rgba(255,255,255,.7);font-weight:550}
.pnl-tbl td{font-family:var(--mono);font-size:10px;padding:6px 10px;text-align:right;border-bottom:1px solid var(--off);color:var(--dark)}
.pnl-tbl td:first-child{text-align:left;position:sticky;left:0;background:var(--surface);z-index:1;color:var(--night);min-width:200px}
.pnl-tbl td.td-tot{background:var(--night);color:#fff;font-weight:550}
.pnl-tbl tr:hover td{background:var(--bg)}
.pnl-tbl tr:hover td:first-child{background:var(--bg)}
.pnl-tbl tr:hover td.td-tot{background:var(--night)!important;color:#fff!important}
.pnl-tbl tr.bold td{font-weight:600;color:var(--night)}
.pnl-tbl tr.shdr td{font-family:var(--mono);font-size:8px;font-weight:550;letter-spacing:.1em;padding:5px 10px;border:none;color:#fff}
.pnl-tbl tr.shdr td:first-child{position:sticky;left:0;z-index:1}
.pnl-tbl tr.compact td{padding:4px 10px;font-size:9px;color:var(--mid)}
.pnl-tbl tr.compact td:first-child{padding-left:20px;color:var(--mid)}
.p-pos{color:var(--pos)!important;font-weight:550!important}
.p-neg{color:var(--neg)!important;font-weight:550!important}

/* INVENTARIO */
.inv-fbar{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;align-items:center}
.inv-layout{display:grid;grid-template-columns:300px 1fr;gap:16px;align-items:start}
.inv-list{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}
.inv-list-head{padding:10px 14px;border-bottom:1.5px solid var(--border);background:var(--off)}
.inv-list-title{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:.08em}
.inv-list-item{display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--off);cursor:pointer;transition:background .1s;user-select:none}
.inv-list-item:last-child{border-bottom:none}
.inv-list-item:hover{background:var(--bg)}
.inv-list-item.active{background:var(--night)}
.inv-list-item.active .il-sku{color:rgba(255,255,255,.4)}
.inv-list-item.active .il-nom{color:#fff}
.inv-list-item.active .il-stock{color:#fff}
.il-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.il-body{flex:1;min-width:0}
.il-sku{font-family:var(--mono);font-size:9px;color:var(--light);line-height:1}
.il-nom{font-size:12px;font-weight:500;color:var(--night);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
.il-right{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0}
.il-stock{font-family:var(--mono);font-size:13px;font-weight:550;color:var(--night)}
.il-stato{font-family:var(--mono);font-size:8px;padding:1px 6px;border-radius:3px;font-weight:500}
.inv-detail{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;position:sticky;top:76px}
.inv-detail-head{background:var(--night);padding:22px 24px}
.inv-detail-badges{display:flex;gap:6px;margin-bottom:10px}
.inv-detail-nom{font-size:18px;font-weight:550;color:#fff;letter-spacing:-.02em;margin-bottom:4px}
.inv-detail-sku{font-family:var(--mono);font-size:10px;color:rgba(255,255,255,.4)}
.inv-detail-body{padding:22px 24px}
.inv-big{font-size:52px;font-weight:600;letter-spacing:-.05em;line-height:1;color:var(--night)}
.inv-big-lbl{font-family:var(--mono);font-size:10px;color:var(--light);margin-top:4px;margin-bottom:10px}
.inv-edit-row{display:flex;align-items:center;gap:8px;margin-bottom:18px;padding:10px 12px;background:var(--bg);border-radius:6px;border:1px solid var(--border)}
.inv-edit-lbl{font-family:var(--mono);font-size:9px;color:var(--light);flex:1}
.inv-edit-inp{width:70px;background:#fff;border:1.5px solid var(--border);border-radius:4px;padding:5px 8px;font-family:var(--mono);font-size:12px;color:var(--night);text-align:center;outline:none}
.inv-edit-inp:focus{border-color:var(--mid)}
.inv-edit-btn{font-family:var(--mono);font-size:10px;padding:5px 12px;background:var(--night);color:#fff;border:none;border-radius:4px;cursor:pointer}
.inv-cov{height:8px;background:var(--bg);border-radius:4px;overflow:hidden}
.inv-cov-fill{height:100%;border-radius:4px;transition:width .6s cubic-bezier(.34,1.56,.64,1)}
.inv-cov-meta{display:flex;justify-content:space-between;font-family:var(--mono);font-size:9px;color:var(--light);margin-top:4px;margin-bottom:20px}
.inv-spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.inv-spec{background:var(--bg);border-radius:6px;padding:12px 14px;border:1px solid var(--border)}
.inv-spec-lbl{font-family:var(--mono);font-size:9px;color:var(--light);margin-bottom:5px}
.inv-spec-val{font-size:18px;font-weight:550;letter-spacing:-.03em;color:var(--night);line-height:1}
.inv-spec-sub{font-family:var(--mono);font-size:9px;color:var(--light);margin-top:3px}
.inv-note{background:var(--warn-bg);border:1px solid #e8d090;border-radius:6px;padding:10px 14px;font-family:var(--mono);font-size:10px;color:var(--warn);margin-top:12px;line-height:1.5}
.inv-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px;color:var(--light);font-family:var(--mono);font-size:11px;text-align:center;gap:8px}
.stato{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:9px;padding:3px 9px;border-radius:4px;font-weight:500}
.s-ok{background:var(--pos-bg);color:var(--pos)}
.s-warn{background:var(--warn-bg);color:var(--warn)}
.s-alert{background:#FEF3E2;color:#D35400}
.s-crit{background:var(--neg-bg);color:var(--neg)}
.s-none{background:var(--off);color:var(--light)}

/* MODAL VENTA MANUAL */
#modal-venta{display:none;position:fixed;inset:0;z-index:300;background:rgba(28,43,58,.65);backdrop-filter:blur(4px);overflow-y:auto;padding:40px 20px}
.mv-box{max-width:600px;margin:0 auto;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(28,43,58,.25)}
.mv-head{background:var(--night);padding:18px 22px;display:flex;justify-content:space-between;align-items:center}
.mv-title{font-size:14px;font-weight:500;color:#fff}
.mv-close{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.6);border-radius:4px;padding:5px 12px;cursor:pointer;font-family:var(--mono);font-size:10px}
.mv-body{padding:22px}
.mv-field{margin-bottom:14px}
.mv-label{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:.08em;display:block;margin-bottom:5px}
.mv-input,.mv-select{width:100%;background:var(--off);border:1.5px solid var(--border);border-radius:var(--r2);padding:8px 12px;color:var(--night);font-family:var(--mono);font-size:12px;outline:none;transition:border .2s}
.mv-input:focus,.mv-select:focus{border-color:var(--mid);background:#fff}
.mv-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.mv-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.mv-section-title{font-family:var(--mono);font-size:9px;color:var(--mid);letter-spacing:.1em;margin-bottom:10px;padding-bottom:7px;border-bottom:1.5px solid var(--border)}
.mv-marca-pills{display:flex;gap:6px;margin-bottom:14px}
.mv-lineas{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
.mv-linea{background:var(--bg);border:1.5px solid var(--border);border-radius:6px;padding:10px 12px;position:relative}
.mv-linea-grid{display:grid;grid-template-columns:2fr 1fr 1.2fr 28px;gap:8px;align-items:end}
.mv-linea-del{background:transparent;border:none;color:var(--neg);font-size:16px;cursor:pointer;padding:0;line-height:1;align-self:center}
.mv-add-btn{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:var(--mk);background:var(--mk-bg);border:1.5px solid var(--mk-bd);border-radius:5px;padding:7px 14px;cursor:pointer;transition:all .15s;margin-bottom:14px}
.mv-add-btn:hover{background:var(--mk);color:#fff}
.mv-divider{height:1px;background:var(--border);margin:14px 0}
.mv-submit{width:100%;background:var(--mk);border:none;border-radius:var(--r2);padding:11px;color:#fff;font-family:var(--f);font-size:13px;font-weight:500;cursor:pointer;margin-top:6px;transition:background .2s}
.mv-submit:hover{background:var(--pos)}
.mv-list{margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}
.mv-list-title{font-family:var(--mono);font-size:9px;color:var(--light);letter-spacing:.08em;margin-bottom:8px}
.mv-entry{display:flex;justify-content:space-between;align-items:flex-start;padding:8px 10px;background:var(--bg);border-radius:5px;margin-bottom:4px}
.mv-entry-info{font-family:var(--mono);font-size:10px;color:var(--dark);line-height:1.5}
.mv-entry-del{font-family:var(--mono);font-size:9px;color:var(--neg);cursor:pointer;padding:2px 6px;border:1px solid var(--neg-bg);border-radius:3px;flex-shrink:0;margin-left:8px}

/* LOADING */
.spin{text-align:center;padding:60px 0}
.dots{display:inline-flex;gap:5px;margin-bottom:12px}
.dot{width:6px;height:6px;border-radius:50%;background:var(--pale);animation:blink 1.2s ease-in-out infinite}
.dot:nth-child(2){animation-delay:.2s}.dot:nth-child(3){animation-delay:.4s}
@keyframes blink{0%,80%,100%{opacity:.3;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}
.spin p{font-family:var(--mono);font-size:11px;color:var(--light)}

/* CHECKLIST */
#cl-modal{display:none;position:fixed;inset:0;z-index:200;background:rgba(28,43,58,.6);backdrop-filter:blur(4px);overflow-y:auto;padding:40px 20px}
.cl-box{max-width:580px;margin:0 auto;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(28,43,58,.2)}
.cl-head{background:var(--night);padding:18px 22px;display:flex;justify-content:space-between;align-items:center}
.cl-htitle{font-size:14px;font-weight:500;color:#fff}
.cl-close{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.6);border-radius:4px;padding:5px 12px;cursor:pointer;font-family:var(--mono);font-size:10px}
.cl-prog-wrap{height:3px;background:var(--bg)}.cl-prog{height:100%;background:var(--mk);transition:width .3s}
.cl-body{padding:22px}
.cl-section{margin-bottom:20px}
.cl-stitle{font-family:var(--mono);font-size:9px;letter-spacing:.12em;margin-bottom:10px;padding-bottom:7px;border-bottom:1.5px solid var(--border)}
.cl-item{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:6px;cursor:pointer;transition:background .1s;margin-bottom:2px}
.cl-item:hover{background:var(--bg)}
.cl-cb{width:18px;height:18px;border:1.5px solid var(--border);border-radius:4px;flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cl-item.done .cl-cb{background:var(--mk);border-color:var(--mk)}
.cl-item.done .cl-cb::after{content:'✓';color:#fff;font-size:11px;font-weight:600}
.cl-item.done .cl-lbl{text-decoration:line-through;color:var(--light)}
.cl-lbl{font-size:12px;font-weight:500;color:var(--night);margin-bottom:2px}
.cl-sub{font-family:var(--mono);font-size:10px;color:var(--light);line-height:1.5}
.cl-warn{font-family:var(--mono);font-size:10px;color:var(--warn);margin-top:3px;font-weight:500}
.cl-reset{font-family:var(--mono);font-size:10px;background:var(--off);border:1.5px solid var(--border);border-radius:4px;padding:7px 16px;cursor:pointer;color:var(--mid)}
@media(max-width:900px){.k4,.k5,.k3{grid-template-columns:1fr 1fr}.g2,.g3,.g23{grid-template-columns:1fr}.inv-layout{grid-template-columns:1fr}.page,.fbar,.topbar,.tabbar,.pnl-periods{padding-left:14px;padding-right:14px}}

/* ══ NUEVO MARCO (vidrio en el marco, datos sobre fondo sólido) ══ */
:root{
  --x-tx:#303030;--x-mu:#4c5573;--x-ac:#3355f0;--x-ac2:#7a45f0;--x-acRGB:51,85,240;
  --x-track:#edf0f8;--x-grid:#e6e9f2;--x-pos:#0b7a4b;--x-posbg:#e3f5ec;--x-neg:#b4410f;--x-negbg:#fbeadf;
  --x-panel:#ffffff;--x-panelbd:#e2e7f3;--x-panelsh:0 2px 10px rgba(30,40,90,.06);
  --x-glass:rgba(255,255,255,.62);--x-glassbd:rgba(255,255,255,.9);--x-glasssh:0 10px 30px rgba(60,72,140,.12);
  --x-font:'Inter',system-ui,sans-serif;
}
html[data-estilo="vidrio"]{--x-panel:rgba(255,255,255,.55);--x-panelbd:rgba(255,255,255,.85);--x-panelsh:0 10px 30px rgba(60,72,140,.12)}
body{background:radial-gradient(1200px 700px at 8% 0%,#e2eaff 0%,transparent 60%),radial-gradient(1000px 800px at 100% 10%,#f0e6ff 0%,transparent 55%),#f4f6fb;background-attachment:fixed}
.xs-shell{display:flex;flex-wrap:wrap;gap:18px;padding:18px;max-width:1680px;margin:0 auto;align-items:flex-start}
.xs-side{flex:1 1 200px;max-width:228px;position:sticky;top:18px;display:flex;flex-direction:column;gap:3px;padding:16px 12px;border-radius:24px;background:var(--x-glass);border:1px solid var(--x-glassbd);box-shadow:var(--x-glasssh);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);font-family:var(--x-font);color:var(--x-tx);min-height:calc(100vh - 36px);box-sizing:border-box}
.xs-brand{display:flex;align-items:center;gap:10px;padding:4px 8px 16px}
