function parseConv(txt){
  const lines=txt.split('\n').filter(l=>l.trim());
  if(lines.length<2)return[];
  const MESES_ES={enero:1,febrero:2,marzo:3,abril:4,mayo:5,junio:6,julio:7,agosto:8,septiembre:9,octubre:10,noviembre:11,diciembre:12};
  const MNOMS=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=scsv(lines[i]);
    if(c.length<7)continue;
    const mesNom=c[0]?.trim().toLowerCase()||'';
    const anio=parseInt(c[1])||0;
    const canal=c[2]?.trim()||'';
    const sesiones=pn(c[3]),carro=pn(c[4]),pasarela=pn(c[5]),compras=pn(c[6]);
    if(!canal||!anio||sesiones<=0)continue;
    const mesN=MESES_ES[mesNom]||0;
    rows.push({
      mes:mesN,mesLbl:MNOMS[mesN]||mesNom,anio,canal,sesiones,carro,pasarela,compras,
      pctCarro:sesiones>0?(carro/sesiones*100):0,
      pctPasarela:carro>0?(pasarela/carro*100):0,
      pctConv:sesiones>0?(compras/sesiones*100):0,
      abandono:carro>0?((carro-compras)/carro*100):0,
    });
  }
  return rows.sort((a,b)=>a.anio!==b.anio?a.anio-b.anio:a.mes-b.mes);
}

function cfData(){
  const anio=parseInt(document.getElementById('cf-anio')?.value)||0;
