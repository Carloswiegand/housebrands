                  <th>Uds</th><th>Venta bruta</th><th>Comisión</th><th>% Com.</th>
                  <th>Ingreso neto</th><th>COGS×1.19</th><th>Margen $</th><th>Margen %</th>
                </tr></thead>
                <tbody id="sku-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB CONVERSIÓN -->
  <div id="old-conv" style="display:none">
    <div id="conv-loading" class="spin" style="padding:80px 0"><div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div><p>Cargando datos de conversión...</p></div>
    <div id="conv-dash" style="display:none">
      <!-- Filtros conversión -->
      <div class="fbar">
        <span class="flbl">Año</span>
        <select class="fsel" id="cf-anio" onchange="renderConv()"><option value="0">Todos</option></select>
        <span class="flbl" style="margin-left:4px">Mes</span>
        <select class="fsel" id="cf-mes" onchange="renderConv()"><option value="0">Todos los meses</option></select>
        <div class="fsep"></div>
        <span class="flbl">Canal</span>
        <select class="fsel" id="cf-canal" onchange="renderConv()">
          <option value="Todos">Todos</option>
          <option value="Shopify MK">Shopify MK</option>
          <option value="Shopify MT">Shopify MT</option>
          <option value="Shopify">Shopify (ambos)</option>
          <option value="ML">MercadoLibre</option>
        </select>
      </div>
      <div class="page">
        <!-- 4 KPIs accionables -->
        <div class="krow k4" id="conv-kgrid" style="margin-bottom:16px"></div>
        <!-- Funnels + tendencia -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
          <div class="card">
            <div class="card-head">
              <span class="card-title" id="conv-funnel-title">Funnel de conversión</span>
              <span class="card-meta" id="conv-periodo"></span>
            </div>
            <div class="card-body" id="conv-funnel-main"></div>
          </div>
          <div class="card">
            <div class="card-head">
              <span class="card-title">Tendencia mensual</span>
              <div style="display:flex;gap:6px">
                <button onclick="convTrendMetric='conv';renderConvTrend()" id="ct-conv" style="font-family:var(--mono);font-size:9px;padding:2px 8px;border:1px solid var(--border);border-radius:3px;background:var(--night);color:#fff;cursor:pointer">% Conversión</button>
                <button onclick="convTrendMetric='cart';renderConvTrend()" id="ct-cart" style="font-family:var(--mono);font-size:9px;padding:2px 8px;border:1px solid var(--border);border-radius:3px;background:transparent;color:var(--mid);cursor:pointer">% Al carrito</button>
                <button onclick="convTrendMetric='rpv';renderConvTrend()" id="ct-rpv" style="font-family:var(--mono);font-size:9px;padding:2px 8px;border:1px solid var(--border);border-radius:3px;background:transparent;color:var(--mid);cursor:pointer">Ing./visita</button>
              </div>
            </div>
            <div class="card-body">
              <div id="conv-trend-chart" style="height:120px;position:relative"></div>
              <div id="conv-trend-lbls" style="display:flex;margin-top:6px;overflow:hidden"></div>
              <div style="display:flex;gap:12px;margin-top:8px" id="conv-legend"></div>
            </div>
          </div>
        </div>
        <!-- Nota -->
        <div style="padding:10px 14px;background:var(--warn-bg);border:1px solid #e8d090;border-radius:var(--r);font-family:var(--mono);font-size:10px;color:var(--warn);line-height:1.6">
          💡 Datos en hoja <strong>Conversion</strong> del Sheets · una fila por mes y canal ·
          Columnas: <strong>Mes | Año | Canal | Sesiones | Al carrito | Pasarela | Compras</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB P&L -->
  <div id="old-pnl" style="display:none">
    <div class="pnl-periods" id="pnl-periods"></div>
    <div id="pnl-loading" class="spin" style="padding:80px 0"><div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div><p>Cargando P&L...</p></div>
    <div id="pnl-dash" style="display:none">
      <div class="page">
        <div class="krow k4" id="pnl-kgrid" style="margin-bottom:16px"></div>
        <div class="g2" style="margin-bottom:16px">
          <div class="card">
            <div class="card-head"><span class="card-title">Resultado neto mensual</span></div>
            <div class="card-body">
              <div class="trend" id="pnl-bars" style="height:100px"></div>
