const G_VAR=[['Meta Ads','Meta Ads (Facebook e Instagram)'],['Google Ads','Google Ads'],['ML Ads','MercadoLibre Ads'],['ABEE Fulfillment','ABEE · fulfillment'],['ABEE Envíos','ABEE · envíos'],['The Link It','The Link It · agencia (vacío = $800.000)'],['Remuneraciones','Remuneraciones'],['Otros Admin','Otros gastos de administración']];
const G_FIJ=[['Shopify MK fee mensual','Shopify MemoKoala','USD al mes'],['Shopify MT fee mensual','Shopify Montana','USD al mes'],['Shopify comisión transacciones','Comisión Shopify por venta','fracción (0,02 = 2%)'],['Claude Pro','Claude','USD al mes'],['Google Workspace','Google Workspace','CLP al mes'],['Canva','Canva','CLP al año'],['BP Consulting','BP Consulting · contabilidad','UF al mes']];
const MES_N=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
async function gLoadGastos(force){
  if(G.gastos&&!force)return;
  try{const [g,c]=await Promise.all([gCsv('/erp/api/gastos'),gCsv('/erp/api/config')]);
    const enc=(g[0]||[]).map(x=>x.trim());G.gastos={};
    g.slice(1).forEach(r=>{const m=MES_N.indexOf(String(r[1]||'').trim().toLowerCase()),a=+r[2];if(m<0||!a)return;const o={};enc.forEach((h,j)=>{if(j>2&&h)o[h]=r[j]===''?'':pn(r[j]);});G.gastos[a+'-'+(m+1)]=o;});
    G.config={};c.forEach(r=>{if(r[0])G.config[r[0].trim()]=r[1];});
  }catch(e){G.gastos={};G.config={};}
}
function gGastosHtml(){
