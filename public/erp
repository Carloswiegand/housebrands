// ── Selector de fechas al estilo Shopify: período + "Comparar con" ──
const X_PRESETS=[
  ['hoy','Hoy'],['ayer','Ayer'],['7d','Últimos 7 días'],['30d','Últimos 30 días'],['90d','Últimos 90 días'],['365d','Últimos 365 días'],
  ['ultmes','Último mes'],['12m','Últimos 12 meses'],['ultanio','Último año'],
  ['semhoy','Semana hasta la fecha'],['meshoy','Mes hasta la fecha'],['trimhoy','Trimestre hasta la fecha'],['aniohoy','Año hasta la fecha'],['todo','Todo el historial']
];
const X_CMP=[['prev','Período anterior'],['anio','Año anterior'],['aniods','Año anterior (mismo día de la semana)'],['custom','Personalizado'],['none','Sin comparación']];
function xPreset(k){
  const hoy=xIso(new Date()),d=new Date(hoy+'T12:00:00');
  const m1=(y,m)=>xIso(new Date(y,m,1,12));
  switch(k){
    case 'hoy':return[hoy,hoy];
    case 'ayer':return[xAdd(hoy,-1),xAdd(hoy,-1)];
    case '7d':return[xAdd(hoy,-6),hoy];
    case '30d':return[xAdd(hoy,-29),hoy];
    case '90d':return[xAdd(hoy,-89),hoy];
    case '365d':return[xAdd(hoy,-364),hoy];
    case 'ultmes':return[m1(d.getFullYear(),d.getMonth()-1),xAdd(m1(d.getFullYear(),d.getMonth()),-1)];
    case '12m':return[m1(d.getFullYear(),d.getMonth()-12),xAdd(m1(d.getFullYear(),d.getMonth()),-1)];
    case 'ultanio':return[(d.getFullYear()-1)+'-01-01',(d.getFullYear()-1)+'-12-31'];
    case 'semhoy':return[xAdd(hoy,-((d.getDay()+6)%7)),hoy];
    case 'meshoy':return[hoy.slice(0,8)+'01',hoy];
    case 'trimhoy':return[m1(d.getFullYear(),Math.floor(d.getMonth()/3)*3),hoy];
    case 'aniohoy':return[hoy.slice(0,4)+'-01-01',hoy];
    case 'todo':{const f=DATA.map(r=>r.fecha).filter(x=>/^\d{4}-\d{2}-\d{2}$/.test(x)).sort();return[f[0]||hoy,hoy];}
  }
  return[xAdd(hoy,-29),hoy];
}
const XF=(()=>{const def={preset:'30d',a:null,b:null,cmp:'prev',ca:null,cb:null,marca:'',canal:''};try{const g=JSON.parse(localStorage.getItem('hb_fechas')||'null');if(g)return Object.assign(def,{preset:g.preset,a:g.a,b:g.b,cmp:g.cmp,ca:g.ca,cb:g.cb});}catch(e){}return def;})();
