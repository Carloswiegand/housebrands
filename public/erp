async function gIdeaAdd(btn){
  const v=id=>document.getElementById(id).value.trim(),msg=document.getElementById('si-msg');
  const idea={keyword:v('si-kw'),rubro:v('si-rubro'),marca:v('si-marca'),origen:v('si-origen')||'Manual',plazoDias:(+v('si-plazo')||12)*7,hipotesis:v('si-hip')};
  if(idea.keyword.length<3){msg.textContent='Escribe la búsqueda o el producto.';return;}
  btn.disabled=true;msg.textContent='Midiendo en el catálogo de Chile…';
  try{await gPost({action:'scout_idea_add',idea});await gLoadIdeas(true);xScout();}
  catch(e){msg.textContent='No se agregó: '+e.message;btn.disabled=false;}
}
async function gIdeaSet(id,cambios){
