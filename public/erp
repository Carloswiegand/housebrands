function buildCanalPills(){
  const ETIQUETAS={'Shopify':'Shopify','ML':'MercadoLibre','Venta Directa':'Venta Directa','HigoKids':'HigoKids Market','Venta Corporativa':'Venta Corporativa','Otro':'Otro'};
