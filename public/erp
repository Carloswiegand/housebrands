function xPedidos(rows){const o={};rows.forEach(r=>{const k=r.canal+'|'+r.orden;if(!o[k])o[k]={k,canal:r.canal,fecha:r.fecha,hora:r.hora,cli:r.cli,vb:0,mb:0,u:0,skus:new Set(),reg:xReg(r),ciudad:r.ciudad,fuente:r.fuente,pago:r.pago,desp:r.desp,ncomp:r.ncomp,marca:r.marca};const x=o[k];x.vb+=r.vb;x.mb+=r.mb;x.u+=r.qty;x.skus.add(r.sku);});return Object.values(o);}
