.xtc{background:#fff;border:1px solid #e2e7f3;border-radius:18px;padding:16px;box-shadow:0 2px 10px rgba(30,40,90,.06);display:flex;flex-direction:column;gap:8px}
.xtc h3{margin:0;font-size:15px;font-weight:600}
.xmt{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:12px;color:var(--x-mu)}
.xmt b{display:block;font-size:14px;color:var(--x-tx);font-weight:600}
.xform{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}

#modal-venta{display:none;position:fixed;inset:0;z-index:300;background:rgba(20,26,51,.45);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);align-items:flex-start;justify-content:center;overflow-y:auto;padding:32px 16px}
.mv2{width:100%;max-width:1040px;background:#f7f8fc;border:1px solid #fff;border-radius:24px;box-shadow:0 30px 80px rgba(20,26,51,.3);font-family:var(--x-font);color:var(--x-tx);overflow:hidden}
.mv2-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:20px 22px;background:rgba(255,255,255,.8);border-bottom:1px solid #e6e9f2}
.mv2-h h2{margin:0;font-size:20px;font-weight:650}
.mv2-b{display:flex;flex-wrap:wrap;gap:18px;padding:18px 22px 22px}
.mv2-l{flex:2 1 520px;display:flex;flex-direction:column;gap:14px;min-width:0}
.mv2-r{flex:1 1 300px;display:flex;flex-direction:column;gap:14px;position:sticky;top:0;align-self:flex-start}
.mv2-s{background:#fff;border:1px solid #e2e7f3;border-radius:18px;padding:16px}
.mv2-s h3,.mv2-sum h3{margin:0 0 10px;font-size:14px;font-weight:600}
.mv2-sum{background:#fff;border:1px solid #e2e7f3;border-radius:18px;padding:16px;box-shadow:0 6px 20px rgba(30,40,90,.08)}
.mv2-hist{background:rgba(255,255,255,.7);border:1px solid #e2e7f3;border-radius:18px;padding:14px}
.mv-drop{display:flex;flex-direction:column;gap:4px;align-items:center;text-align:center;padding:20px;border:2px dashed #c9d1e8;border-radius:18px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s}
.mv-drop:hover,.mv-drop:focus-visible,.mv-drop.on{border-color:var(--x-ac);background:rgba(var(--x-acRGB),.05);outline:none}
.mvl{border:1px solid #e6e9f2;border-radius:14px;padding:12px;margin-bottom:10px;background:#fbfcff}
.mvl-g{display:grid;grid-template-columns:150px 1fr;gap:10px}
.mvl-f{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;font-size:12.5px;color:var(--x-mu);min-height:20px}
.mvl-x{border:0;background:none;color:var(--x-neg);font:550 12.5px var(--x-font);cursor:pointer;padding:4px 6px}
.mvq{display:flex;align-items:center;gap:4px}
.mvq button{width:34px;height:38px;border-radius:10px;border:1px solid #d9deeb;background:#fff;font:550 16px var(--x-font);cursor:pointer;color:var(--x-tx)}
.mvq input{text-align:center;min-width:0}
.mvs-r{display:flex;justify-content:space-between;gap:10px;font-size:13px;padding:5px 0;font-variant-numeric:tabular-nums}
.mvs-t{font-size:16px;border-top:1px solid #e6e9f2;margin-top:4px;padding-top:9px}
.mvs-sep{height:1px;background:#e6e9f2;margin:6px 0}
.mvs-ok{margin-top:8px;font-size:12.5px;color:var(--x-pos);background:var(--x-posbg);border-radius:9px;padding:6px 9px}
.mvs-bad{margin-top:8px;font-size:12.5px;color:var(--x-neg);background:var(--x-negbg);border-radius:9px;padding:6px 9px}
.mvh{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:8px 0;border-top:1px solid #eceff6;font-size:13px}
.xhelp{padding:0;background:rgba(255,255,255,.7)}
.xhelp summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:10px;padding:12px 18px;font-weight:550;font-size:13.5px}
.xhelp summary::-webkit-details-marker{display:none}
.xhelp-i{width:22px;height:22px;border-radius:50%;background:rgba(var(--x-acRGB),.12);color:var(--x-ac);display:inline-flex;align-items:center;justify-content:center;font-weight:650;font-size:12px}
.xhelp dl{margin:0;padding:0 18px 16px;display:grid;grid-template-columns:minmax(150px,240px) 1fr;gap:8px 18px;font-size:13px;line-height:1.5}
.xhelp dt{font-weight:600}.xhelp dd{margin:0;color:var(--x-mu)}
@media (max-width:700px){.xhelp dl{grid-template-columns:1fr}.mvl-g{grid-template-columns:1fr}}

.mm-bar{position:relative;height:14px;border-radius:7px;background:var(--x-track);margin:10px 0 8px}
.mm-bar i{position:absolute;left:0;top:0;bottom:0;border-radius:7px;background:var(--x-ac)}
.mm-bar i.p{background:rgba(var(--x-acRGB),.25)}
.mm-k{position:absolute;top:-4px;bottom:-4px;width:3px;border-radius:2px;transform:translateX(-1px)}
</style>
</head>
<body>


<div id="app">
<div class="xs-shell">
  <aside class="xs-side" aria-label="Menú de HB Control">
    <div class="xs-brand">
      <div class="xs-logo">HB</div>
