      <label class="xlbl">Hipótesis (opcional)<input class="xinp" id="si-hip" placeholder="ej. llega a Chile antes del verano"></label>
    </div>
    <div style="display:flex;gap:10px;align-items:center;margin-top:12px"><button type="button" class="xbtn pri" onclick="gIdeaAdd(this)">Agregar a seguimiento</button><span class="xsmall" id="si-msg"></span></div></section>
