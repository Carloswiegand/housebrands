  const lbl=k=>{const[a,m]=k.split('-');return MES_N[m-1].slice(0,3)+' '+a.slice(2);};
  const v=(G.gastos||{})[G.gMes]||{};
  const cfg=G.config||{};
  return`<section class="xp" id="g-gastos"><div class="xp-h"><h2>Gastos del mes</h2><span class="note">se usan en el P&L</span></div>
    <p class="xsmall" style="margin:-4px 0 12px;line-height:1.5"><b>Variables</b>: cambian cada mes; se cargan cuando llega la factura o al cerrar el mes. Las comisiones de Mercado Pago y ML, los envíos de ML y el costo de los productos <b>no se cargan</b>: salen solos de cada venta.</p>
    <div class="xchips" style="margin-bottom:12px">${meses.map(k=>`<button type="button" class="xchip${G.gMes===k?' on':''}" onclick="G.gMes='${k}';xSistema()">${lbl(k)}${(G.gastos||{})[k]?' ✓':''}</button>`).join('')}</div>
    <div class="xform">${G_VAR.map(([k,l])=>`<label class="xlbl">${escH(l)}<input class="xinp" inputmode="numeric" data-g="${escH(k)}" value="${v[k]===undefined||v[k]===''?'':Math.round(v[k])}" placeholder="$"></label>`).join('')}</div>
    <div style="display:flex;gap:10px;align-items:center;margin-top:12px;flex-wrap:wrap"><button type="button" class="xbtn pri" onclick="gGuardarGastos(this)">Guardar gastos de ${lbl(G.gMes)}</button><button type="button" class="xbtn" onclick="gRegenerarPnL(this)">Regenerar P&L</button><span class="xsmall" id="g-gastos-msg"></span></div>
    <h2 style="margin-top:22px;font-size:14px">Gastos fijos</h2>
    <p class="xsmall" style="margin:4px 0 12px;line-height:1.5"><b>Fijos</b>: se pagan igual vendas o no. Se cargan una vez y el P&L los repite cada mes, convertidos con el dólar o la UF del mes. Solo cámbialos si cambia el plan o la tarifa. Aparecen en el mes en curso recién el último día del mes.</p>
    <div class="xform">${G_FIJ.map(([k,l,u])=>`<label class="xlbl">${escH(l)} · ${escH(u)}<input class="xinp" inputmode="decimal" data-f="${escH(k)}" value="${cfg[k]!==undefined?escH(String(cfg[k])):''}"></label>`).join('')}</div>
    <div style="display:flex;gap:10px;align-items:center;margin-top:12px"><button type="button" class="xbtn" onclick="gGuardarFijos(this)">Guardar gastos fijos</button><span class="xsmall" id="g-fijos-msg"></span></div></section>`;
}
async function gPost(body){const r=await fetch(API_VENTA,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const j=await r.json().catch(()=>({ok:false,error:'respuesta inválida'}));if(!j.ok)throw new Error(j.error||'error');return j;}
async function gGuardarGastos(btn){
  const msg=document.getElementById('g-gastos-msg');const[a,m]=G.gMes.split('-');const valores={};
  document.querySelectorAll('#g-gastos [data-g]').forEach(i=>{const t=i.value.replace(/[^\d]/g,'');valores[i.dataset.g]=t===''?'':+t;});
  G.gAviso='';btn.disabled=true;msg.textContent='Guardando…';
  try{await gPost({action:'gastos_set',mes:MES_N[m-1],anio:+a,valores});msg.textContent='Guardado. Regenerando P&L…';await gPost({action:'pnl_generar'});PNL={meses:[],rows:[]};pnlLoaded=false;await gLoadGastos(true);msg.textContent='Listo: gastos guardados y P&L actualizado.';}
  catch(e){msg.textContent='No se guardó: '+e.message;}finally{btn.disabled=false;}
}
async function gGuardarFijos(btn){
  const msg=document.getElementById('g-fijos-msg');const valores={};
  document.querySelectorAll('#g-gastos [data-f]').forEach(i=>{const t=i.value.replace(',','.').trim();if(t!=='')valores[i.dataset.f]=+t;});
  btn.disabled=true;msg.textContent='Guardando…';
  try{await gPost({action:'config_set',valores});await gLoadGastos(true);msg.textContent='Guardado. Se aplica al regenerar el P&L.';}
  catch(e){msg.textContent='No se guardó: '+e.message;}finally{btn.disabled=false;}
}
async function gRegenerarPnL(btn){
  const msg=document.getElementById('g-gastos-msg');btn.disabled=true;msg.textContent='Regenerando P&L…';
  try{const j=await gPost({action:'pnl_generar'});if(j.ok===false)throw new Error(j.error);PNL={meses:[],rows:[]};pnlLoaded=false;msg.textContent='P&L actualizado.';}
  catch(e){msg.textContent='No se pudo: '+e.message;}finally{btn.disabled=false;}
}

