function gEvalCalc(){
  const g=id=>+(document.getElementById(id)||{}).value||0;
  const usd=g('ev-usd'),tc=g('ev-tc'),flete=g('ev-flete'),ar=g('ev-arancel'),pvp=g('ev-pvp'),com=g('ev-com'),canal=(document.getElementById('ev-canal')||{}).value;
  gSet('eval',{usd,tc,flete,arancel:ar,pvp,canal,com});
  const merc=usd*tc,aran=merc*ar/100,costo=merc+flete+aran,costoIva=costo*IVA;
  const ful=canal==='shopify'?(pvp<43000?pvp*0.055:pvp*0.05+1980):0,comision=pvp*com/100;
  const mb=pvp-costoIva,neto=mb-ful-comision;
  const out=document.getElementById('ev-out');if(!out)return;
  out.innerHTML=`<tr><td>Mercadería · USD ${usd.toFixed(2).replace('.',',')} × $${xN(tc)}</td><td class="r">${clp(merc)}</td></tr>
    <tr><td>Flete, agente y gastos</td><td class="r">${clp(flete)}</td></tr>
    <tr><td>Arancel ${ar}%</td><td class="r">${clp(aran)}</td></tr>
    <tr class="tot"><td>Costo internado sin IVA</td><td class="r">${clp(costo)}</td></tr>
    <tr><td>Costo para margen · × 1,19</td><td class="r">${clp(costoIva)}</td></tr>
    <tr class="tot"><td>Margen bruto</td><td class="r">${clp(mb)} · ${xP(pvp?mb/pvp:0)}</td></tr>
    ${ful?`<tr><td>Fulfillment ABEE · ${pvp<43000?'5,5%':'5% + $1.980'}</td><td class="r">−${clp(ful)}</td></tr>`:''}
    <tr><td>Comisión del canal · ${String(com).replace('.',',')}%</td><td class="r">−${clp(comision)}</td></tr>
    <tr class="tot"><td>Margen por unidad antes de publicidad</td><td class="r" style="color:${neto/pvp>=0.55?'var(--x-pos)':neto/pvp>=0.4?'#c98a00':'var(--x-neg)'}">${clp(neto)} · ${xP(pvp?neto/pvp:0)}</td></tr>
    <tr><td>Precio de venta mínimo para 55% de margen</td><td class="r">${clp((costoIva)/(1-0.55-com/100-(canal==='shopify'?0.055:0)))}</td></tr>`;
}


