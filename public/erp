function renderPnLTable(idxs,labels,rows){
  const SC={'INGRESOS':'#2E7D32','MARGEN':'#1b5e20','LOG':'#BF360C','MARKETING':'#4A148C','TECH':'#1565C0','ADMINISTR':'#37474F','RESULTADO':'#1C2B3A','METRICAS':'#37474F','MARCA':'#263238'};
  const getSC=c=>{const u=c.toUpperCase();for(const[k,v]of Object.entries(SC)){if(u.includes(k))return v;}return'#2C3E4C';};
  const isRes=r=>r.concepto.includes('RESULTADO NETO');
  const isPct=r=>r.concepto.startsWith('%');
  const ps=mv=>idxs.reduce((s,i)=>s+(mv[i]||0),0);
  const pavg=mv=>{const nz=idxs.map(i=>mv[i]||0).filter(v=>v!==0);return nz.length?nz.reduce((s,v)=>s+v,0)/nz.length:0;};
  const fv=(v,p)=>p?v.toFixed(1)+'%':clp(v);
  const fr=t=>rows.find(r=>r.concepto.toUpperCase().includes(t.toUpperCase()));
  const ths=labels.map(m=>`<th>${m.toUpperCase()}</th>`).join('');

  let html=`<table class="pnl-tbl"><thead><tr><th>Concepto</th>${ths}<th class="th-tot">Total/Prom</th></tr></thead><tbody>`;

  html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:#2E7D32">▶ INGRESOS Y MARGEN</td></tr>`;
  [['MemoKoala','Venta Bruta MemoKoala','Margen Bruto MemoKoala','b-mk','MK'],
   ['Montana','Venta Bruta Montana','Margen Bruto Montana','b-mt','MT']].forEach(([nm,vR,mR,cls,tag])=>{
    const vRow=fr(vR),mRow=fr(mR);if(!vRow||!mRow)return;
    const vtds=idxs.map(i=>{
      const v=vRow.mv[i]||0,m=mRow.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;
      return`<td>${v?clp(v):'—'}${v?`<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${p}%</span>`:''}
      </td>`;
    }).join('');
    const vtot=ps(vRow.mv),mtot=ps(mRow.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr><td><span class="bdg ${cls}">${tag}</span> ${nm}<br><span style="font-size:9px;color:var(--light)">Venta bruta · Margen %</span></td>
      ${vtds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${parseFloat(pp)>=65?'#4acf80':'#f87171'}">${pp}%</span></td></tr>`;
  });
  const vbTot=fr('VENTA BRUTA TOTAL'),mbTot=fr('MARGEN BRUTO TOTAL');
  if(vbTot&&mbTot){
    const vtds=idxs.map(i=>{const v=vbTot.mv[i]||0,m=mbTot.mv[i]||0,p=v>0?(m/v*100).toFixed(1):0;return`<td style="font-weight:550">${v?clp(v):'—'}${v?`<br><span style="font-size:9px;color:${parseFloat(p)>=65?'var(--pos)':parseFloat(p)>=45?'var(--warn)':'var(--neg)'}">${p}%</span>`:''}</td>`;}).join('');
    const vtot=ps(vbTot.mv),mtot=ps(mbTot.mv),pp=vtot>0?(mtot/vtot*100).toFixed(1):0;
    html+=`<tr class="bold"><td>TOTAL CONSOLIDADO<br><span style="font-size:9px;color:var(--light);font-weight:400">Venta · Margen %</span></td>${vtds}<td class="td-tot">${clp(vtot)}<br><span style="font-size:9px;color:${parseFloat(pp)>=65?'#4acf80':'#f87171'}">${pp}%</span></td></tr>`;
  }

  const sections=[
    {title:'▶ GASTOS LOGÍSTICOS',bg:'#BF360C',rows:['ABEE — Fulfillment','ABEE — Envíos','SENDU','ML Colecta','Comisión MercadoPago','Comisión ML','ML FLEX — Bonificación','Envío cobrado a clientes','TOTAL LOGÍSTICO NETO']},
    {title:'▶ MARKETING',bg:'#4A148C',rows:['The Link It','Meta Ads','Google Ads','MercadoLibre Ads','TOTAL MARKETING']},
    {title:'▶ TECH & SOFTWARE',bg:'#1565C0',rows:['Shopify MK — Fee','Shopify MK — Txn','Shopify MT — Fee','Shopify MT — Txn','Claude Pro','Google Workspace','Canva','TOTAL TECH & SOFTWARE']},
    {title:'▶ ADMINISTRACIÓN',bg:'#37474F',rows:['BP Consulting','Remuneraciones','Otros Admin','TOTAL ADMINISTRACIÓN']},
  ];
  sections.forEach(sec=>{
    html+=`<tr class="shdr"><td colspan="${labels.length+2}" style="background:${sec.bg}">${sec.title}</td></tr>`;
    sec.rows.forEach(rn=>{
      const row=fr(rn);if(!row)return;
      const isBold=rn.startsWith('TOTAL');
      const pRow=isPct(row);
      const tds=idxs.map(i=>{const v=row.mv[i]||0;return`<td>${v?fv(v,pRow):'—'}</td>`;}).join('');
      const totV=pRow?pavg(row.mv):ps(row.mv);
      html+=`<tr class="${isBold?'bold':''}"><td>${row.concepto}</td>${tds}<td class="td-tot">${fv(totV,pRow)}</td></tr>`;
