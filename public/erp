const xFmt=(s,anio=true)=>new Date(s+'T12:00:00').toLocaleDateString('es-CL',anio?{day:'numeric',month:'short',year:'numeric'}:{day:'numeric',month:'short'});
const xFmtR=(a,b)=>a===b?xFmt(a):(a.slice(0,4)===b.slice(0,4)?xFmt(a,false)+' – '+xFmt(b):xFmt(a)+' – '+xFmt(b));
function xRango(){
  let a,b;
  if(XF.preset&&XF.preset!=='custom'){[a,b]=xPreset(XF.preset);}else{a=XF.a;b=XF.b;}
  if(!a||!b){[a,b]=xPreset('30d');}
  if(a>b)[a,b]=[b,a];
  const n=xDias(a,b);let pa=null,pb=null;
  const yr=s=>{const d=new Date(s+'T12:00:00');d.setFullYear(d.getFullYear()-1);return xIso(d);};
  if(XF.cmp==='prev'){pb=xAdd(a,-1);pa=xAdd(pb,-(n-1));}
  else if(XF.cmp==='anio'){pa=yr(a);pb=yr(b);}
