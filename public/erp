// ── Gráfico de tendencia (barras = período, línea = período anterior) ──
function xTendencia(rows,R,met){
  const n=xDias(R.a,R.b);const gran=n<=62?'d':n<=400?'s':'m';
  const clave=f=>{if(gran==='d')return f;if(gran==='m')return f.slice(0,7);const d=new Date(f+'T12:00:00');const w=(d.getDay()+6)%7;d.setDate(d.getDate()-w);return xIso(d);};
  const val=rs=>met==='ped'?xPedidos(rs).length:met==='mb'?rs.reduce((s,r)=>s+r.mb,0):rs.reduce((s,r)=>s+r.vb,0);
  const cur=[],labs=[];let f=R.a;const vistos=new Set();
  while(f<=R.b){const k=clave(f);if(!vistos.has(k)){vistos.add(k);labs.push(k);}f=xAdd(f,1);}
  const g=xGrupo(xEn(rows,R.a,R.b),r=>clave(r.fecha));labs.forEach(k=>cur.push(val(g[k]||[])));
  let prev=null;
  if(R.pa&&gran!=='m'){const off=xDias(R.pa,R.a)-1;const gp=xGrupo(xEn(rows,R.pa,R.pb),r=>clave(xAdd(r.fecha,off)));prev=labs.map(k=>val(gp[k]||[]));}
  const max=Math.max(1,...cur,...(prev||[0]));
  const fl=k=>gran==='m'?new Date(k+'-15T12:00:00').toLocaleDateString('es-CL',{month:'short',year:'2-digit'}):new Date(k+'T12:00:00').toLocaleDateString('es-CL',{day:'numeric',month:'short'});
  const fmt=v=>met==='ped'?xN(v)+' pedidos':xM(v);
  const bars=cur.map((v,i)=>`<div class="b" style="height:${Math.max(0.5,v/max*100)}%" title="${(gran==='s'?'Semana del ':'')+fl(labs[i])}: ${fmt(v)}${prev?' · antes '+fmt(prev[i]):''}"></div>`).join('');
  const line=prev?`<svg viewBox="0 0 ${labs.length} 100" preserveAspectRatio="none" aria-hidden="true"><polyline fill="none" stroke="#f08a24" stroke-width="2" vector-effect="non-scaling-stroke" stroke-dasharray="4 3" points="${prev.map((v,i)=>(i+0.5)+','+(100-v/max*100)).join(' ')}"/></svg>`:'';
  const ax=[0,Math.floor(labs.length/3),Math.floor(2*labs.length/3),labs.length-1].filter((v,i,a)=>a.indexOf(v)===i).map(i=>`<span>${fl(labs[i])}</span>`).join('');
  return`<div class="xtrend" role="img" aria-label="Tendencia del período">${bars}${line}</div><div class="xaxis">${ax}</div>
    <div class="xleg" style="margin-top:8px"><span><i style="background:linear-gradient(180deg,var(--x-ac2),var(--x-ac))"></i>${gran==='d'?'Por día':gran==='s'?'Por semana':'Por mes'}</span>${prev?'<span><i style="background:#f08a24"></i>'+escH(R.cmpEtq)+' ('+xFmtR(R.pa,R.pb)+')</span>':''}</div>`;
}
