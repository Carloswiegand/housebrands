function gLeerXML(file){
  const msg=document.getElementById('g-xml-msg');if(!file)return;
  const rd=new FileReader();
  rd.onload=()=>{try{
    const x=new DOMParser().parseFromString(rd.result,'application/xml');if(x.getElementsByTagName('parsererror').length)throw new Error('no es un XML válido');
    const doc=x.getElementsByTagNameNS('*','Documento')[0]||x;const t=(n,c)=>((c||doc).getElementsByTagNameNS('*',n)[0]?.textContent||'').trim();
    const rut=t('RUTEmisor'),prov=t('RznSoc')||t('RznSocEmisor'),folio=t('Folio'),tipo=t('TipoDTE');
    if(!folio)throw new Error('no encontré el folio');
    const neto=parseFloat(t('MntNeto'))||0,exe=parseFloat(t('MntExe'))||0,iva=parseFloat(t('IVA'))||0;
    if(/bp consulting/i.test(prov)){msg.innerHTML='<span style="color:#b37400">BP Consulting se calcula solo (10 UF al mes); no hace falta cargar su factura.</span>';return;}
    const pref={'33':'FAC','34':'FAE','61':'NC','56':'ND'}[tipo]||('DTE'+tipo);
    document.getElementById('g-prov').value=prov;document.getElementById('g-doc').value=pref+'-'+folio;document.getElementById('g-fecha').value=t('FchEmis');
    document.getElementById('g-rut').value=rut;document.getElementById('g-origen').value='XML';
    const signo=tipo==='61'?-1:1;
    // ABEE: separa envíos de fulfillment según el detalle
    if(/abee/i.test(prov)){
      const det=[...doc.getElementsByTagNameNS('*','Detalle')].map(d=>({n:t('NmbItem',d),m:parseFloat(t('MontoItem',d))||0}));
      const env=det.filter(d=>/env[ií]o|despacho|courier|flete|transporte|last ?mile/i.test(d.n)).reduce((s,d)=>s+d.m,0);
      const ff=(neto+exe)-env;
      G.gXmlSplit={rut,prov,doc:pref+'-'+folio,fecha:t('FchEmis'),partes:[['ABEE Fulfillment',ff*signo],['ABEE Envíos',env*signo]].filter(p=>p[1]),ivaTot:iva*signo};
      msg.innerHTML=`ABEE ${pref}-${folio}: fulfillment ${clp(ff)} y envíos ${clp(env)} (neto). Revisa el mes del gasto y guarda: se cargan los dos conceptos.`;
      document.getElementById('g-conc').value='ABEE Fulfillment';document.getElementById('g-neto').value=Math.round(ff*signo);document.getElementById('g-iva').value=Math.round(iva*signo);
      return;
    }
    G.gXmlSplit=null;
    if(/link ?it/i.test(prov))document.getElementById('g-conc').value='The Link It';
    document.getElementById('g-neto').value=Math.round((neto+exe)*signo);document.getElementById('g-iva').value=Math.round(iva*signo);
    msg.textContent=`${prov} ${pref}-${folio}: neto ${clp(neto+exe)}, IVA ${clp(iva)}. Elige el concepto y el mes del gasto, y guarda.`;
  }catch(e){msg.innerHTML='<span style="color:var(--x-neg)">No pude leer el XML: '+escH(e.message)+'</span>';}};
  rd.readAsText(file);
}
async function gGuardarDoc(btn){
