    const tds=idxs.map(i=>{const v=resRow.mv[i]||0;return`<td ${v>=0?'class="p-pos"':'class="p-neg"'}>${clp(v)}</td>`;}).join('');
    html+=`<tr class="bold"><td>RESULTADO NETO</td>${tds}<td class="td-tot" ${ps(resRow.mv)>=0?'class="p-pos"':'class="p-neg"'}>${clp(ps(resRow.mv))}</td></tr>`;
