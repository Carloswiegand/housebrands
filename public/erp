      <td class="r">${i.baseP?xNcat(i.baseP):'–'} → ${act?xNcat(act):'–'}${cre!==null?`<div class="xsmall" style="color:${cre>=0.3?'var(--x-pos)':cre<0?'var(--x-neg)':'inherit'}">${cre>=0?'+':''}${xP(cre,0)}</div>`:''}</td><td>${sp}</td><td class="r">${u&&u.pos?'#'+u.pos:'–'}</td>
      <td><span class="xtag ${tag}">${escH(i.ver||'En curso')}</span></td>
