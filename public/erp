.xs-sec{font-size:11px;font-weight:600;color:var(--x-mu);padding:12px 12px 4px}
.xs-nav{display:flex;align-items:center;gap:10px;min-height:42px;padding:0 12px;border-radius:13px;border:0;background:transparent;color:var(--x-tx);font:550 14px var(--x-font);cursor:pointer;text-align:left;width:100%}
