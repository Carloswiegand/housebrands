function xHb(lbl,v,max,txt,color,ancho){return`<div class="xhb${ancho?' w':''}"><span class="lbl" title="${escH(lbl)}">${escH(lbl)}</span><div class="t"><div class="f" style="width:${Math.max(2,Math.round(v/(max||1)*100))}%${color?';background:'+color:''}"></div></div><span class="v">${txt}</span></div>`;}
function xGrupo(rows,key){const o={};rows.forEach(r=>{const k=key(r);if(k===null||k===undefined||k==='')return;(o[k]=o[k]||[]).push(r);});return o;}

