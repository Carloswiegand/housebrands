  const inv=calcInvData();
  const filtered=inv.filter(r=>{
    if(invFiltMarca!=='Todas'&&r.marca!==invFiltMarca)return false;
    if(invFiltEstado!=='Todos'&&r.stato!==invFiltEstado)return false;
    return true;
  }).sort((a,b)=>a.sku.localeCompare(b.sku));
  const dotC={ok:'var(--pos)',warn:'var(--warn)',alert:'#D35400',crit:'var(--neg)',none:'var(--light)'};
  const stC={ok:'s-ok',warn:'s-warn',alert:'s-alert',crit:'s-crit',none:'s-none'};
  document.getElementById('inv-list-items').innerHTML=filtered.length===0
    ?'<div style="padding:20px;font-family:var(--mono);font-size:10px;color:var(--light);text-align:center">Sin resultados</div>'
