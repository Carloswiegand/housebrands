  else if(XF.cmp==='custom'&&XF.ca&&XF.cb){pa=XF.ca<=XF.cb?XF.ca:XF.cb;pb=XF.ca<=XF.cb?XF.cb:XF.ca;}
  const etq=(X_PRESETS.find(p=>p[0]===XF.preset)||[,'Personalizado'])[1];
