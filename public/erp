let mvXmlTotal=0;
function mvImportarXML(file){
  const msg=document.getElementById('mv-xml-msg');
  if(!file)return;
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      const x=new DOMParser().parseFromString(rd.result,'application/xml');
      if(x.getElementsByTagName('parsererror').length)throw new Error('el archivo no es un XML válido');
      const doc=x.getElementsByTagNameNS('*','Documento')[0]||x;
      const t=(n,ctx)=>((ctx||doc).getElementsByTagNameNS('*',n)[0]?.textContent||'').trim();
      const tipo=t('TipoDTE'), folio=t('Folio');
      if(!folio)throw new Error('no encontré el folio; ¿es el XML del documento?');
      const pref={'33':'FAC','34':'FAE','39':'BOL','41':'BOE','52':'GD'}[tipo]||('DTE'+tipo);
      document.getElementById('mv-doc').value=pref+'-'+folio;
      document.getElementById('mv-fecha').value=t('FchEmis');
      document.getElementById('mv-cliente').value=t('RznSocRecep');
      if(tipo==='33'||tipo==='34')document.getElementById('mv-canal').value='B2B';
      mvComisionAuto();
      const boleta=tipo==='39'||tipo==='41';           // en boletas los montos ya traen IVA
      const det=[...doc.getElementsByTagNameNS('*','Detalle')].map(d=>({
        nombre:t('NmbItem',d), codigo:t('VlrCodigo',d), qty:parseFloat(t('QtyItem',d))||1,
        monto:parseFloat(t('MontoItem',d))||0, exento:t('IndExe',d)==='1'
      }));
      const sumNeto=det.filter(d=>!d.exento).reduce((s,d)=>s+d.monto,0);
      const mntNeto=parseFloat(t('MntNeto'))||sumNeto;
      const factor=!boleta&&sumNeto>0?mntNeto/sumNeto:1;   // reparte descuentos globales
      const iva=boleta?1:IVA;
      mvXmlTotal=parseFloat(t('MntTotal'))||0;
      let envio=0;const lineas=[];const sinSku=[];
      det.forEach(d=>{
        const sku=mvAdivinarSku(d.nombre,d.codigo);
        const pu=Math.round(d.monto*factor*(d.exento?1:iva)/d.qty);
        if(sku)lineas.push({sku,qty:d.qty,precio:pu});
        else if(/despacho|env[ií]o|flete|transporte/i.test(d.nombre))envio+=Math.round(d.monto*factor*(d.exento?1:iva));
        else{sinSku.push(d.nombre);lineas.push({sku:'',qty:d.qty,precio:pu,nombre:d.nombre});}
      });
      document.getElementById('mv-envio').value=envio;
      mvMarca='Todas';
      mvLineas=lineas.map((l,i)=>'ln-x'+i);
      mvRenderLineas(Object.fromEntries(mvLineas.map((id,i)=>[id,{sku:lineas[i].sku,qty:String(lineas[i].qty),precio:String(lineas[i].precio)}])));
      msg.innerHTML=`Leí ${pref}-${folio} de ${escH(t('RznSocRecep'))}: ${det.length} línea${det.length!==1?'s':''}, total ${clp(mvXmlTotal)}.`+
        (sinSku.length?`<br><span style="color:var(--neg)">Elige el producto para: ${sinSku.map(escH).join(', ')}</span>`:' Revisa los productos y registra.');
      mvTotal();
    }catch(e){msg.innerHTML=`<span style="color:var(--neg)">No pude leer el XML: ${escH(e.message)}</span>`;}
  };
  rd.readAsText(file);
}

// Busca el SKU por código del ítem o por palabras del nombre (ej. "Silla HookOn Azul").
function mvAdivinarSku(nombre,codigo){
  const skus=Object.keys(NOMBRES);
  const cod=String(codigo||'').toUpperCase();
  if(skus.includes(cod))return cod;
  const n=String(nombre||'').toUpperCase();
  const directo=skus.find(s=>n.includes(s));if(directo)return directo;
  const norm=w=>w.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();
  const pal=norm(nombre).split(/[^a-z0-9]+/).filter(w=>w.length>2);
  let mejor='',pts=0;
  skus.forEach(s=>{
    const ws=norm(NOMBRES[s]).split(/[^a-z0-9]+/).filter(w=>w.length>2);
    const p=ws.filter(w=>pal.includes(w)).length/ws.length;
    if(p>pts){pts=p;mejor=s;}
  });
  return pts>=0.66?mejor:'';
}

function escH(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

