.xs-tool{display:flex;align-items:center;gap:10px;min-height:40px;padding:0 12px;border-radius:12px;border:1px solid rgba(20,26,51,.1);background:rgba(255,255,255,.6);color:var(--x-tx);font:550 13px var(--x-font);cursor:pointer;width:100%;box-sizing:border-box}
